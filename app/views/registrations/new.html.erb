<% content_for :title, t("registration.create_account") %>
<section class="mx-auto max-w-md">
  <h1 class="text-3xl font-semibold tracking-tight"><%= t("registration.create_account") %></h1>
  <p class="mt-3 text-slate-600"><%= t("registration.benefit") %></p>
  <% if @user.errors.any? %>
    <div id="registration-errors" role="alert" tabindex="-1" data-controller="focus-error-summary" class="mt-6 rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-900">
      <p class="font-semibold"><%= t("registration.fix_errors") %></p>
      <ul class="mt-2 list-disc pl-5"><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>
  <% if GoogleIdentity.enabled? %>
    <div class="mt-8">
      <%= render "shared/google_sign_in", intent: "sign_in", text: "signup_with" %>
      <p class="auth-divider mt-6"><span><%= t("google_identity.or") %></span></p>
    </div>
  <% end %>
  <%= form_with model: @user, url: registration_path, class: "#{GoogleIdentity.enabled? ? "mt-6" : "mt-7"} space-y-5" do |form| %>
    <div><%= form.label :email, t("registration.email"), class: "block text-sm font-medium" %><%= form.email_field :email, required: true, autocomplete: "email", value: @user.email, aria: { invalid: @user.errors[:email].any?, describedby: (@user.errors[:email].any? ? "registration-email-error" : nil) }, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-3" %><% if @user.errors[:email].any? %><p id="registration-email-error" class="mt-1 text-sm text-red-700"><%= @user.errors.full_messages_for(:email).join(". ") %></p><% end %></div>
    <div><%= form.label :password, t("registration.password"), class: "block text-sm font-medium" %><%= form.password_field :password, required: true, autocomplete: "new-password", minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: User::MAXIMUM_PASSWORD_LENGTH, aria: { invalid: @user.errors[:password].any?, describedby: "registration-password-hint#{" registration-password-error" if @user.errors[:password].any?}" }, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-3" %><p id="registration-password-hint" class="mt-2 text-sm text-slate-500"><%= t("registration.password_hint") %></p><% if @user.errors[:password].any? %><p id="registration-password-error" class="mt-1 text-sm text-red-700"><%= @user.errors.full_messages_for(:password).join(". ") %></p><% end %></div>
    <div><%= form.label :password_confirmation, t("registration.confirm_password"), class: "block text-sm font-medium" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", aria: { invalid: @user.errors[:password_confirmation].any?, describedby: (@user.errors[:password_confirmation].any? ? "registration-confirmation-error" : nil) }, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-3" %><% if @user.errors[:password_confirmation].any? %><p id="registration-confirmation-error" class="mt-1 text-sm text-red-700"><%= @user.errors.full_messages_for(:password_confirmation).join(". ") %></p><% end %></div>
    <%= form.submit t("registration.create_account"), class: "w-full rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white hover:bg-blue-800" %>
  <% end %>
  <p class="mt-5 text-sm text-slate-500"><%= t("landing.access_note") %></p>
  <p class="mt-5 text-sm"><%= t("registration.already_account") %> <%= link_to t("authentication.sign_in"), login_path, class: "font-semibold text-blue-700" %></p>
</section>
