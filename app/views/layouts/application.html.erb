<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Three Heavens" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Three Heavens">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <a href="#main-content" class="fixed left-3 top-3 z-50 -translate-y-20 rounded-lg bg-slate-950 px-4 py-2 font-semibold text-white transition focus:translate-y-0">Skip to main content</a>
    <header class="border-b border-slate-200 bg-white shadow-sm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="flex min-h-16 items-center justify-between gap-4">
          <%= link_to authenticated? ? root_path : login_path, aria: { label: "Three Heavens home" }, class: "group flex shrink-0 items-center gap-3 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2" do %>
            <span class="flex size-9 items-center justify-center rounded-xl bg-blue-700 text-sm font-bold text-white shadow-sm" aria-hidden="true">TH</span>
            <span class="hidden sm:block"><span class="block font-semibold tracking-tight text-slate-950">Three Heavens</span><span class="block text-xs text-slate-500">Translation workspace</span></span>
          <% end %>

          <% if authenticated? %>
            <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
              <%= navigation_link "Workspace", new_translation_workspace_path, section: :workspace %>
              <%= navigation_link "Projects", projects_path, section: :projects %>
              <%= navigation_link "History", history_path, section: :history %>
              <details class="group relative">
                <summary class="cursor-pointer list-none rounded-md px-2 py-1.5 text-sm font-semibold <%= section_active?(:libraries) ? 'bg-blue-50 text-blue-800' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-950' %>">Libraries <span aria-hidden="true">⌄</span></summary>
                <div class="absolute right-0 z-20 mt-2 w-60 rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
                  <%= navigation_link "Workflow Profiles", workflow_profiles_path, section: :libraries, compact: true, controllers: "workflow_profiles" %>
                  <%= navigation_link "Glossaries", glossaries_path, section: :libraries, compact: true, controllers: "glossaries" %>
                  <%= navigation_link "Methodology Profiles", methodology_profiles_path, section: :libraries, compact: true, controllers: "methodology_profiles" %>
                  <%= navigation_link "Translation References", translation_references_path, section: :libraries, compact: true, controllers: "translation_references" %>
                </div>
              </details>
              <%= navigation_link "Benchmarks", benchmarks_path, section: :benchmarks %>
              <% if current_user.admin? %>
                <details class="group relative">
                  <summary class="cursor-pointer list-none rounded-md px-2 py-1.5 text-sm font-semibold <%= section_active?(:administration) ? 'bg-blue-50 text-blue-800' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-950' %>">Admin <span aria-hidden="true">⌄</span></summary>
                  <div class="absolute right-0 z-20 mt-2 w-52 rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
                    <%= navigation_link "Settings / Models", settings_models_path, section: :administration, compact: true, controllers: "settings/models" %>
                    <%= navigation_link "Operations", settings_operations_path, section: :administration, compact: true, controllers: "settings/operations" %>
                  </div>
                </details>
              <% end %>
            </nav>

            <div class="flex items-center gap-3 border-l border-slate-200 pl-3">
              <span class="hidden max-w-44 truncate text-xs text-slate-500 xl:block" title="<%= current_user.email %>"><%= current_user.email %></span>
              <%= button_to "Log out", session_path, method: :delete, class: "rounded-md px-2 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:text-slate-950" %>
            </div>

            <details class="relative lg:hidden">
              <summary class="cursor-pointer list-none rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700">Menu</summary>
              <div class="fixed left-4 right-4 top-14 z-30 rounded-xl border border-slate-200 bg-white p-3 shadow-xl sm:left-auto sm:w-80">
                <nav class="space-y-1" aria-label="Mobile navigation">
                  <%= navigation_link "Workspace", new_translation_workspace_path, section: :workspace, compact: true %>
                  <%= navigation_link "Projects", projects_path, section: :projects, compact: true %>
                  <%= navigation_link "History", history_path, section: :history, compact: true %>
                  <p class="px-3 pb-1 pt-3 text-xs font-bold uppercase tracking-wide text-slate-400">Libraries</p>
                  <%= navigation_link "Workflow Profiles", workflow_profiles_path, section: :libraries, compact: true, controllers: "workflow_profiles" %>
                  <%= navigation_link "Glossaries", glossaries_path, section: :libraries, compact: true, controllers: "glossaries" %>
                  <%= navigation_link "Methodology Profiles", methodology_profiles_path, section: :libraries, compact: true, controllers: "methodology_profiles" %>
                  <%= navigation_link "Translation References", translation_references_path, section: :libraries, compact: true, controllers: "translation_references" %>
                  <%= navigation_link "Benchmarks", benchmarks_path, section: :benchmarks, compact: true %>
                  <% if current_user.admin? %>
                    <p class="px-3 pb-1 pt-3 text-xs font-bold uppercase tracking-wide text-slate-400">Administration</p>
                    <%= navigation_link "Settings / Models", settings_models_path, section: :administration, compact: true, controllers: "settings/models" %>
                    <%= navigation_link "Operations", settings_operations_path, section: :administration, compact: true, controllers: "settings/operations" %>
                  <% end %>
                </nav>
                <div class="mt-3 border-t border-slate-200 px-3 pt-3">
                  <span class="block truncate text-xs text-slate-500"><%= current_user.email %></span>
                </div>
              </div>
            </details>
          <% end %>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-7xl px-4 py-8 outline-none sm:px-6 sm:py-10">
      <% if notice.present? %>
        <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900" role="status" aria-live="polite"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900" role="alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
