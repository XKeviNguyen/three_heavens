<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Three Heavens" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Three Heavens">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
        <%= link_to "Three Heavens", authenticated? ? root_path : login_path, class: "text-lg font-semibold tracking-tight text-slate-950" %>
        <% if authenticated? %>
          <div class="flex flex-wrap items-center gap-5">
            <nav class="flex flex-wrap items-center gap-4 text-sm font-medium" aria-label="Primary navigation">
              <%= link_to "Projects", projects_path, class: "text-slate-600 hover:text-slate-950" %>
              <%= link_to "History", history_path, class: "text-slate-600 hover:text-slate-950" %>
              <%= link_to "Workflow Profiles", workflow_profiles_path, class: "text-slate-600 hover:text-slate-950" %>
              <%= link_to "Glossaries", glossaries_path, class: "text-slate-600 hover:text-slate-950" %>
              <%= link_to "Methodologies", methodology_profiles_path, class: "text-slate-600 hover:text-slate-950" %>
              <%= link_to "Benchmarks", benchmarks_path, class: "text-slate-600 hover:text-slate-950" %>
              <% if current_user.admin? %>
                <%= link_to "Settings / Models", settings_models_path, class: "text-slate-600 hover:text-slate-950" %>
                <%= link_to "Operations", settings_operations_path, class: "text-slate-600 hover:text-slate-950" %>
              <% end %>
              <%= link_to "New experiment", new_translation_workspace_path, class: "text-blue-700 hover:text-blue-900" %>
            </nav>
            <div class="flex items-center gap-3 border-l border-slate-200 pl-5 text-sm">
              <span class="max-w-64 truncate text-slate-600" title="<%= current_user.email %>"><%= current_user.email %></span>
              <%= button_to "Log out", session_path, method: :delete, class: "font-semibold text-slate-700 hover:text-slate-950" %>
            </div>
          </div>
        <% end %>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl px-5 py-10">
      <% if notice.present? %>
        <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
