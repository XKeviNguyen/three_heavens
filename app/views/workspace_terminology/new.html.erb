<%= turbo_frame_tag "workspace-terminology-editor" do %>
  <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-inset ring-slate-200" data-controller="glossary-entries" data-glossary-entries-maximum-value="<%= GlossaryRevision::MAXIMUM_ENTRIES %>" data-glossary-entries-count-label-value="<%= t("terminology_sheet.entry_count") %>">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-sm font-semibold text-slate-950"><%= t("terminology_sheet.add_title") %></h3>
        <p class="mt-1 text-xs leading-5 text-slate-500"><%= t("terminology_sheet.add_intro") %></p>
      </div>
      <button type="button" data-action="terminology-sheet#close" class="text-xs font-semibold text-slate-600 hover:text-slate-950"><%= t("terminology_sheet.cancel") %></button>
    </div>

    <% if @form_errors.present? %>
      <section class="mt-3 rounded-lg border border-red-200 bg-red-50 p-3" role="alert">
        <ul class="list-disc space-y-1 pl-5 text-xs text-red-800"><% @form_errors.each do |message| %><li><%= message %></li><% end %></ul>
      </section>
    <% end %>

    <%= form_with url: workspace_terminology_path, method: :post, scope: :glossary, class: "mt-4 space-y-4" do |form| %>
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <%= form.label :name, t("terminology_sheet.glossary_name"), class: "block text-xs font-medium text-slate-700" %>
          <%= form.text_field :name, value: @form_values["name"], required: true, maxlength: 150, placeholder: t("terminology_sheet.glossary_placeholder"), class: "mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
        </div>
        <div><%= render "shared/language_combobox", form: form, method: :source_language, label: t("language.source"), value: @form_values["source_language"] %></div>
        <div><%= render "shared/language_combobox", form: form, method: :target_language, label: t("language.target"), value: @form_values["target_language"] %></div>
        <div class="sm:col-span-2">
          <%= form.label :description, t("terminology_sheet.description"), class: "block text-xs font-medium text-slate-700" %>
          <%= form.text_field :description, value: @form_values["description"], maxlength: 500, class: "mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <p class="text-xs font-semibold text-slate-700"><%= t("terminology_sheet.terms") %></p>
        <span class="text-xs text-slate-500" data-glossary-entries-target="count"></span>
      </div>
      <div class="space-y-3" data-glossary-entries-target="list">
        <% @form_values.fetch("entries").each do |entry| %>
          <fieldset class="grid gap-3 rounded-xl border border-slate-200 bg-white p-3 sm:grid-cols-2" data-glossary-entries-target="entry">
            <div class="flex items-center justify-between sm:col-span-2"><legend class="text-xs font-semibold text-slate-700"><%= t("terminology_sheet.term") %></legend><button class="text-xs font-semibold text-red-700 disabled:text-slate-400" data-action="glossary-entries#remove" data-glossary-entries-target="remove" type="button"><%= t("terminology_sheet.remove") %></button></div>
            <div><label class="block text-xs font-medium text-slate-600"><%= t("terminology_sheet.source_term") %></label><input class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" maxlength="200" name="glossary[entries][][source_term]" required type="text" value="<%= entry["source_term"] %>"></div>
            <div><label class="block text-xs font-medium text-slate-600"><%= t("terminology_sheet.preferred_term") %></label><input class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" maxlength="200" name="glossary[entries][][preferred_target_term]" required type="text" value="<%= entry["preferred_target_term"] %>"></div>
            <div class="sm:col-span-2"><label class="block text-xs font-medium text-slate-600"><%= t("terminology_sheet.note") %></label><input class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" maxlength="500" name="glossary[entries][][note]" type="text" value="<%= entry["note"] %>"></div>
          </fieldset>
        <% end %>
      </div>
      <template data-glossary-entries-target="template">
        <fieldset class="grid gap-3 rounded-xl border border-slate-200 bg-white p-3 sm:grid-cols-2" data-glossary-entries-target="entry">
          <div class="flex items-center justify-between sm:col-span-2"><legend class="text-xs font-semibold text-slate-700"><%= t("terminology_sheet.term") %></legend><button class="text-xs font-semibold text-red-700 disabled:text-slate-400" data-action="glossary-entries#remove" data-glossary-entries-target="remove" type="button"><%= t("terminology_sheet.remove") %></button></div>
          <div><label class="block text-xs font-medium text-slate-600"><%= t("terminology_sheet.source_term") %></label><input class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" maxlength="200" name="glossary[entries][][source_term]" required type="text"></div>
          <div><label class="block text-xs font-medium text-slate-600"><%= t("terminology_sheet.preferred_term") %></label><input class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" maxlength="200" name="glossary[entries][][preferred_target_term]" required type="text"></div>
          <div class="sm:col-span-2"><label class="block text-xs font-medium text-slate-600"><%= t("terminology_sheet.note") %></label><input class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" maxlength="500" name="glossary[entries][][note]" type="text"></div>
        </fieldset>
      </template>

      <div class="flex flex-wrap items-center justify-between gap-3">
        <button class="rounded-lg border border-blue-300 px-3 py-2 text-xs font-semibold text-blue-700 hover:bg-blue-50 disabled:border-slate-200 disabled:text-slate-400" data-action="glossary-entries#add" type="button"><%= t("terminology_sheet.add_another") %></button>
        <%= form.submit t("terminology_sheet.create_select"), class: "rounded-lg bg-blue-700 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-800", data: { turbo_submits_with: t("terminology_sheet.creating") } %>
      </div>
    <% end %>
  </div>
<% end %>
