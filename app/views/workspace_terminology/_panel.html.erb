<%= turbo_frame_tag "workspace-terminology" do %>
  <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
    <% if glossaries.any? %>
      <div class="space-y-2">
        <label class="flex items-start gap-3 rounded-lg border border-slate-200 bg-white p-3">
          <%= radio_button_tag "translation_workspace[glossary_revision_id]", "", selected_revision_id.blank?, id: "translation_workspace_glossary_revision_id_none", class: "mt-1 size-4" %>
          <span><span class="block text-sm font-semibold">No terminology</span><span class="mt-0.5 block text-xs text-slate-500">Continue without terminology constraints.</span></span>
        </label>
        <% glossaries.each do |glossary| %>
          <% revision = glossary.current_revision %>
          <div class="rounded-lg border border-slate-200 bg-white p-3">
            <div class="flex items-start gap-3">
              <%= radio_button_tag "translation_workspace[glossary_revision_id]", revision.id, selected_revision_id.to_s == revision.id.to_s, id: "translation_workspace_glossary_revision_id_#{revision.id}", class: "mt-1 size-4" %>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-slate-900"><%= revision.name %> · revision <%= revision.version %></p>
                <p class="mt-0.5 text-xs text-slate-500"><%= revision.source_language %> → <%= revision.target_language %> · <%= pluralize(revision.entries.size, "term") %></p>
                <% preview = revision.entries.first(2) %>
                <% if preview.any? %>
                  <ul class="mt-1.5 space-y-0.5 text-xs text-slate-600">
                    <% preview.each do |entry| %><li><%= entry.source_term %> → <%= entry.preferred_target_term %></li><% end %>
                  </ul>
                  <% if revision.entries.size > preview.size %><p class="mt-1 text-xs text-slate-400">+ <%= revision.entries.size - preview.size %> more</p><% end %>
                <% end %>
                <div class="mt-2">
                  <%= link_to "Edit terminology", edit_workspace_terminology_path(glossary_id: glossary.id), data: { turbo_frame: "workspace-terminology" }, class: "text-xs font-semibold text-blue-700 hover:text-blue-900" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm font-semibold text-slate-900">No terminology yet</p>
      <p class="mt-1 text-xs text-slate-500">Create a terminology collection in the library, then select it here. Terminology changes never trigger AI work.</p>
    <% end %>
    <p class="mt-3 text-xs text-slate-500"><%= link_to "Terminology library", glossaries_path, class: "font-semibold text-blue-700 hover:text-blue-900" %></p>
    <% if local_assigns[:pagination].present? %>
      <%= render "translation_workspaces/configuration_pagination", pagination: pagination, label: "Glossaries", page_param: :glossary_page %>
    <% end %>
  </div>
<% end %>
