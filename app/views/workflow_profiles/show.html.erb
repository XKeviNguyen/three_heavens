<% content_for :title, t("workflows_ui.show_title", name: @workflow_profile.name) %>
<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div><p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("workflows_ui.singular") %></p><h1 class="mt-2 text-3xl font-bold"><%= @workflow_profile.name %></h1><p class="mt-2 text-sm text-slate-600"><%= @workflow_profile.description.presence || t("glossaries_ui.no_description") %></p><span class="mt-3 inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(@workflow_profile.active? ? :active : :inactive) %>"><%= @workflow_profile.active? ? t("workflows_ui.active_new") : t("workflows_ui.inactive_history") %></span></div>
    <div class="flex flex-wrap gap-3"><%= link_to t("glossaries_ui.create_revision"), edit_workflow_profile_path(@workflow_profile), class: "rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %><%= button_to t("workflows_ui.duplicate"), duplicate_workflow_profile_path(@workflow_profile), method: :post, class: "rounded-lg border border-blue-200 px-4 py-2 font-semibold text-blue-700" %><% if @workflow_profile.active? %><%= button_to t("workflows_ui.deactivate"), deactivate_workflow_profile_path(@workflow_profile), method: :patch, data: { turbo_confirm: t("workflows_ui.deactivate_confirm") }, class: "rounded-lg border border-amber-300 px-4 py-2 font-semibold text-amber-800" %><% else %><%= button_to t("glossaries_ui.activate"), activate_workflow_profile_path(@workflow_profile), method: :patch, class: "rounded-lg border border-emerald-300 px-4 py-2 font-semibold text-emerald-800" %><% end %><%= link_to t("workflows_ui.all"), workflow_profiles_path, class: "rounded-lg border border-slate-300 px-4 py-2 font-semibold" %></div>
  </header>
  <aside class="rounded-xl border border-blue-200 bg-blue-50 p-5 text-sm text-blue-950"><span class="font-semibold"><%= t("workflows_ui.using") %></span> <%= t("workflows_ui.using_intro") %> <%= link_to t("glossaries_ui.translation_workspace"), new_translation_workspace_path, class: "font-semibold underline" %>. <%= t("workflows_ui.using_confirmation") %></aside>
  <% @revisions.each do |revision| %>
    <section class="rounded-xl border <%= revision.id == @workflow_profile.current_revision_id ? 'border-blue-300' : 'border-slate-200' %> bg-white p-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-xl font-semibold"><%= t("glossaries_ui.revision", version: revision.version) %><% if revision.id == @workflow_profile.current_revision_id %> · <%= t("glossaries_ui.current") %><% end %></h2><span class="text-sm font-semibold"><%= t("workflow_modes.#{revision.completion_mode}") %></span></div>
      <p class="mt-2 text-sm text-slate-600"><%= revision.name %> · <%= revision.description.presence || t("glossaries_ui.no_description") %></p>
      <p class="mt-3 break-all font-mono text-xs text-slate-500">SHA-256 <%= revision.configuration_digest %></p>
      <div class="mt-5 grid gap-4 lg:grid-cols-4">
        <% WorkflowProfileModelSelection::ROLES.each do |role| %>
          <div><h3 class="text-sm font-semibold"><%= t("workflows_ui.roles.#{role}") %> (<%= revision.role_count(role) %>)</h3><ol class="mt-2 space-y-2 text-sm"><% revision.selections_for(role).each do |selection| %><li><span class="font-medium"><%= selection.display_name_snapshot %></span><span class="block break-all text-xs text-slate-500"><%= selection.provider_snapshot %> · <%= selection.model_identifier_snapshot %></span><span class="block text-xs <%= selection.routing_identity_available? ? 'text-emerald-700' : 'text-amber-700' %>"><%= selection.routing_identity_available? ? t("workflows_ui.eligible") : t("workflows_ui.ineligible") %></span></li><% end %></ol></div>
        <% end %>
      </div>
      <% if revision.pipeline_runs.any? %><p class="mt-5 border-t border-slate-100 pt-4 text-sm text-slate-600"><%= t("workflows_ui.launched", count: revision.pipeline_runs.size) %></p><% end %>
    </section>
  <% end %>
  <%= render "shared/pagination", pagination: @pagination, label: t("glossaries_ui.revisions") %>
</div>
