<% content_for :title, "#{@workflow_profile.name} · Workflow Profile · Three Heavens" %>
<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div><p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Workflow Profile</p><h1 class="mt-2 text-3xl font-bold"><%= @workflow_profile.name %></h1><p class="mt-2 text-sm text-slate-600"><%= @workflow_profile.description.presence || "No description" %></p><span class="mt-3 inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(@workflow_profile.active? ? :active : :inactive) %>"><%= @workflow_profile.active? ? "Active · available for new pipelines" : "Inactive · history only" %></span></div>
    <div class="flex flex-wrap gap-3"><%= link_to "Create revision", edit_workflow_profile_path(@workflow_profile), class: "rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %><%= button_to "Duplicate", duplicate_workflow_profile_path(@workflow_profile), method: :post, class: "rounded-lg border border-blue-200 px-4 py-2 font-semibold text-blue-700" %><% if @workflow_profile.active? %><%= button_to "Deactivate", deactivate_workflow_profile_path(@workflow_profile), method: :patch, data: { turbo_confirm: "Deactivate this workflow profile? Historical pipelines remain unchanged." }, class: "rounded-lg border border-amber-300 px-4 py-2 font-semibold text-amber-800" %><% else %><%= button_to "Activate", activate_workflow_profile_path(@workflow_profile), method: :patch, class: "rounded-lg border border-emerald-300 px-4 py-2 font-semibold text-emerald-800" %><% end %><%= link_to "All profiles", workflow_profiles_path, class: "rounded-lg border border-slate-300 px-4 py-2 font-semibold" %></div>
  </header>
  <aside class="rounded-xl border border-blue-200 bg-blue-50 p-5 text-sm text-blue-950"><span class="font-semibold">Using profiles:</span> choose this profile in the <%= link_to "translation workspace", new_translation_workspace_path, class: "font-semibold underline" %>. Every launch still requires an explicit provider-work confirmation.</aside>
  <% @revisions.each do |revision| %>
    <section class="rounded-xl border <%= revision.id == @workflow_profile.current_revision_id ? 'border-blue-300' : 'border-slate-200' %> bg-white p-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-xl font-semibold">Revision <%= revision.version %><% if revision.id == @workflow_profile.current_revision_id %> · Current<% end %></h2><span class="text-sm font-semibold"><%= revision.completion_mode.humanize %></span></div>
      <p class="mt-2 text-sm text-slate-600"><%= revision.name %> · <%= revision.description.presence || "No description" %></p>
      <p class="mt-3 break-all font-mono text-xs text-slate-500">SHA-256 <%= revision.configuration_digest %></p>
      <div class="mt-5 grid gap-4 lg:grid-cols-4">
        <% WorkflowProfileModelSelection::ROLES.each do |role| %>
          <div><h3 class="text-sm font-semibold"><%= role.humanize.pluralize %> (<%= revision.role_count(role) %>)</h3><ol class="mt-2 space-y-2 text-sm"><% revision.selections_for(role).each do |selection| %><li><span class="font-medium"><%= selection.display_name_snapshot %></span><span class="block break-all text-xs text-slate-500"><%= selection.provider_snapshot %> · <%= selection.model_identifier_snapshot %></span><span class="block text-xs <%= selection.routing_identity_available? ? 'text-emerald-700' : 'text-amber-700' %>"><%= selection.routing_identity_available? ? "Currently eligible" : "No longer eligible" %></span></li><% end %></ol></div>
        <% end %>
      </div>
      <% if revision.pipeline_runs.any? %><p class="mt-5 border-t border-slate-100 pt-4 text-sm text-slate-600"><%= pluralize(revision.pipeline_runs.size, "historical pipeline") %> launched from this revision.</p><% end %>
    </section>
  <% end %>
  <%= render "shared/pagination", pagination: @pagination, label: "Revisions" %>
</div>
