<%= form_with url: form_url, method: form_method, scope: :glossary, class: "space-y-7" do |form| %>
  <% if @form_errors.present? %><section class="rounded-xl border border-red-200 bg-red-50 p-5" role="alert"><h2 class="font-semibold text-red-900">Please correct the following:</h2><ul class="mt-2 list-disc pl-5 text-sm text-red-800"><% @form_errors.each do |message| %><li><%= message %></li><% end %></ul></section><% end %>
  <% if @form_values["expected_version"].present? %><%= form.hidden_field :expected_version, value: @form_values["expected_version"] %><% end %>
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold">Glossary configuration</h2><div class="mt-5 grid gap-5 md:grid-cols-2"><div class="md:col-span-2"><%= form.label :name, class: "block text-sm font-medium" %><%= form.text_field :name, value: @form_values["name"], required: true, maxlength: 150, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2" %></div><div><%= form.label :source_language, class: "block text-sm font-medium" %><%= form.text_field :source_language, value: @form_values["source_language"], required: true, maxlength: 100, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2" %></div><div><%= form.label :target_language, class: "block text-sm font-medium" %><%= form.text_field :target_language, value: @form_values["target_language"], required: true, maxlength: 100, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2" %></div><div class="md:col-span-2"><%= form.label :description, "Description (optional)", class: "block text-sm font-medium" %><%= form.text_area :description, value: @form_values["description"], maxlength: 500, rows: 3, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2" %></div></div></section>
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm" data-controller="glossary-entries" data-glossary-entries-maximum-value="<%= GlossaryRevision::MAXIMUM_ENTRIES %>"><div class="flex items-start justify-between gap-4"><div><h2 class="text-lg font-semibold">Terminology entries</h2><p class="mt-1 text-sm text-slate-600">One atomic revision supports up to <%= GlossaryRevision::MAXIMUM_ENTRIES %> literal source-term mappings. Surrounding whitespace is trimmed; case and spelling remain exact.</p></div><span class="text-sm text-slate-500" data-glossary-entries-target="count"></span></div><div class="mt-5 space-y-5" data-glossary-entries-target="list"><% @form_values.fetch("entries").each do |entry| %><fieldset class="grid gap-4 rounded-lg border border-slate-200 p-4 md:grid-cols-2" data-glossary-entries-target="entry"><div class="flex items-center justify-between md:col-span-2"><legend class="text-sm font-semibold">Terminology mapping</legend><button class="text-sm font-semibold text-red-700 disabled:text-slate-400" data-action="glossary-entries#remove" data-glossary-entries-target="remove" type="button">Remove</button></div><div><label class="block text-sm font-medium">Source term</label><input class="mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2" maxlength="200" name="glossary[entries][][source_term]" required type="text" value="<%= entry["source_term"] %>"></div><div><label class="block text-sm font-medium">Preferred target term</label><input class="mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2" maxlength="200" name="glossary[entries][][preferred_target_term]" required type="text" value="<%= entry["preferred_target_term"] %>"></div><div class="md:col-span-2"><label class="block text-sm font-medium">Note (optional)</label><input class="mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2" maxlength="500" name="glossary[entries][][note]" type="text" value="<%= entry["note"] %>"></div></fieldset><% end %></div><template data-glossary-entries-target="template"><fieldset class="grid gap-4 rounded-lg border border-slate-200 p-4 md:grid-cols-2" data-glossary-entries-target="entry"><div class="flex items-center justify-between md:col-span-2"><legend class="text-sm font-semibold">Terminology mapping</legend><button class="text-sm font-semibold text-red-700 disabled:text-slate-400" data-action="glossary-entries#remove" data-glossary-entries-target="remove" type="button">Remove</button></div><div><label class="block text-sm font-medium">Source term</label><input class="mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2" maxlength="200" name="glossary[entries][][source_term]" required type="text"></div><div><label class="block text-sm font-medium">Preferred target term</label><input class="mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2" maxlength="200" name="glossary[entries][][preferred_target_term]" required type="text"></div><div class="md:col-span-2"><label class="block text-sm font-medium">Note (optional)</label><input class="mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2" maxlength="500" name="glossary[entries][][note]" type="text"></div></fieldset></template><button class="mt-5 rounded-lg border border-blue-300 px-4 py-2 text-sm font-semibold text-blue-700 disabled:border-slate-200 disabled:text-slate-400" data-action="glossary-entries#add" type="button">Add terminology mapping</button></section>
  <div class="flex flex-wrap items-center justify-between gap-3"><%= link_to "Cancel", @glossary&.persisted? ? glossary_path(@glossary) : glossaries_path, class: "text-sm font-semibold text-slate-600 hover:text-slate-950" %><%= form.submit submit_label, class: "rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white", data: { turbo_submits_with: "Saving revision…" } %></div>
<% end %>
