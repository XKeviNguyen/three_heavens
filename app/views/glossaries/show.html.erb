<% content_for :title, "#{@glossary.name} · Glossary · Three Heavens" %>
<div class="space-y-8"><header class="flex items-start justify-between gap-4"><div><p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Glossary</p><h1 class="mt-2 text-3xl font-bold"><%= @glossary.name %></h1><p class="mt-2 text-sm text-slate-600">Historical revisions remain immutable and viewable after archive.</p></div><div class="flex gap-3"><%= link_to "Revise", edit_glossary_path(@glossary), class: "rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %><%= link_to "All glossaries", glossaries_path, class: "rounded-lg border border-slate-300 px-4 py-2 font-semibold" %></div></header><% @glossary.revisions.each do |revision| %><section class="rounded-xl border <%= revision.id == @glossary.current_revision_id ? "border-blue-300" : "border-slate-200" %> bg-white p-6 shadow-sm"><div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-xl font-semibold">Revision <%= revision.version %><% if revision.id == @glossary.current_revision_id %> · Current<% end %></h2><span class="text-sm"><%= revision.source_language %> → <%= revision.target_language %></span></div><p class="mt-2 text-sm text-slate-600"><%= revision.name %> · <%= revision.description.presence || "No description" %></p><p class="mt-3 break-all font-mono text-xs text-slate-500">SHA-256 <%= revision.configuration_digest %></p><ol class="mt-5 divide-y divide-slate-100 border-y border-slate-100"><% revision.entries.each do |entry| %><li class="py-3"><span class="font-medium"><%= entry.source_term %></span> <span class="text-slate-500">→</span> <span class="font-medium"><%= entry.preferred_target_term %></span><% if entry.note.present? %><span class="ml-2 text-sm text-slate-600">— <%= entry.note %></span><% end %></li><% end %></ol><% if revision.experiments.any? %><p class="mt-4 text-sm text-slate-600"><%= pluralize(revision.experiments.size, "experiment") %> preserve this exact revision.</p><% end %></section><% end %></div>
