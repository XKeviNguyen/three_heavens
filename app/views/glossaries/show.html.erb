<% content_for :title, t("glossaries_ui.show_title", name: @glossary.name) %>
<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("glossaries_ui.singular") %></p>
      <h1 class="mt-2 text-3xl font-bold"><%= @glossary.name %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= t("glossaries_ui.show_intro") %></p>
      <span class="mt-3 inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(@glossary.active? ? :active : :archived) %>"><%= @glossary.active? ? t("glossaries_ui.active_workspace") : t("glossaries_ui.archived_history") %></span>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to t("glossaries_ui.create_revision"), edit_glossary_path(@glossary), class: "rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %>
      <% if @glossary.active? %>
        <%= button_to t("glossaries_ui.archive"), deactivate_glossary_path(@glossary), method: :patch, data: { turbo_confirm: t("glossaries_ui.archive_confirm") }, class: "rounded-lg border border-amber-300 px-4 py-2 font-semibold text-amber-800" %>
      <% else %>
        <%= button_to t("glossaries_ui.activate"), activate_glossary_path(@glossary), method: :patch, class: "rounded-lg border border-emerald-300 px-4 py-2 font-semibold text-emerald-800" %>
      <% end %>
      <%= link_to t("glossaries_ui.all"), glossaries_path, class: "rounded-lg border border-slate-300 px-4 py-2 font-semibold" %>
    </div>
  </header>

  <aside class="rounded-xl border border-blue-200 bg-blue-50 p-5 text-sm text-blue-950"><span class="font-semibold"><%= t("glossaries_ui.using") %></span> <%= t("glossaries_ui.using_intro") %> <%= link_to t("glossaries_ui.translation_workspace"), new_translation_workspace_path, class: "font-semibold underline" %>.</aside>

  <% @revisions.each do |revision| %>
    <section class="rounded-xl border <%= revision.id == @glossary.current_revision_id ? "border-blue-300" : "border-slate-200" %> bg-white p-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl font-semibold"><%= t("glossaries_ui.revision", version: revision.version) %><% if revision.id == @glossary.current_revision_id %> · <%= t("glossaries_ui.current") %><% end %></h2>
        <span class="text-sm"><%= revision.source_language %> → <%= revision.target_language %></span>
      </div>
      <p class="mt-2 text-sm text-slate-600"><%= revision.name %> · <%= revision.description.presence || t("glossaries_ui.no_description") %></p>
      <details class="mt-3 text-xs text-slate-500"><summary class="cursor-pointer font-semibold"><%= t("shared_ui.technical_details") %></summary><p class="mt-2 break-all font-mono">SHA-256 <%= revision.configuration_digest %></p></details>
      <dl class="mt-5 divide-y divide-slate-100 border-y border-slate-100">
        <% revision.entries.each do |entry| %>
          <div class="grid gap-1 py-3 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:gap-3">
            <dt class="font-medium"><%= entry.source_term %></dt><span class="hidden text-slate-400 sm:block" aria-hidden="true">→</span>
            <dd><span class="font-medium"><%= entry.preferred_target_term %></span><% if entry.note.present? %><span class="mt-1 block text-sm text-slate-600"><%= entry.note %></span><% end %></dd>
          </div>
        <% end %>
      </dl>
      <% if revision.experiments.any? %><p class="mt-4 text-sm text-slate-600"><%= t("glossaries_ui.preserved_by", count: revision.experiments.size) %></p><% end %>
    </section>
  <% end %>
  <%= render "shared/pagination", pagination: @pagination, label: t("glossaries_ui.revisions") %>
</div>
