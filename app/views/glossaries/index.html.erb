<% content_for :title, t("glossaries_ui.title") %>
<div class="space-y-8"><header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"><div><p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("glossaries_ui.translation_guidance") %></p><h1 class="mt-2 text-3xl font-bold"><%= t("glossaries_ui.heading") %></h1><p class="mt-2 text-sm text-slate-600"><%= t("glossaries_ui.index_intro") %></p></div><%= link_to t("glossaries_ui.new"), new_glossary_path, class: "w-fit rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %></header><% if @glossaries.empty? %><section class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm"><h2 class="font-semibold"><%= t("glossaries_ui.empty") %></h2><p class="mt-2 text-sm text-slate-600"><%= t("glossaries_ui.empty_intro") %></p><%= link_to t("glossaries_ui.create"), new_glossary_path, class: "mt-5 inline-flex rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %></section><% else %><section class="space-y-4" aria-label="<%= t("glossaries_ui.heading") %>"><% @glossaries.each do |glossary| %><% revision = glossary.current_revision %><article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><h2 class="text-xl font-semibold"><%= revision.name %></h2><p class="mt-1 text-sm text-slate-600"><%= revision.source_language %> → <%= revision.target_language %> · <%= t("glossaries_ui.revision", version: revision.version) %> · <%= t("glossaries_ui.entries", count: revision.entries.size) %></p></div><span class="w-fit rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(glossary.active? ? :active : :archived) %>"><%= localized_status(glossary.active? ? :active : :archived) %></span></div><p class="mt-3 text-sm text-slate-600"><%= revision.description.presence || t("glossaries_ui.no_description") %></p><div class="mt-5 flex flex-wrap gap-4 border-t border-slate-100 pt-4 text-sm font-semibold"><%= link_to t("glossaries_ui.view_history"), glossary, class: "text-blue-700" %><%= link_to t("glossaries_ui.create_revision"), edit_glossary_path(glossary), class: "text-blue-700" %><% if glossary.active? %><%= button_to t("glossaries_ui.archive"), deactivate_glossary_path(glossary), method: :patch, data: { turbo_confirm: t("glossaries_ui.archive_confirm") }, class: "text-amber-700" %><% else %><%= button_to t("glossaries_ui.activate"), activate_glossary_path(glossary), method: :patch, class: "text-emerald-700" %><% end %></div></article><% end %></section><%= render "shared/pagination", pagination: @pagination, label: t("glossaries_ui.heading") %><% end %></div>
