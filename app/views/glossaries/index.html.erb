<% content_for :title, "Glossaries · Three Heavens" %>
<div class="space-y-8"><header class="flex items-start justify-between gap-4"><div><p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Translation guidance</p><h1 class="mt-2 text-3xl font-bold">Glossaries</h1><p class="mt-2 text-sm text-slate-600">Owner-private terminology constraints with immutable revisions.</p></div><%= link_to "New glossary", new_glossary_path, class: "rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %></header><% if @glossaries.empty? %><section class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm"><h2 class="font-semibold">No glossaries yet</h2></section><% else %><section class="space-y-4"><% @glossaries.each do |glossary| %><% revision = glossary.current_revision %><article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><div class="flex items-start justify-between gap-4"><div><h2 class="text-xl font-semibold"><%= revision.name %></h2><p class="mt-1 text-sm text-slate-600"><%= revision.source_language %> → <%= revision.target_language %> · revision <%= revision.version %> · <%= pluralize(revision.entries.size, "entry") %></p></div><span class="rounded-full px-3 py-1 text-xs font-semibold <%= glossary.active? ? "bg-emerald-100 text-emerald-800" : "bg-slate-200 text-slate-700" %>"><%= glossary.active? ? "Active" : "Archived" %></span></div><p class="mt-3 text-sm text-slate-600"><%= revision.description.presence || "No description" %></p><div class="mt-5 flex gap-4 border-t border-slate-100 pt-4 text-sm font-semibold"><%= link_to "View", glossary, class: "text-blue-700" %><%= link_to "Revise", edit_glossary_path(glossary), class: "text-blue-700" %><% if glossary.active? %><%= button_to "Archive", deactivate_glossary_path(glossary), method: :patch, class: "text-amber-700" %><% else %><%= button_to "Activate", activate_glossary_path(glossary), method: :patch, class: "text-emerald-700" %><% end %></div></article><% end %></section><% end %></div>
