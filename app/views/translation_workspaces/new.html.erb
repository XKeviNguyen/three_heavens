<% content_for :title, "Translation workspace · Three Heavens" %>

<div class="mx-auto max-w-4xl">
  <div class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Translation workspace</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= @translation_workspace.existing_project? ? "Add a translation to this Project" : "Start a translation experiment" %></h1>
    <p class="mt-3 max-w-2xl text-slate-600"><%= @translation_workspace.existing_project? ? "Create another source document and translation experiment inside this reusable Project." : "Create a source document and compare translations from one or more active OpenRouter models." %></p>
    <% unless @translation_workspace.source_import %>
      <%= link_to "Upload source file", new_source_import_path(project_id: @translation_workspace.project_id), class: "mt-4 inline-flex rounded-lg border border-blue-200 px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50" %>
    <% end %>
  </div>

  <%= form_with model: @translation_workspace, url: translation_workspace_path, class: "space-y-8" do |form| %>
    <%= form.hidden_field :submission_token %>
    <% if @translation_workspace.existing_project? %><%= form.hidden_field :project_id %><% end %>
    <% if @translation_workspace.source_import %>
      <%= form.hidden_field :source_import_id, value: @translation_workspace.source_import.id %>
      <% if @translation_workspace.source_import_project_token.present? %><%= form.hidden_field :source_import_project_token %><% end %>
      <% if @translation_workspace.source_import.available? %>
        <section class="rounded-xl border border-emerald-200 bg-emerald-50 p-5">
          <h2 class="font-semibold text-emerald-950">Uploaded source ready for review</h2>
          <p class="mt-1 text-sm text-emerald-800"><%= @translation_workspace.source_import.original_filename %> · <%= number_to_human_size(@translation_workspace.source_import.byte_size) %> · <%= @translation_workspace.source_import.imported_format.upcase %></p>
          <p class="mt-2 text-sm text-emerald-800">Review and edit the extracted text below. Translation runs start only after this complete form is accepted.</p>
      <% else %>
        <section class="rounded-xl border border-red-200 bg-red-50 p-5">
          <h2 class="font-semibold text-red-950">Uploaded source is no longer available</h2>
          <p class="mt-1 text-sm text-red-800">This temporary import expired or was already used. Cancel it and upload the source again.</p>
      <% end %>
        <%= link_to "Cancel this import", source_import_path(@translation_workspace.source_import), data: { turbo_method: :delete, turbo_confirm: "Cancel this import and remove its temporary upload?" }, class: "mt-3 inline-flex text-sm font-semibold text-red-700 hover:text-red-900" %>
      </section>
    <% end %>
    <% if @translation_workspace.errors.any? %>
      <section class="rounded-xl border border-red-200 bg-red-50 p-5" aria-labelledby="form-errors-heading">
        <h2 id="form-errors-heading" class="font-semibold text-red-900">Please correct the following:</h2>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-800">
          <% @translation_workspace.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <% if @translation_workspace.existing_project? %>
        <h2 class="text-lg font-semibold text-slate-950">Project</h2>
        <p class="mt-3 text-xl font-semibold text-slate-950"><%= @translation_workspace.project.name %></p>
        <p class="mt-1 text-sm text-slate-600"><%= @translation_workspace.project.source_language %> → <%= @translation_workspace.project.target_language %></p>
        <p class="mt-3 text-sm text-slate-600">The Project name and language pair are fixed for this launch.</p>
        <%= link_to "Back to Project", project_path(@translation_workspace.project), class: "mt-4 inline-flex text-sm font-semibold text-blue-700 hover:text-blue-900" %>
      <% else %>
        <h2 class="text-lg font-semibold text-slate-950">Project and languages</h2>
        <div class="mt-5 grid gap-5 md:grid-cols-2">
          <div class="md:col-span-2">
            <%= form.label :project_name, class: "block text-sm font-medium text-slate-700" %>
            <%= form.text_field :project_name, required: true, maxlength: 150, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
          </div>
          <div>
            <%= form.label :source_language, class: "block text-sm font-medium text-slate-700" %>
            <%= form.text_field :source_language, required: true, placeholder: "e.g. Vietnamese", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
          </div>
          <div>
            <%= form.label :target_language, class: "block text-sm font-medium text-slate-700" %>
            <%= form.text_field :target_language, required: true, placeholder: "e.g. Japanese", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
          </div>
        </div>
      <% end %>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950">Source document</h2>
      <div class="mt-5 space-y-5">
        <div>
          <%= form.label :document_title, class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :document_title, required: true, maxlength: 255, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
        </div>
        <div>
          <%= form.label :source_text, (@translation_workspace.source_import ? "Reviewed source text" : "Source text"), class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_area :source_text, required: true, maxlength: Ai::UsageLimits::MAX_SOURCE_CHARACTERS, rows: 10, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
        </div>
      </div>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950">Experiment</h2>
      <div class="mt-5 space-y-5">
        <div>
          <%= form.label :experiment_name, "Experiment name (optional)", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :experiment_name, maxlength: 150, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
        </div>
        <div>
          <%= form.label :instruction_prompt, "Translation instruction", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_area :instruction_prompt, required: true, maxlength: Ai::UsageLimits::MAX_INSTRUCTION_CHARACTERS, rows: 5, placeholder: "Describe tone, terminology, formatting, and other translation requirements.", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
        </div>
      </div>
    </section>

    <fieldset class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <legend class="px-1 text-lg font-semibold text-slate-950">Terminology glossary</legend>
      <p class="mt-1 text-sm text-slate-600">Optional owner-defined terminology guidance. The selected immutable revision applies to manual and automatic workflows.</p>
      <div class="mt-4 space-y-3">
        <label class="block rounded-lg border border-slate-200 p-4"><span class="flex items-start gap-3"><%= form.radio_button :glossary_revision_id, "", checked: @translation_workspace.glossary_revision_id.blank?, class: "mt-1 size-4" %><span><span class="font-semibold">No glossary</span><span class="mt-1 block text-sm text-slate-600">Continue without terminology constraints.</span></span></span></label>
        <% @glossaries.each do |glossary| %>
          <% revision = glossary.current_revision %>
          <label class="block rounded-lg border border-slate-200 p-4"><span class="flex items-start gap-3"><%= form.radio_button :glossary_revision_id, revision.id, checked: @translation_workspace.glossary_revision_id.to_s == revision.id.to_s, class: "mt-1 size-4" %><span><span class="block font-semibold"><%= revision.name %> · revision <%= revision.version %></span><span class="mt-1 block text-sm text-slate-600"><%= revision.source_language %> → <%= revision.target_language %> · <%= pluralize(revision.entries.size, "entry") %></span></span></span></label>
        <% end %>
      </div>
      <% if @glossaries.empty? %><p class="mt-4 text-sm text-slate-600"><%= link_to "Create a glossary", new_glossary_path, class: "font-semibold text-blue-700" %> to add reusable terminology guidance.</p><% end %>
    </fieldset>

    <fieldset class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <legend class="px-1 text-lg font-semibold text-slate-950">Translation methodology</legend>
      <p class="mt-1 text-sm text-slate-600">Optional reusable guidance for how the translation should be produced. This is independent from literal terminology glossaries and workflow/model profiles.</p>
      <div class="mt-4 space-y-3">
        <label class="block rounded-lg border border-slate-200 p-4"><span class="flex items-start gap-3"><%= form.radio_button :methodology_profile_revision_id, "", checked: @translation_workspace.methodology_profile_revision_id.blank?, class: "mt-1 size-4" %><span><span class="font-semibold">No methodology</span><span class="mt-1 block text-sm text-slate-600">Continue with only the experiment instruction and any selected glossary.</span></span></span></label>
        <% @methodology_profiles.each do |profile| %>
          <% revision = profile.current_revision %>
          <label class="block rounded-lg border border-slate-200 p-4"><span class="flex items-start gap-3"><%= form.radio_button :methodology_profile_revision_id, revision.id, checked: @translation_workspace.methodology_profile_revision_id.to_s == revision.id.to_s, class: "mt-1 size-4" %><span><span class="block font-semibold"><%= revision.name %> · revision <%= revision.version %></span><span class="mt-1 block text-sm text-slate-600"><%= revision.source_language %> → <%= revision.target_language %></span></span></span></label>
        <% end %>
      </div>
      <% if @methodology_profiles.empty? %><p class="mt-4 text-sm text-slate-600"><%= link_to "Create a methodology profile", new_methodology_profile_path, class: "font-semibold text-blue-700" %> to add reusable translation guidance.</p><% end %>
    </fieldset>

    <fieldset class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <legend class="px-1 text-lg font-semibold text-slate-950">Workflow mode</legend>
      <p class="mt-1 text-sm text-slate-600">Manual keeps every later stage under separate controls. Automatic uses one immutable profile and progresses only through its authorized initial provider work.</p>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        <label class="rounded-lg border border-slate-200 p-4"><%= form.radio_button :workflow_mode, "manual", checked: @translation_workspace.workflow_mode == "manual" %> <span class="ml-2 font-semibold">Manual workflow</span><span class="mt-1 block text-sm text-slate-600">Select translators below and start later stages yourself.</span></label>
        <label class="rounded-lg border border-slate-200 p-4"><%= form.radio_button :workflow_mode, "automatic", checked: @translation_workspace.workflow_mode == "automatic" %> <span class="ml-2 font-semibold">Automatic pipeline</span><span class="mt-1 block text-sm text-slate-600">Select an exact profile revision and authorize its configured stages.</span></label>
      </div>
    </fieldset>

    <fieldset class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <legend class="px-1 text-lg font-semibold text-slate-950">Automatic pipeline profile</legend>
      <%= form.hidden_field :automatic_plan_digest %>
      <% if @workflow_profiles.any? %>
        <div class="mt-4 space-y-3">
          <% @workflow_profiles.each do |profile| %>
            <% revision = profile.current_revision %>
            <label class="block rounded-lg border border-slate-200 p-4">
              <span class="flex items-start gap-3"><%= form.radio_button :workflow_profile_revision_id, revision.id, checked: @translation_workspace.workflow_profile_revision_id.to_s == revision.id.to_s, class: "mt-1 size-4" %><span><span class="block font-semibold"><%= revision.name %> · revision <%= revision.version %></span><span class="mt-1 block text-sm text-slate-600"><%= revision.completion_mode.humanize %> · <%= revision.role_count("translator") %> translators · <%= revision.role_count("reviewer") %> reviewers · <%= revision.role_count("judge") %> judges · <%= revision.role_count("finalizer") %> finalizers = <%= revision.authorized_initial_provider_run_count %> initial provider run slots</span></span></span>
            </label>
          <% end %>
        </div>
        <% if @translation_workspace.provider_work_plan_preview %>
          <% work_plan = @translation_workspace.provider_work_plan_preview %>
          <section class="mt-5 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950">
            <h3 class="font-semibold">Exact segmented provider-work plan</h3>
            <p class="mt-1"><%= work_plan.fetch("segment_count") %> source segments require <strong><%= work_plan.fetch("authorized_initial_provider_request_slots") %></strong> authorized initial provider request slots.</p>
            <ul class="mt-2 list-disc space-y-1 pl-5">
              <% work_plan.fetch("roles").each do |role, details| %>
                <li><%= role.humanize.pluralize %>: <%= details.fetch("logical_run_count") %> logical runs × <%= work_plan.fetch("segment_count") %> segments = <%= details.fetch("provider_request_slots") %> requests</li>
              <% end %>
            </ul>
            <p class="mt-2">Review this exact multiplier and check the authorization box again. Built-in retries may add requests.</p>
          </section>
        <% end %>
        <label class="mt-5 flex items-start gap-3 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950">
          <%= form.check_box :automatic_confirmation, { checked: @translation_workspace.automatic_confirmation == "1", class: "mt-1 size-4" }, "1", "0" %>
          <span><span class="font-semibold">I authorize this profile's initial provider work for this launch.</span> Automatic progression causes provider usage and cost. Built-in bounded provider retries may add requests; terminal failures still require an explicit manual retry. Stopping cannot cancel work already queued or running.</span>
        </label>
      <% else %>
        <p class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800">No active workflow profile is available. <%= link_to "Create a Workflow Profile", new_workflow_profile_path, class: "font-semibold underline" %>.</p>
      <% end %>
    </fieldset>

    <fieldset class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <legend class="px-1 text-lg font-semibold text-slate-950">Manual OpenRouter models</legend>
      <p class="mt-1 text-sm text-slate-600">Select 1–<%= Ai::UsageLimits::MAX_TRANSLATION_MODELS %> models. Each model creates an independent translation run.</p>

      <% if @available_models.any? %>
        <div class="mt-5 grid gap-3 md:grid-cols-2">
          <% @available_models.each do |llm_model| %>
            <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/40">
              <%= check_box_tag "translation_workspace[model_ids][]", llm_model.id, @translation_workspace.model_ids.map(&:to_s).include?(llm_model.id.to_s), id: "translation_workspace_model_ids_#{llm_model.id}", class: "mt-1 size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
              <span>
                <span class="block font-medium text-slate-900"><%= llm_model.display_name %></span>
                <span class="mt-1 block text-xs text-slate-500"><%= llm_model.provider %> · <%= llm_model.model_identifier %></span>
              </span>
            </label>
          <% end %>
        </div>
      <% else %>
        <p class="mt-5 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800">No active OpenRouter models are currently available.</p>
      <% end %>
    </fieldset>

    <div class="flex justify-end">
      <%= form.submit "Start translation runs", disabled: @available_models.empty?, class: "rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white shadow-sm hover:bg-blue-800 disabled:cursor-not-allowed disabled:bg-slate-400" %>
    </div>
  <% end %>
</div>
