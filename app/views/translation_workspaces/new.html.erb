<% content_for :title, "New translation · Three Heavens" %>

<div class="mx-auto max-w-6xl">
  <div class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-wider text-blue-700">Translation workspace</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= @translation_workspace.existing_project? ? "Add a translation to this Project" : "New translation" %></h1>
    <p class="mt-3 max-w-2xl text-slate-600">Paste or upload a document, choose your languages and AI models, then review the best translation.</p>
    <% if @translation_workspace.existing_project? %>
      <p class="mt-2 text-sm text-slate-500">This translation will be added to <span class="font-semibold text-slate-700"><%= @translation_workspace.project.name %></span>.</p>
    <% end %>
  </div>

  <% if @repeated_from_experiment %>
    <section class="mb-8 rounded-2xl border border-blue-200 bg-blue-50/70 p-5 text-sm text-blue-950">
      <h2 class="font-semibold">Prefilled from a previous translation</h2>
      <p class="mt-1">The previous translation remains unchanged. Only settings that are still active and current are preselected. Review every field and explicitly authorize any paid work; starting creates new experiment, run, and provider-attempt identities.</p>
    </section>
  <% end %>
  <% if @repeat_configuration_notice %><p class="mb-8 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900" role="status"><%= @repeat_configuration_notice %></p><% end %>

  <%= form_with model: @translation_workspace, url: translation_workspace_path, id: "workspace-form", class: "space-y-8", data: { controller: "workflow-mode" } do |form| %>
    <%= form.hidden_field :submission_token %>
    <% if @translation_workspace.existing_project? %><%= form.hidden_field :project_id %><% end %>
    <% if @translation_workspace.source_import %>
      <%= form.hidden_field :source_import_id, value: @translation_workspace.source_import.id %>
      <% if @translation_workspace.source_import_project_token.present? %><%= form.hidden_field :source_import_project_token %><% end %>
    <% end %>
    <%= form.hidden_field :automatic_plan_digest %>

    <% if @translation_workspace.errors.any? %>
      <section class="rounded-2xl border border-red-200 bg-red-50 p-5" aria-labelledby="form-errors-heading" role="alert">
        <h2 id="form-errors-heading" class="font-semibold text-red-900">Please correct the following:</h2>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-800">
          <% @translation_workspace.errors.each do |error| %>
            <li><%= link_to error.full_message, "##{workspace_error_anchor(error.attribute)}", class: "underline decoration-red-300 underline-offset-2" %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <div class="grid gap-8 xl:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="space-y-6">

        <section id="workspace-project" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-1.5">
            <h2 class="text-lg font-semibold text-slate-950">Source</h2>
          </div>
          <% if @translation_workspace.existing_project? %>
            <div class="mt-4 rounded-xl bg-slate-50 p-4">
              <p class="flex items-center gap-1.5 text-sm font-semibold text-slate-900">
                Project
                <%= render "shared/hint", text: "A reusable container for documents that share the same language pair.", label: "Project" %>
              </p>
              <p class="mt-2 text-lg font-semibold text-slate-950"><%= @translation_workspace.project.name %></p>
              <p class="mt-1 text-sm text-slate-600"><%= @translation_workspace.project.source_language %> → <%= @translation_workspace.project.target_language %></p>
              <p class="mt-2 text-xs text-slate-500">The project name and language pair are fixed for this translation.</p>
              <%= link_to "Back to project", project_path(@translation_workspace.project), class: "mt-3 inline-flex text-sm font-semibold text-blue-700 hover:text-blue-900" %>
            </div>
          <% else %>
            <div class="mt-5 grid gap-5 md:grid-cols-2">
              <div class="md:col-span-2">
                <div class="flex items-center gap-1.5">
                  <%= form.label :project_name, "Project name", class: "block text-sm font-medium text-slate-700" %>
                  <%= render "shared/hint", text: "A reusable container for documents that share the same language pair.", label: "Project" %>
                </div>
                <%= form.text_field :project_name, required: true, maxlength: 150, class: "mt-2 block w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
              </div>
              <%= render "shared/language_combobox", form: form, method: :source_language, label: "Source language", value: @translation_workspace.source_language, hint: "The language of the document you are translating." %>
              <%= render "shared/language_combobox", form: form, method: :target_language, label: "Target language", value: @translation_workspace.target_language, hint: "The language the finished translation should be written in." %>
            </div>
          <% end %>
        </section>

        <section id="workspace-source" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-controller="source-mode">
          <div class="flex items-center gap-1.5">
            <h2 class="text-lg font-semibold text-slate-950">Source document</h2>
            <%= render "shared/hint", text: "The text the translation is based on. Uploading and previewing never contacts an AI provider.", label: "Source document" %>
          </div>

          <div class="mt-5 inline-flex rounded-xl border border-slate-200 bg-slate-50 p-1" role="tablist" aria-label="Source input method">
            <button type="button" role="tab" aria-selected="true" aria-controls="source-paste-panel" data-source-mode-target="pasteTab" data-action="source-mode#showPaste" class="rounded-lg px-4 py-2 text-sm font-semibold text-slate-700 aria-selected:bg-white aria-selected:text-slate-950 aria-selected:shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">Paste text</button>
            <button type="button" role="tab" aria-selected="false" aria-controls="source-upload-panel" data-source-mode-target="uploadTab" data-action="source-mode#showUpload" class="rounded-lg px-4 py-2 text-sm font-semibold text-slate-700 aria-selected:bg-white aria-selected:text-slate-950 aria-selected:shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">Upload file</button>
          </div>

          <div id="source-paste-panel" data-source-mode-target="paste" class="mt-5 space-y-5">
            <div>
              <div class="flex items-center gap-1.5">
                <%= form.label :document_title, "Document title", class: "block text-sm font-medium text-slate-700" %>
                <%= render "shared/hint", text: "A short name used to identify this source in projects and history.", label: "Document title" %>
              </div>
              <%= form.text_field :document_title, required: true, maxlength: 255, class: "mt-2 block w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <%= form.label :source_text, (@translation_workspace.source_import ? "Reviewed source text" : "Source text"), class: "block text-sm font-medium text-slate-700" %>
              </div>
              <%= form.text_area :source_text, required: true, maxlength: Ai::UsageLimits::MAX_SOURCE_CHARACTERS, rows: 12, class: "mt-2 block w-full rounded-xl border border-slate-300 px-3 py-2.5 font-mono text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
            </div>
          </div>

          <div id="source-upload-panel" data-source-mode-target="upload" class="mt-5" hidden>
            <%= turbo_frame_tag "source-import-upload", src: new_source_import_path(project_id: @translation_workspace.project_id) do %>
              <p class="text-sm text-slate-500">Loading the secure upload area…</p>
            <% end %>
          </div>

          <% if @translation_workspace.source_import %>
            <% source_import = @translation_workspace.source_import %>
            <div id="workspace-source-import" class="mt-5 rounded-xl border <%= source_import.available? ? "border-emerald-200 bg-emerald-50" : "border-red-200 bg-red-50" %> p-4">
              <% if source_import.available? %>
                <h2 class="text-sm font-semibold text-emerald-950">Uploaded source ready for review</h2>
                <p class="mt-1 text-sm text-emerald-800"><%= source_import.original_filename %> · <%= number_to_human_size(source_import.byte_size) %> · <%= source_import.imported_format.to_s.upcase %></p>
                <p class="mt-2 text-sm text-emerald-800">Review and edit the extracted text above. Translation runs begin only after this form is accepted.</p>
              <% else %>
                <h2 class="text-sm font-semibold text-red-950">Uploaded source is no longer available</h2>
                <p class="mt-1 text-sm text-red-800"><%= source_import.availability_message %></p>
              <% end %>
              <%= link_to "Cancel this import", source_import_path(source_import), data: { turbo_method: :delete, turbo_confirm: "Cancel this import and remove its temporary upload?" }, class: "mt-3 inline-flex text-sm font-semibold text-red-700 hover:text-red-900" %>
            </div>
          <% end %>
        </section>

        <section id="workspace-experiment" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-semibold text-slate-950">Your instructions</h2>
          <div class="mt-5 space-y-5">
            <div>
              <div class="flex items-center gap-1.5">
                <%= form.label :experiment_name, "Translation name (optional)", class: "block text-sm font-medium text-slate-700" %>
                <%= render "shared/hint", text: "A short label for this translation. Leave blank to use the document title.", label: "Translation name" %>
              </div>
              <%= form.text_field :experiment_name, maxlength: 150, class: "mt-2 block w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <%= form.label :instruction_prompt, "Instructions for the translation", class: "block text-sm font-medium text-slate-700" %>
                <%= render "shared/hint", text: "Tell the AI how this translation should read. These instructions apply to every model and stage.", label: "Instructions for the translation" %>
              </div>
              <%= form.text_area :instruction_prompt, required: true, maxlength: Ai::UsageLimits::MAX_INSTRUCTION_CHARACTERS, rows: 5, placeholder: "Tone, terminology, audience, formatting, names to preserve, or anything else the translation should follow.", class: "mt-2 block w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
            </div>
          </div>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-semibold text-slate-950">Translation guidance</h2>
          <p class="mt-1 text-sm text-slate-600">Optional owner guidance that shapes terminology, style, and wording.</p>

          <fieldset id="workspace-glossary" class="mt-5">
            <legend class="flex items-center gap-1.5 text-sm font-semibold text-slate-900">
              Terminology
              <%= render "shared/hint", text: "Preferred terms Three Heavens should preserve consistently in this translation.", label: "Terminology" %>
            </legend>
            <div class="mt-3">
              <%= turbo_frame_tag "workspace-terminology" do %>
                <%= render "workspace_terminology/panel", glossaries: @glossaries, selected_revision_id: @translation_workspace.glossary_revision_id, pagination: @glossaries_pagination %>
              <% end %>
            </div>
          </fieldset>

          <details class="mt-6 rounded-xl border border-slate-200 p-4">
            <summary class="cursor-pointer text-sm font-semibold text-slate-800">References, methodology, and guidance priority</summary>
            <div class="mt-4 space-y-6">
              <fieldset id="workspace-references">
                <legend class="flex items-center gap-1.5 text-sm font-semibold text-slate-900">
                  References
                  <%= render "shared/hint", text: "Approved bilingual examples the AI can follow for style and wording.", label: "References" %>
                </legend>
                <p class="mt-1 text-xs text-slate-500">Select up to 5 examples. The exact selected revisions apply to the whole translation.</p>
                <div class="mt-3 space-y-2">
                  <% @translation_references.each do |reference| %>
                    <% revision = reference.current_revision %>
                    <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-3 hover:border-blue-300 hover:bg-blue-50/40">
                      <%= check_box_tag "translation_workspace[translation_reference_revision_ids][]", revision.id, @translation_workspace.translation_reference_revision_ids.map(&:to_s).include?(revision.id.to_s), id: "translation_workspace_translation_reference_revision_ids_#{revision.id}", class: "mt-1 size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
                      <span><span class="block text-sm font-medium"><%= revision.title %> · revision <%= revision.version %></span><span class="mt-0.5 block text-xs text-slate-500"><%= revision.source_language %> → <%= revision.target_language %></span></span>
                    </label>
                  <% end %>
                </div>
                <%= render "translation_workspaces/configuration_pagination", pagination: @translation_references_pagination, label: "Translation references", page_param: :translation_reference_page %>
                <% selected_count = @translation_workspace.translation_reference_revision_ids.count(&:present?) %>
                <p class="mt-3 text-xs font-semibold text-slate-600"><%= selected_count %> of 5 references selected</p>
                <% if @translation_references.empty? %><p class="mt-3 text-xs text-slate-500"><%= link_to "Create a reference", new_translation_reference_path, class: "font-semibold text-blue-700" %> to add approved bilingual examples.</p><% end %>
              </fieldset>

              <fieldset id="workspace-methodology">
                <legend class="flex items-center gap-1.5 text-sm font-semibold text-slate-900">
                  Methodology
                  <%= render "shared/hint", text: "Reusable guidance describing how translations should be produced.", label: "Methodology" %>
                </legend>
                <div class="mt-3 space-y-2">
                  <label class="block rounded-xl border border-slate-200 p-3"><span class="flex items-start gap-3"><%= form.radio_button :methodology_profile_revision_id, "", checked: @translation_workspace.methodology_profile_revision_id.blank?, class: "mt-1 size-4" %><span><span class="text-sm font-semibold">No methodology</span><span class="mt-0.5 block text-xs text-slate-500">Continue with only the instructions and any selected terminology.</span></span></span></label>
                  <% @methodology_profiles.each do |profile| %>
                    <% revision = profile.current_revision %>
                    <label class="block rounded-xl border border-slate-200 p-3"><span class="flex items-start gap-3"><%= form.radio_button :methodology_profile_revision_id, revision.id, checked: @translation_workspace.methodology_profile_revision_id.to_s == revision.id.to_s, class: "mt-1 size-4" %><span><span class="block text-sm font-semibold"><%= revision.name %> · revision <%= revision.version %></span><span class="mt-0.5 block text-xs text-slate-500"><%= revision.source_language %> → <%= revision.target_language %></span></span></span></label>
                  <% end %>
                </div>
                <%= render "translation_workspaces/configuration_pagination", pagination: @methodology_profiles_pagination, label: "Methodology profiles", page_param: :methodology_profile_page %>
                <% if @methodology_profiles.empty? %><p class="mt-3 text-xs text-slate-500"><%= link_to "Create a methodology profile", new_methodology_profile_path, class: "font-semibold text-blue-700" %> to add reusable translation guidance.</p><% end %>
              </fieldset>

              <fieldset id="workspace-guidance">
                <legend class="flex items-center gap-1.5 text-sm font-semibold text-slate-900">
                  Guidance priority
                  <%= render "shared/hint", text: "If selected guidance suggests different wording, choose which source wins.", label: "Guidance priority" %>
                </legend>
                <div class="mt-3 space-y-2">
                  <% TranslationGuidance::Policy::LABELS.each do |value, label| %>
                    <label class="flex items-center gap-3 rounded-xl border border-slate-200 p-3"><%= form.radio_button :guidance_preference, value, checked: @translation_workspace.guidance_preference == value, class: "size-4" %><span class="text-sm font-semibold"><%= label %></span></label>
                  <% end %>
                </div>
              </fieldset>
            </div>
          </details>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-semibold text-slate-950">AI workflow</h2>
          <fieldset id="workspace-workflow-mode" class="mt-5">
            <legend class="flex items-center gap-1.5 text-sm font-semibold text-slate-900">
              Workflow mode
              <%= render "shared/hint", text: "Manual lets you start each stage. Automatic advances a saved workflow and always stops for the human editor.", label: "Workflow mode" %>
            </legend>
            <div class="mt-3 grid gap-3 md:grid-cols-2">
              <label class="cursor-pointer rounded-xl border border-slate-200 p-4 has-checked:border-blue-500 has-checked:bg-blue-50"><%= form.radio_button :workflow_mode, "manual", checked: @translation_workspace.workflow_mode == "manual", data: { action: "workflow-mode#update" } %> <span class="ml-2 text-sm font-semibold">Manual workflow</span><span class="mt-1 block text-xs text-slate-600">Choose models now, then start review, judging, and editing yourself.</span></label>
              <label class="cursor-pointer rounded-xl border border-slate-200 p-4 has-checked:border-blue-500 has-checked:bg-blue-50"><%= form.radio_button :workflow_mode, "automatic", checked: @translation_workspace.workflow_mode == "automatic", data: { action: "workflow-mode#update" } %> <span class="ml-2 text-sm font-semibold">Automatic pipeline</span><span class="mt-1 block text-xs text-slate-600">Use a saved workflow to advance through its stages, stopping for the human editor.</span></label>
            </div>
          </fieldset>

          <fieldset id="workspace-manual-models" class="mt-6" data-workflow-mode-target="manual" data-available="<%= @available_models.any? %>">
            <legend class="flex items-center gap-1.5 text-sm font-semibold text-slate-900">
              AI models
              <%= render "shared/hint", text: "Choose one or more OpenRouter models to create independent candidates.", label: "AI models" %>
            </legend>
            <p class="mt-1 text-xs text-slate-500">Select 1–<%= Ai::UsageLimits::MAX_TRANSLATION_MODELS %> models. Each model creates an independent translation candidate.</p>
            <div class="mt-4">
              <%= render "shared/model_picker",
                    role: "translator",
                    name: "translation_workspace[model_identifiers][]",
                    max: Ai::UsageLimits::MAX_TRANSLATION_MODELS,
                    label: "Search OpenRouter",
                    hint: "Search the live OpenRouter catalog. Only models that support this translation stage are suggested.",
                    description: "New models are added with trusted catalog metadata; existing saved models keep their history.",
                    selected: @translation_workspace.model_identifier_selections %>
            </div>
            <div class="mt-5 rounded-xl border border-slate-200 p-4">
              <p class="text-sm font-medium text-slate-700">Saved models</p>
              <% if @available_models.any? %>
                <div class="mt-3 grid gap-2 md:grid-cols-2">
                  <% @available_models.each do |llm_model| %>
                    <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-3 hover:border-blue-300 hover:bg-blue-50/40">
                      <%= check_box_tag "translation_workspace[model_ids][]", llm_model.id, @translation_workspace.model_ids.map(&:to_s).include?(llm_model.id.to_s), id: "translation_workspace_model_ids_#{llm_model.id}", class: "mt-1 size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
                      <span>
                        <span class="block text-sm font-medium text-slate-900"><%= llm_model.display_name %></span>
                        <span class="mt-0.5 block break-all text-xs text-slate-500"><%= llm_model.provider %> · <%= llm_model.model_identifier %></span>
                      </span>
                    </label>
                  <% end %>
                </div>
              <% else %>
                <p class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-800" role="status">No active saved models are available. Search the live catalog above, or choose an automatic workflow.</p>
              <% end %>
            </div>
          </fieldset>

          <fieldset id="workspace-automatic" class="mt-6" data-workflow-mode-target="automatic" data-available="<%= @workflow_profiles.any? %>">
            <legend class="flex items-center gap-1.5 text-sm font-semibold text-slate-900">
              Saved workflow
              <%= render "shared/hint", text: "A saved workflow defines every model role and where automation stops. You will always review the winning draft.", label: "Saved workflow" %>
            </legend>
            <% if @workflow_profiles.any? %>
              <div class="mt-3 space-y-2">
                <% @workflow_profiles.each do |profile| %>
                  <% revision = profile.current_revision %>
                  <label class="block rounded-xl border border-slate-200 p-4">
                    <span class="flex items-start gap-3"><%= form.radio_button :workflow_profile_revision_id, revision.id, checked: @translation_workspace.workflow_profile_revision_id.to_s == revision.id.to_s, class: "mt-1 size-4" %><span><span class="block text-sm font-semibold"><%= revision.name %> · revision <%= revision.version %></span><span class="mt-1 block text-xs text-slate-600"><%= revision.completion_mode.humanize %> · <%= revision.role_count("translator") %> translators · <%= revision.role_count("reviewer") %> reviewers · <%= revision.role_count("judge") %> judges · <%= revision.role_count("finalizer") %> finalizers = <%= revision.authorized_initial_provider_run_count %> initial requests for a single-segment source, at most <%= revision.authorized_initial_provider_run_count * Ai::ProviderRetryPolicy::MAX_ATTEMPTS_PER_AUTHORIZATION %> including built-in retries</span><span class="mt-1 block text-xs text-slate-500">Models: <%= revision.model_selections.map(&:display_name_snapshot).to_sentence %>. Stages: translation → blind review → independent judging<%= " → refinement proposals" if revision.refinement_proposals? %> → human editor.</span></span></span>
                  </label>
                <% end %>
              </div>
              <%= render "translation_workspaces/configuration_pagination", pagination: @workflow_profiles_pagination, label: "Workflow profiles", page_param: :workflow_profile_page %>
              <% if @translation_workspace.provider_work_plan_preview %>
                <% work_plan = @translation_workspace.provider_work_plan_preview %>
                <section class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950">
                  <div class="flex items-center gap-1.5">
                    <h3 class="font-semibold">Paid-work authorization</h3>
                    <%= render "shared/hint", text: "Automatic workflows make paid OpenRouter requests. Review the exact bounded plan before authorizing.", label: "Paid-work authorization" %>
                  </div>
                  <p class="mt-1"><%= work_plan.fetch("segment_count") %> source segment(s) require <strong><%= work_plan.fetch("authorized_initial_provider_request_slots") %></strong> initial provider request slots and authorize at most <strong><%= work_plan.fetch("maximum_automatic_provider_requests") %></strong> requests including built-in retries.</p>
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-xs">
                    <% work_plan.fetch("roles").each do |role, details| %>
                      <li><%= role.humanize.pluralize %>: <%= details.fetch("logical_run_count") %> logical runs × <%= work_plan.fetch("segment_count") %> segments = <%= details.fetch("provider_request_slots") %> requests</li>
                    <% end %>
                  </ul>
                  <p class="mt-2 text-xs">Every slot has an exact ceiling of <%= work_plan.dig("built_in_retry_policy", "maximum_attempts_per_slot") %> attempts. The pipeline stops for the human editor; refinement is <%= work_plan.dig("roles", "finalizer", "logical_run_count").positive? ? "included as proposals only" : "not included" %>. Review this plan and check the authorization box again.</p>
                </section>
              <% end %>
              <label class="mt-4 flex items-start gap-3 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950">
                <%= form.check_box :automatic_confirmation, { checked: @translation_workspace.automatic_confirmation == "1", class: "mt-1 size-4" }, "1", "0" %>
                <span><span class="font-semibold">I authorize the exact bounded provider-work plan shown for this launch.</span> Automatic progression causes provider usage and cost. Each initial slot may make at most <%= Ai::ProviderRetryPolicy::MAX_ATTEMPTS_PER_AUTHORIZATION %> attempts; terminal failures require a separate explicit manual retry. The pipeline always stops for the human editor. Stopping future automation cannot cancel work already queued or running.</span>
              </label>
            <% else %>
              <p class="mt-3 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800" role="status">No active workflow is available. <%= link_to "Create a workflow", new_workflow_profile_path, class: "font-semibold underline" %>, or choose the manual workflow.</p>
            <% end %>
          </fieldset>
        </section>
      </div>

      <aside class="xl:sticky xl:top-8 xl:self-start">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Review and start</h2>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex items-start justify-between gap-3">
              <dt class="text-slate-500">Language pair</dt>
              <dd class="text-right font-medium text-slate-900"><%= [ @translation_workspace.source_language.presence || @translation_workspace.project&.source_language, @translation_workspace.target_language.presence || @translation_workspace.project&.target_language ].compact.join(" → ").presence || "Not set" %></dd>
            </div>
            <div class="flex items-start justify-between gap-3">
              <dt class="text-slate-500">Workflow</dt>
              <dd class="text-right font-medium text-slate-900"><%= @translation_workspace.workflow_mode == "automatic" ? "Automatic" : "Manual" %></dd>
            </div>
            <div class="flex items-start justify-between gap-3">
              <dt class="text-slate-500">Source</dt>
              <dd class="text-right font-medium text-slate-900"><%= @translation_workspace.source_import ? "Uploaded file" : "Pasted text" %></dd>
            </div>
          </dl>
          <p class="mt-4 rounded-xl bg-slate-50 px-3 py-2 text-xs text-slate-600">Submitting is retry-safe. Paid provider work begins only after this form passes validation and, for automatic workflows, after the authorization checkbox is accepted.</p>
          <%= form.submit "Start translation", disabled: @available_models.empty? && @workflow_profiles.empty?, class: "mt-4 w-full rounded-xl bg-blue-700 px-5 py-3 font-semibold text-white shadow-sm transition hover:bg-blue-800 disabled:cursor-not-allowed disabled:bg-slate-400", data: { workflow_mode_target: "submit", turbo_submits_with: "Starting translation…" } %>
          <p class="mt-2 text-center text-xs text-slate-500">The human final-editor checkpoint always remains.</p>
        </div>
      </aside>
    </div>
  <% end %>
</div>
