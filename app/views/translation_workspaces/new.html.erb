<% content_for :title, t("workspace_ui.title") %>
<%# A cached snapshot would carry the draft identity from before its last save; always render the current draft. %>
<% turbo_exempts_page_from_cache %>

<div class="mx-auto w-full max-w-[94rem]" data-controller="workspace-guard" data-workspace-guard-replay-lease-value="<%= ReplayIdentity.lease %>" data-workspace-guard-save-url-value="<%= translation_workspace_draft_path %>" data-workspace-guard-reset-url-value="<%= new_translation_workspace_path(project_id: @translation_workspace.project_id.presence) %>" data-workspace-guard-draft-id-value="<%= @draft_id || @draft&.public_id %>" data-workspace-guard-version-value="<%= @draft_version || @draft&.lock_version || 0 %>" data-workspace-guard-needs-save-value="<%= @draft_needs_save || @draft_configuration_notice.present? || @draft_import_notice.present? || (@draft.present? && !@draft_restored && !@draft_unreadable) %>" data-workspace-guard-scalar-fields-value="<%= TranslationWorkspaceDraft::SCALAR_FIELDS.to_json %>" data-workspace-guard-array-fields-value="<%= TranslationWorkspaceDraft::ARRAY_FIELDS.to_json %>" data-workspace-guard-messages-value="<%= { saving: t("workspace.saving"), saved: t("workspace.saved"), saveConflict: t("workspace.save_conflict"), saveFailed: t("workspace.save_failed"), discardConfirm: t("workspace.discard_confirm"), discardConflict: t("workspace.discard_conflict"), discardFailed: t("workspace.discard_failed") }.to_json %>" data-action="input->workspace-guard#changed change->workspace-guard#changed workspace-models:changed->workspace-guard#changed terminology-sheet:changed->workspace-guard#changed turbo:submit-start->workspace-guard#submitStart turbo:submit-end->workspace-guard#submitEnd locale-select:before-switch@document->workspace-guard#persistBeforeLocaleSwitch">
  <header class="mb-6 flex flex-col gap-3 border-b border-slate-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-blue-700"><%= t("workspace_ui.translation_label") %></p>
      <h1 class="mt-1.5 text-3xl font-bold tracking-tight text-slate-950"><%= @translation_workspace.existing_project? ? t("workspace_ui.add_translation") : t("workspace_ui.new_translation") %></h1>
      <p class="mt-1.5 max-w-2xl text-sm leading-6 text-slate-600"><%= t("workspace_ui.intro") %></p>
      <% if @translation_workspace.existing_project? %><p class="mt-1 text-xs text-slate-500"><%= t("workspace_ui.adding_to") %> <span class="font-semibold text-slate-700"><%= @translation_workspace.project.name %></span>.</p><% end %>
    </div>
  </header>

  <% if @repeated_from_experiment %>
    <section class="mb-5 rounded-xl border border-blue-200 bg-blue-50/70 px-4 py-3 text-sm text-blue-950"><p class="font-semibold"><%= t("workspace_ui.repeat_heading") %></p><p class="mt-1"><%= t("workspace_ui.repeat_note") %></p></section>
  <% end %>
  <% if @draft_configuration_notice %><p class="mb-3 text-sm text-amber-800" role="status"><%= @draft_configuration_notice %></p><% end %>
  <% if @draft_import_notice %><p class="mb-3 text-sm text-amber-800" role="status"><%= @draft_import_notice %></p><% end %>
  <% if @draft_unreadable %><p class="mb-3 text-sm text-amber-800" role="status"><%= t("workspace_ui.draft_unreadable") %></p><% end %>
  <% if @repeat_configuration_notice %><p class="mb-5 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900" role="status"><%= @repeat_configuration_notice %></p><% end %>

  <% unless current_user.managed_ai_access? %>
    <p class="mb-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950" role="status"><%= t("managed_ai.unavailable") %></p>
  <% end %>

  <%= form_with model: @translation_workspace, url: translation_workspace_path, id: "workspace-form", data: { workspace_guard_target: "form", workspace_summary_panel_url_value: workspace_terminology_panel_path, workspace_summary_messages_value: t("workspace_ui.summary").to_json, controller: "workflow-mode workspace-summary", action: "submit->workspace-guard#beforeSubmit input->workspace-summary#update change->workspace-summary#changed combobox:change->workspace-summary#update workspace-source:changed->workspace-summary#update workspace-models:changed->workspace-summary#update turbo:frame-load->workspace-summary#update" } do |form| %>
    <%= hidden_field_tag :translation_workspace_draft_id, @draft_id || @draft&.public_id %>
    <%= hidden_field_tag :translation_workspace_draft_version, @draft_version || @draft&.lock_version %>
    <%= form.hidden_field :submission_token %>
    <% if @translation_workspace.existing_project? %><%= form.hidden_field :project_id %><% end %>
    <%= form.hidden_field :source_import_id, value: @translation_workspace.source_import_id %>
    <%= form.hidden_field :source_import_project_token %>
    <%= form.hidden_field :automatic_plan_digest %>

    <% if @translation_workspace.errors.any? %>
      <section class="mb-5 rounded-xl border border-red-200 bg-red-50 p-4" aria-labelledby="form-errors-heading" role="alert">
        <h2 id="form-errors-heading" class="text-sm font-semibold text-red-900"><%= t("workspace_ui.fix_errors") %></h2>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-800"><% @translation_workspace.errors.each do |error| %><li><%= link_to error.full_message, "##{workspace_error_anchor(error.attribute)}", class: "underline decoration-red-300 underline-offset-2" %></li><% end %></ul>
      </section>
    <% end %>

    <div id="workspace-layout" class="grid grid-cols-1 items-start gap-6 xl:grid-cols-2">
      <div class="min-w-0 overflow-visible rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
        <section id="workspace-project" class="p-5 sm:p-6 lg:p-7">
          <% if @translation_workspace.existing_project? %>
            <div id="workspace-source-languages" class="mt-4 flex flex-wrap items-center gap-3 rounded-xl bg-slate-50 px-4 py-3 text-sm"><span class="font-semibold text-slate-900"><%= @translation_workspace.project.source_language %></span><span class="text-slate-400" aria-hidden="true">→</span><span class="font-semibold text-slate-900"><%= @translation_workspace.project.target_language %></span><span class="text-xs text-slate-500"><%= t("workspace_ui.fixed_languages") %></span></div>
          <% else %>
            <div id="workspace-source-languages" data-controller="language-swap" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:items-end">
              <%= render "shared/language_combobox", form: form, method: :source_language, label: t("language.source"), value: @translation_workspace.source_language, hint: t("workspace_ui.source_hint") %>
              <button type="button" data-action="language-swap#swap" aria-label="<%= t("workspace_ui.swap") %>" class="mx-auto flex size-9 items-center justify-center rounded-lg border border-slate-200 text-base text-slate-600 hover:bg-slate-100 focus-visible:ring-2 focus-visible:ring-blue-600">⇄</button>
              <%= render "shared/language_combobox", form: form, method: :target_language, label: t("language.target"), value: @translation_workspace.target_language, hint: t("workspace_ui.target_hint") %>
              <div class="sm:col-span-3">
                <div class="flex items-center gap-1.5"><%= form.label :project_name, t("workspace_ui.project_name"), class: "block text-sm font-medium text-slate-700" %><%= render "shared/hint", text: t("workspace_ui.project_hint"), label: t("workspace_ui.project_name") %></div>
                <%= form.text_field :project_name, required: true, maxlength: 150, placeholder: t("workspace_ui.project_placeholder"), class: "mt-1.5 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
              </div>
            </div>
          <% end %>

          <section id="workspace-source" class="mt-6 border-t border-slate-100 pt-5" data-controller="source-mode workspace-upload" data-workspace-upload-replay-lease-value="<%= ReplayIdentity.lease %>" data-workspace-upload-project-id-value="<%= @translation_workspace.project_id %>" data-workspace-upload-create-url-value="<%= source_imports_path(format: :json) %>" data-workspace-upload-messages-value="<%= { chooseFile: t("upload.choose_file"), extracting: t("upload.extracting"), importFailed: t("upload.import_failed"), reviewedSource: t("upload.reviewed_source"), imported: t("upload.imported"), sourceText: t("upload.source_text"), removed: t("upload.removed"), removeFailed: t("upload.remove_failed") }.to_json %>">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-1.5"><h2 class="text-sm font-semibold text-slate-900"><%= t("workspace_ui.source_document") %></h2><%= render "shared/hint", text: t("workspace_ui.source_document_hint"), label: t("workspace_ui.source_document") %></div>
              <div class="inline-flex rounded-xl bg-slate-100 p-1" role="tablist" aria-label="<%= t("workspace_ui.source_input_method") %>">
                <button type="button" role="tab" aria-selected="true" aria-controls="source-paste-panel" data-source-mode-target="pasteTab" data-action="source-mode#showPaste" class="rounded-lg px-4 py-1.5 text-sm font-semibold text-slate-600 aria-selected:bg-white aria-selected:text-slate-950 aria-selected:shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"><%= t("workspace_ui.paste_text") %></button>
                <button type="button" role="tab" aria-selected="false" aria-controls="source-upload-panel" data-source-mode-target="uploadTab" data-action="source-mode#showUpload" class="rounded-lg px-4 py-1.5 text-sm font-semibold text-slate-600 aria-selected:bg-white aria-selected:text-slate-950 aria-selected:shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"><%= t("workspace_ui.upload_file") %></button>
              </div>
            </div>

            <div id="source-paste-panel" data-source-mode-target="paste" class="mt-4 space-y-4">
              <div><div class="flex items-center gap-1.5"><%= form.label :document_title, t("workspace_ui.document_title"), class: "block text-sm font-medium text-slate-700" %><%= render "shared/hint", text: t("workspace_ui.document_hint"), label: t("workspace_ui.document_title") %></div><%= form.text_field :document_title, required: true, maxlength: 255, placeholder: t("workspace_ui.document_placeholder"), class: "mt-1.5 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %></div>
              <div><%= form.label :source_text, (@translation_workspace.source_import ? t("workspace_ui.reviewed_source") : t("workspace_ui.source_text")), class: "block text-sm font-medium text-slate-700" %><%= form.text_area :source_text, required: true, maxlength: Ai::UsageLimits::MAX_SOURCE_CHARACTERS, rows: 10, placeholder: t("workspace_ui.source_placeholder"), class: "mt-1.5 block w-full resize-y rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm leading-6 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %></div>
            </div>

            <div id="source-upload-panel" data-source-mode-target="upload" class="mt-4 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-5" hidden>
              <label for="workspace-upload-file" class="block text-sm font-semibold text-slate-900"><%= t("workspace_ui.source_file") %></label>
              <p class="mt-1 text-xs text-slate-500"><%= t("workspace_ui.file_limits", maximum: SourceImports::Limits::MAX_UPLOAD_BYTES / 1.megabyte) %></p>
              <input id="workspace-upload-file" type="file" accept=".txt,.md,.docx,.pdf,application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document" data-workspace-upload-target="file" class="mt-3 block w-full text-sm text-slate-700">
              <button type="button" data-action="workspace-upload#upload" data-workspace-upload-target="button" class="mt-3 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100"><%= t("workspace_ui.upload_review") %></button>
              <p data-workspace-upload-target="message" role="status" aria-live="polite" class="mt-2 text-sm text-slate-600"></p>
            </div>

            <div id="workspace-source-import" data-workspace-upload-target="import" class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 p-4 <%= 'hidden' unless @translation_workspace.source_import %>">
              <p class="text-sm font-semibold text-emerald-950" data-workspace-upload-target="filename"><%= @translation_workspace.source_import&.original_filename %></p>
              <p data-workspace-upload-target="metadata" class="mt-1 text-xs text-emerald-800"><%= @translation_workspace.source_import&.imported_format&.upcase %></p>
              <p class="mt-1 text-xs text-emerald-800"><%= t("workspace_ui.review_import") %></p>
              <button type="button" data-action="workspace-upload#remove" class="mt-2 text-xs font-semibold text-slate-700 hover:underline"><%= t("workspace_ui.remove_import") %></button>
            </div>
          </section>
        </section>

        <section id="workspace-experiment" class="border-t border-slate-200 p-5 sm:p-6 lg:p-7">
          <h2 class="text-lg font-semibold text-slate-950"><%= t("workspace_ui.your_instructions") %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= t("workspace_ui.instructions_intro") %></p>
          <div class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)]">
            <div><div class="flex items-center gap-1.5"><%= form.label :experiment_name, t("workspace_ui.experiment_name"), class: "block text-sm font-medium text-slate-700" %><%= render "shared/hint", text: t("workspace_ui.experiment_hint"), label: t("workspace_ui.experiment_name") %></div><%= form.text_field :experiment_name, maxlength: 150, class: "mt-1.5 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %></div>
            <div><div class="flex items-center gap-1.5"><%= form.label :instruction_prompt, t("workspace_ui.instruction_prompt"), class: "block text-sm font-medium text-slate-700" %><%= render "shared/hint", text: t("workspace_ui.instruction_hint"), label: t("workspace_ui.instruction_prompt") %></div><%= form.text_area :instruction_prompt, required: true, maxlength: Ai::UsageLimits::MAX_INSTRUCTION_CHARACTERS, rows: 3, placeholder: t("workspace_ui.instruction_placeholder"), class: "mt-1.5 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %></div>
          </div>
        </section>

        <section class="border-t border-slate-200 p-5 sm:p-6 lg:p-7">
          <div class="flex items-start justify-between gap-4"><div><h2 class="text-lg font-semibold text-slate-950"><%= t("workspace_ui.guidance") %></h2><p class="mt-1 text-sm text-slate-500"><%= t("workspace_ui.guidance_intro") %></p></div><span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-slate-500"><%= t("workspace_ui.optional") %></span></div>
          <fieldset id="workspace-glossary" class="mt-5 min-w-0">
            <legend class="flex items-center gap-1.5 text-sm font-semibold text-slate-900"><%= t("workspace_ui.terminology") %> <%= render "shared/hint", text: t("workspace_ui.terminology_hint"), label: t("workspace_ui.terminology") %></legend>
            <div class="mt-3"><%= render "workspace_terminology/panel", glossaries: @glossaries, selected_revision_id: @translation_workspace.glossary_revision_id, pagination: @glossaries_pagination %></div>
          </fieldset>

          <details class="mt-5 border-t border-slate-100 pt-4">
            <summary class="cursor-pointer text-sm font-semibold text-slate-800"><%= t("workspace_ui.advanced") %></summary>
            <div class="mt-5 grid gap-7 lg:grid-cols-2">
              <fieldset id="workspace-references">
                <legend class="flex items-center gap-1.5 text-sm font-semibold text-slate-900"><%= t("workspace_ui.references") %> <%= render "shared/hint", text: t("workspace_ui.references_hint"), label: t("workspace_ui.references") %></legend>
                <p class="mt-1 text-xs text-slate-500"><%= t("workspace_ui.references_limit") %></p>
                <div class="mt-3 space-y-2"><% @translation_references.each do |reference| %><% revision = reference.current_revision %><label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-3 hover:border-blue-300 hover:bg-blue-50/40"><%= check_box_tag "translation_workspace[translation_reference_revision_ids][]", revision.id, @translation_workspace.translation_reference_revision_ids.map(&:to_s).include?(revision.id.to_s), id: "translation_workspace_translation_reference_revision_ids_#{revision.id}", class: "mt-1 size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %><span><span class="block text-sm font-medium"><%= revision.title %> · <%= t("glossaries_ui.revision_inline", version: revision.version) %></span><span class="mt-0.5 block text-xs text-slate-500"><%= revision.source_language %> → <%= revision.target_language %></span></span></label><% end %></div>
                <%= render "translation_workspaces/configuration_pagination", pagination: @translation_references_pagination, label: t("workspace_ui.translation_references"), page_param: :translation_reference_page %>
                <% selected_count = @translation_workspace.translation_reference_revision_ids.count(&:present?) %><p class="mt-2 text-xs font-semibold text-slate-600"><%= t("workspace_ui.references_selected", count: selected_count) %></p>
                <% if @translation_references.empty? %><p class="mt-2 text-xs text-slate-500"><%= link_to t("references_ui.create"), new_translation_reference_path, class: "font-semibold text-blue-700" %> <%= t("workspace_ui.references_empty_suffix") %></p><% end %>
              </fieldset>

              <div class="space-y-6">
                <fieldset id="workspace-methodology">
                  <legend class="flex items-center gap-1.5 text-sm font-semibold text-slate-900"><%= t("workspace_ui.methodology") %> <%= render "shared/hint", text: t("workspace_ui.methodology_hint"), label: t("workspace_ui.methodology") %></legend>
                  <div class="mt-3 space-y-2"><label class="block rounded-xl border border-slate-200 p-3"><span class="flex items-start gap-3"><%= form.radio_button :methodology_profile_revision_id, "", checked: @translation_workspace.methodology_profile_revision_id.blank?, class: "mt-1 size-4" %><span><span class="text-sm font-semibold"><%= t("workspace_ui.no_methodology") %></span><span class="mt-0.5 block text-xs text-slate-500"><%= t("workspace_ui.no_methodology_hint") %></span></span></span></label><% @methodology_profiles.each do |profile| %><% revision = profile.current_revision %><label class="block rounded-xl border border-slate-200 p-3"><span class="flex items-start gap-3"><%= form.radio_button :methodology_profile_revision_id, revision.id, checked: @translation_workspace.methodology_profile_revision_id.to_s == revision.id.to_s, class: "mt-1 size-4" %><span><span class="block text-sm font-semibold"><%= revision.name %> · <%= t("glossaries_ui.revision_inline", version: revision.version) %></span><span class="mt-0.5 block text-xs text-slate-500"><%= revision.source_language %> → <%= revision.target_language %></span></span></span></label><% end %></div>
                  <%= render "translation_workspaces/configuration_pagination", pagination: @methodology_profiles_pagination, label: t("workspace_ui.methodology_profiles"), page_param: :methodology_profile_page %>
                </fieldset>
                <fieldset id="workspace-guidance"><legend class="flex items-center gap-1.5 text-sm font-semibold text-slate-900"><%= t("workspace_ui.guidance_priority") %> <%= render "shared/hint", text: t("workspace_ui.guidance_priority_hint"), label: t("workspace_ui.guidance_priority") %></legend><div class="mt-3 space-y-2"><% TranslationGuidance::Policy::LABELS.each do |value, _label| %><label class="flex items-center gap-3 rounded-xl border border-slate-200 p-3"><%= form.radio_button :guidance_preference, value, checked: @translation_workspace.guidance_preference == value, class: "size-4" %><span class="text-sm font-semibold"><%= localized_guidance_label(value) %></span></label><% end %></div></fieldset>
              </div>
            </div>
          </details>
        </section>
      </div>

      <aside class="min-w-0 space-y-5 xl:sticky xl:top-6 xl:self-start">
        <%= render "translation_workspaces/ai_workflow", form: form %>
      </aside>
    </div>
    <section id="workspace-launch" aria-label="<%= t("workspace_ui.review_start") %>" class="flex items-center gap-4">
      <div class="min-w-0 flex-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("workspace_ui.review_start") %></p>
        <p data-workspace-guard-target="status" class="mt-1 text-xs text-slate-500" role="status" aria-live="polite"><%= @draft_restored ? t("workspace.draft_restored") : "" %></p>
        <button type="button" data-action="workspace-guard#discard" class="mt-1 text-xs text-slate-500 underline hover:text-slate-800"><%= t("workspace.discard_draft") %></button>
        <p class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-600">
          <span data-workspace-summary-target="language"><%= [ @translation_workspace.source_language.presence || @translation_workspace.project&.source_language, @translation_workspace.target_language.presence || @translation_workspace.project&.target_language ].compact.join(" → ").presence || t("workspace_ui.languages_not_set") %></span>
          <span data-workspace-summary-target="source" class="min-w-0 max-w-full truncate"><%= @translation_workspace.source_import ? @translation_workspace.source_import.original_filename : t("workspace_ui.pasted_text") %></span>
          <span data-workspace-summary-target="models"><%= t("workspace_ui.summary.selected_count", count: @translation_workspace.model_identifier_selections.size) %></span>
          <span data-workspace-summary-target="terminology" class="min-w-0 max-w-full truncate"><%= @terminology_summary || t("workspace_ui.no_terminology") %></span>
          <span data-workspace-summary-target="workflow"><%= @translation_workspace.workflow_mode == "automatic" ? t("workspace_ui.automatic") : t("workspace_ui.manual") %></span>
        </p>
      </div>
      <%= form.submit t("workspace_ui.start"), disabled: !current_user.managed_ai_access?, class: "shrink-0 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:bg-slate-400", data: { workflow_mode_target: "submit", turbo_submits_with: t("workspace_ui.starting") } %>
    </section>
  <% end %>
  <dialog data-controller="terminology-sheet" data-action="click->terminology-sheet#closeFromButton" aria-label="<%= t("workspace_ui.terminology_editor") %>" class="ml-auto mr-0 h-full max-h-full w-[min(30rem,100vw)] max-w-full overflow-y-auto border-l border-slate-200 bg-white p-5 shadow-xl backdrop:bg-slate-950/35">
    <%= turbo_frame_tag "workspace-terminology-editor" %>
  </dialog>
  <dialog data-workspace-guard-target="dialog" aria-labelledby="workspace-leave-heading" class="w-[min(26rem,calc(100vw-2rem))] rounded-xl border border-slate-200 bg-white p-5 shadow-xl backdrop:bg-slate-950/35">
    <h2 id="workspace-leave-heading" class="text-lg font-semibold text-slate-950"><%= t("workspace_ui.leave_heading") %></h2>
    <p class="mt-2 text-sm text-slate-600"><%= t("workspace_ui.leave_warning") %></p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" data-action="workspace-guard#stay" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold"><%= t("workspace_ui.stay") %></button>
      <button type="button" data-action="workspace-guard#leave" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white"><%= t("workspace_ui.leave") %></button>
