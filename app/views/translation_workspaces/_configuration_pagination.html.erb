<% if pagination[:total_pages] > 1 %>
  <nav class="mt-4 flex flex-col items-center justify-between gap-3 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm sm:flex-row" aria-label="<%= label %> pagination">
    <div class="min-w-20">
      <% if pagination[:current_page] > 1 %>
        <%= button_tag "← Newer", type: "submit", name: page_param, value: pagination[:current_page] - 1, formmethod: "post", formaction: translation_workspace_options_path, formnovalidate: true, class: "font-semibold text-blue-700 hover:text-blue-900" %>
      <% end %>
    </div>
    <p class="text-center text-slate-600">Page <%= pagination[:current_page] %> of <%= pagination[:total_pages] %> · <%= pluralize(pagination[:total_count], label.downcase.singularize) %></p>
    <div class="min-w-20 text-right">
      <% if pagination[:current_page] < pagination[:total_pages] %>
        <%= button_tag "Older →", type: "submit", name: page_param, value: pagination[:current_page] + 1, formmethod: "post", formaction: translation_workspace_options_path, formnovalidate: true, class: "font-semibold text-blue-700 hover:text-blue-900" %>
      <% end %>
    </div>
  </nav>
<% end %>
