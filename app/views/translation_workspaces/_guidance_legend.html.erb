<%# One kind of translation guidance: its number in the reading order, its name,
    and one line on what it does (the fieldset's description, id: intro_id). %>
<legend class="flex items-center gap-2 text-sm font-semibold text-slate-900"><span aria-hidden="true" class="grid size-5 shrink-0 place-items-center rounded-full bg-blue-50 text-[11px] font-semibold tabular-nums text-blue-700 ring-1 ring-inset ring-blue-200"><%= number %></span><span class="min-w-0"><%= title %></span></legend>
<p id="<%= intro_id %>" class="mt-1 text-xs leading-5 text-slate-500"><%= intro %></p>
