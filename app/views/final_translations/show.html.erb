<% content_for :title, "Final translation workspace · Three Heavens" %>
<% if @final_translation.finalization_rounds.any?(&:running?) %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="5">
  <% end %>
<% end %>

<% experiment = @final_translation.experiment %>
<% project = experiment.document.project %>
<% current = @final_translation.current_version %>
<% winner = @final_translation.source_winner_translation_run %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Final translation workspace</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= experiment.name.presence || experiment.document.title %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= project.name %> · <%= project.source_language %> → <%= project.target_language %></p>
      <p class="mt-1 text-sm text-slate-600">Official seed winner: <span class="font-semibold text-slate-900"><%= winner.llm_model.display_name %></span> · current version <%= current.version_number %></p>
      <% if @final_translation.finalized_at %>
        <p class="mt-1 text-sm text-slate-600">Finalized <%= l @final_translation.finalized_at, format: :long %></p>
      <% end %>
    </div>
    <span class="inline-flex w-fit rounded-full px-3 py-1 text-sm font-semibold <%= @final_translation.finalized? ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>"><%= @final_translation.status.humanize %></span>
  </header>

  <% if @final_translation.finalization_rounds.any?(&:running?) %>
    <div class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800" role="status">
      Refinement proposals are still running. This page refreshes automatically every 5 seconds.
    </div>
  <% end %>

  <div class="flex flex-wrap gap-4 text-sm font-semibold">
    <%= link_to "Judge results", @final_translation.judge_round, class: "text-blue-700 hover:text-blue-900" %>
    <%= link_to "Blind review", @final_translation.judge_round.review_round, class: "text-blue-700 hover:text-blue-900" %>
    <%= link_to "Experiment", experiment, class: "text-blue-700 hover:text-blue-900" %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950">Source document</h2>
      <p class="mt-1 text-sm font-medium text-slate-600"><%= experiment.document.title %></p>
      <div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-800"><%= experiment.document.source_text %></div>
    </section>
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950">Translation instruction</h2>
      <div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-800"><%= experiment.instruction_prompt %></div>
    </section>
  </div>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-xl font-semibold text-slate-950">Current final draft</h2>
        <p class="mt-1 text-sm text-slate-600">Version <%= current.version_number %> · <%= current.origin.humanize %></p>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= link_to "Download TXT", download_final_translation_path(@final_translation, format: :txt), class: "inline-flex w-fit rounded-lg border border-blue-200 px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50" %>
        <%= link_to "Download DOCX", download_final_translation_path(@final_translation, format: :docx), class: "inline-flex w-fit rounded-lg border border-blue-200 px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50" %>
      </div>
    </div>

    <% if @final_translation.draft? %>
      <%= form_with url: save_revision_final_translation_path(@final_translation), method: :patch, scope: :final_translation, class: "mt-5 space-y-4" do |form| %>
        <%= form.hidden_field :expected_version_number, value: current.version_number %>
        <div>
          <%= form.label :content, "Translation", class: "block text-sm font-semibold text-slate-800" %>
          <%= form.text_area :content, value: (@submitted_content.nil? ? current.content : @submitted_content), rows: 18, maxlength: FinalTranslationVersion::MAX_CONTENT_LENGTH, required: true, class: "mt-2 block w-full rounded-lg border border-slate-300 px-4 py-3 font-serif text-base leading-7 text-slate-950 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>
        <div>
          <%= form.label :change_note, "Concise change note (optional)", class: "block text-sm font-semibold text-slate-800" %>
          <%= form.text_field :change_note, maxlength: FinalTranslationVersion::MAX_CHANGE_NOTE_LENGTH, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>
        <%= form.submit "Save revision", class: "rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white shadow-sm hover:bg-blue-800" %>
      <% end %>
    <% else %>
      <div class="mt-5 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-5 font-serif text-base leading-7 text-slate-950"><%= current.content %></div>
    <% end %>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-slate-950">Quality evidence for the official winner</h2>
    <div class="mt-5 whitespace-pre-wrap break-words rounded-lg border border-emerald-100 bg-emerald-50 p-4 text-sm leading-6 text-slate-900"><%= winner.translated_text %></div>

    <div class="mt-6 grid gap-5 lg:grid-cols-2">
      <div>
        <h3 class="font-semibold text-slate-900">Blind-review feedback</h3>
        <div class="mt-3 space-y-3">
          <% @winner_review_evaluations.each_with_index do |evaluation, index| %>
            <article class="rounded-lg border border-slate-200 p-4 text-sm">
              <p class="font-semibold text-slate-800">Review <%= index + 1 %> · <%= evaluation.overall_score %>/10</p>
              <p class="mt-2 whitespace-pre-wrap break-words"><span class="font-medium">Strengths:</span> <%= evaluation.strengths %></p>
              <p class="mt-2 whitespace-pre-wrap break-words"><span class="font-medium">Issues:</span> <%= evaluation.issues %></p>
              <p class="mt-2 whitespace-pre-wrap break-words"><span class="font-medium">Corrections:</span> <%= evaluation.recommended_corrections %></p>
              <% if evaluation.suggested_translation.present? %><p class="mt-2 whitespace-pre-wrap break-words"><span class="font-medium">Suggestion:</span> <%= evaluation.suggested_translation %></p><% end %>
            </article>
          <% end %>
        </div>
      </div>
      <div>
        <h3 class="font-semibold text-slate-900">Judge feedback</h3>
        <div class="mt-3 space-y-3">
          <% @winner_judge_evaluations.each_with_index do |evaluation, index| %>
            <article class="rounded-lg border border-slate-200 p-4 text-sm">
              <p class="font-semibold text-slate-800">Judgment <%= index + 1 %> · rank <%= evaluation.rank %> · <%= evaluation.overall_score %>/100</p>
              <p class="mt-2 whitespace-pre-wrap break-words"><span class="font-medium">Rationale:</span> <%= evaluation.rationale %></p>
              <p class="mt-2 whitespace-pre-wrap break-words"><span class="font-medium">Strengths:</span> <%= evaluation.strengths %></p>
              <p class="mt-2 whitespace-pre-wrap break-words"><span class="font-medium">Risks:</span> <%= evaluation.risks %></p>
            </article>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-slate-950">Revision history</h2>
    <p class="mt-2 text-sm text-slate-600">Historical versions are immutable. Restoring one creates a new revision.</p>
    <div class="mt-5 space-y-4">
      <% @final_translation.versions.each do |version| %>
        <article class="rounded-lg border <%= version.id == current.id ? 'border-blue-300 bg-blue-50/40' : 'border-slate-200' %> p-4">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="font-semibold text-slate-950">Version <%= version.version_number %> · <%= version.origin.humanize %></h3>
              <p class="mt-1 text-xs text-slate-500"><%= l version.created_at, format: :long %><% if version.change_note.present? %> · <%= version.change_note %><% end %></p>
              <% if version.source_finalization_run %>
                <p class="mt-1 text-xs text-slate-600">AI source: <%= version.source_finalization_run.finalizer_llm_model.display_name %> · <%= version.source_finalization_run.finalizer_llm_model.model_identifier %></p>
              <% end %>
            </div>
            <% if @final_translation.draft? && version.id != current.id %>
              <%= button_to "Restore as new version", restore_revision_final_translation_path(@final_translation), method: :post, params: { restore: { version_id: version.id, expected_version_number: current.version_number } }, class: "rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
            <% end %>
          </div>
          <details class="mt-3 rounded-lg bg-slate-50 p-3">
            <summary class="cursor-pointer text-sm font-semibold text-slate-800">View content</summary>
            <div class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-slate-900"><%= version.content %></div>
          </details>
        </article>
      <% end %>
    </div>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-slate-950">AI refinement proposals</h2>
    <p class="mt-2 text-sm text-slate-600">Select up to <%= Ai::UsageLimits::MAX_FINALIZERS %> models. Each proposes against the exact current version, and proposals never alter your draft until you explicitly apply one.</p>

    <% if @final_translation.draft? %>
      <%= form_with url: refine_final_translation_path(@final_translation), method: :post, scope: :refinement, class: "mt-5 space-y-4" do |form| %>
        <% if @finalizer_models.any? %>
          <fieldset>
            <legend class="text-sm font-semibold text-slate-800">Active OpenRouter finalizers</legend>
            <div class="mt-3 grid gap-3 md:grid-cols-2">
              <% @finalizer_models.each do |model| %>
                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/40">
                  <%= check_box_tag "refinement[finalizer_ids][]", model.id, false, id: "refinement_finalizer_ids_#{model.id}", class: "mt-1 size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
                  <span><span class="block font-medium text-slate-900"><%= model.display_name %></span><span class="mt-1 block text-xs text-slate-500"><%= model.provider %> · <%= model.model_identifier %></span></span>
                </label>
              <% end %>
            </div>
          </fieldset>
        <% else %>
          <p class="rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800">No active OpenRouter finalizer models are available.</p>
        <% end %>
        <%= form.submit "Start refinement", disabled: @finalizer_models.empty? || @final_translation.finalization_rounds.any?(&:running?), class: "rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white shadow-sm hover:bg-blue-800 disabled:cursor-not-allowed disabled:bg-slate-400" %>
      <% end %>
    <% end %>

    <div class="mt-7 space-y-6">
      <% @final_translation.finalization_rounds.sort_by { |round| [round.created_at, round.id] }.reverse_each do |round| %>
        <article class="rounded-lg border border-slate-200 p-5">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <h3 class="font-semibold text-slate-950">Refinement from version <%= round.base_version.version_number %></h3>
            <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(round.status) %>"><%= round.status.humanize %></span>
          </div>
          <% failed_runs = round.finalization_runs.select(&:failed?) %>
          <% retry_valid = @final_translation.draft? && current.id == round.base_final_translation_version_id && failed_runs.all? { |run| run.finalizer_llm_model.active? && run.finalizer_llm_model.gateway == "openrouter" } %>
          <% if failed_runs.any? %>
            <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-slate-700">
              <p><%= pluralize(failed_runs.size, "failed refinement") %>. Completed proposals remain immutable. Retrying may make another provider request and incur additional cost.</p>
              <% if retry_valid %>
                <%= button_to "Retry failed refinements", retry_failed_final_translation_finalization_round_path(@final_translation, round), method: :post, class: "mt-3 rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white hover:bg-amber-800" %>
              <% elsif current.id != round.base_final_translation_version_id %>
                <p class="mt-2 font-semibold text-amber-900">This round targets an older draft version and cannot be retried.</p>
              <% else %>
                <p class="mt-2 font-semibold text-amber-900">Retry is unavailable because the draft is finalized or a historical model is inactive or unsupported.</p>
              <% end %>
            </div>
          <% end %>
          <div class="mt-4 space-y-4">
            <% round.finalization_runs.sort_by { |run| [run.finalizer_llm_model.display_name, run.id] }.each do |run| %>
              <section class="rounded-lg bg-slate-50 p-4">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                  <div><h4 class="font-semibold text-slate-900"><%= run.finalizer_llm_model.display_name %></h4><p class="mt-1 break-all font-mono text-xs text-slate-500"><%= run.finalizer_llm_model.model_identifier %></p></div>
                  <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(run.status) %>"><%= run.status.humanize %></span>
                </div>
                <% if run.completed? %>
                  <div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-white p-4 text-sm leading-6 text-slate-900"><%= run.proposed_translation %></div>
                  <% { "Change summary" => run.change_summary, "Terminology notes" => run.terminology_notes, "Warnings" => run.warnings }.each do |label, items| %>
                    <div class="mt-4"><h5 class="text-sm font-semibold text-slate-800"><%= label %></h5><ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-700"><% items.each do |item| %><li class="whitespace-pre-wrap break-words"><%= item %></li><% end %></ul></div>
                  <% end %>
                  <% applicable = @final_translation.draft? && current.id == round.base_final_translation_version_id && run.applied_versions.empty? %>
                  <% if applicable %>
                    <%= button_to "Apply proposal", apply_proposal_final_translation_path(@final_translation), method: :post, params: { proposal: { finalization_run_id: run.id } }, class: "mt-4 rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800" %>
                  <% elsif current.id != round.base_final_translation_version_id && run.applied_versions.empty? %>
                    <p class="mt-4 text-sm font-medium text-amber-700">This proposal is stale because the current draft has changed.</p>
                  <% end %>
                <% elsif run.failed? %>
                  <div class="mt-4 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800"><p class="font-semibold">Refinement failed<% if run.error_code.present? %> · <%= run.error_code %><% end %></p><% if run.error_message.present? %><p class="mt-1 break-words"><%= safe_provider_error(run.error_message) %></p><% end %></div>
                <% else %>
                  <p class="mt-4 text-sm text-slate-600"><%= run.running? ? "The model is preparing its proposal." : "This proposal is queued." %></p>
                <% end %>
                <% telemetry = { "Prompt tokens" => run.prompt_tokens, "Completion tokens" => run.completion_tokens, "Total tokens" => run.total_tokens, "Cost" => (number_to_currency(run.cost, unit: "$", precision: 10, strip_insignificant_zeros: true) unless run.cost.nil?) }.compact %>
                <% if telemetry.any? %><dl class="mt-4 grid gap-3 border-t border-slate-200 pt-3 text-xs sm:grid-cols-4"><% telemetry.each do |label, value| %><div><dt class="text-slate-500"><%= label %></dt><dd class="font-medium text-slate-900"><%= value %></dd></div><% end %></dl><% end %>
              </section>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </section>

  <section class="rounded-xl border <%= @final_translation.finalized? ? 'border-emerald-200 bg-emerald-50' : 'border-amber-200 bg-amber-50' %> p-6 shadow-sm">
    <% if @final_translation.draft? %>
      <h2 class="text-xl font-semibold text-slate-950">Finalize translation</h2>
      <p class="mt-2 text-sm text-slate-700">Finalizing locks editing, restoration, proposal application, and new refinement requests. You can explicitly reopen later without losing history.</p>
      <%= button_to "Finalize translation", finalize_final_translation_path(@final_translation), method: :patch, class: "mt-4 rounded-lg bg-amber-700 px-5 py-3 font-semibold text-white hover:bg-amber-800" %>
    <% else %>
      <h2 class="text-xl font-semibold text-slate-950">Translation finalized</h2>
      <p class="mt-2 text-sm text-slate-700">Reopen only when further editing or refinement is required. Every revision and proposal remains preserved.</p>
      <%= button_to "Reopen for editing", reopen_final_translation_path(@final_translation), method: :patch, class: "mt-4 rounded-lg bg-emerald-700 px-5 py-3 font-semibold text-white hover:bg-emerald-800" %>
    <% end %>
  </section>
</div>
