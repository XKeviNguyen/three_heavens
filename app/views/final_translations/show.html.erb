<% content_for :title, t("final_ui.title") %>

<% experiment = @final_translation.experiment %>
<% project = experiment.document.project %>
<% current = @final_translation.current_version %>
<% winner = @final_translation.source_winner_translation_run %>
<% glossary = experiment.glossary_revision %>
<% methodology = experiment.methodology_profile_revision %>
<% reference_snapshots = experiment.experiment_reference_revisions %>
<% running_refinement = @has_running_refinement %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <%= link_to t("final_ui.return_project", name: project.name), project_path(project), class: "text-sm font-semibold text-blue-700 hover:text-blue-900" %>
      <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("final_ui.heading") %></p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= experiment.name.presence || experiment.document.title %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= project.source_language %> → <%= project.target_language %> · <%= t("final_ui.seed_winner") %> <span class="font-semibold text-slate-900"><%= winner.llm_model.display_name %></span></p>
    </div>
    <div class="text-right">
      <span class="inline-flex rounded-full px-3 py-1 text-sm font-semibold <%= @final_translation.finalized? ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>"><%= localized_status(@final_translation.status) %></span>
      <% if @final_translation.finalized_at %>
        <p class="mt-2 text-xs text-slate-500"><%= t("final_ui.finalized_at", at: l(@final_translation.finalized_at, format: :long)) %></p>
      <% end %>
    </div>
  </header>

  <%= render "shared/workflow_progress", experiment: experiment %>

  <% if running_refinement %>
    <div class="flex flex-col gap-3 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-900 sm:flex-row sm:items-center sm:justify-between" role="status">
      <p><strong><%= t("final_ui.refinement_running") %></strong> <%= t("final_ui.no_auto_reload") %></p>
      <%= link_to t("final_ui.refresh"), final_translation_path(@final_translation), data: { turbo_confirm: t("final_ui.refresh_confirm") }, class: "shrink-0 font-semibold text-blue-700 underline decoration-blue-300 underline-offset-2 hover:text-blue-900" %>
    </div>
  <% end %>

  <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold" aria-label="<%= t("final_ui.related_pages") %>">
    <%= link_to t("projects_ui.experiment"), experiment, class: "text-blue-700 hover:text-blue-900" %>
    <%= link_to t("projects_ui.blind_review"), @final_translation.judge_round.review_round, class: "text-blue-700 hover:text-blue-900" %>
    <%= link_to t("projects_ui.judge_results"), @final_translation.judge_round, class: "text-blue-700 hover:text-blue-900" %>
  </nav>

  <div class="grid items-start gap-6 lg:grid-cols-2">
    <aside class="space-y-4" aria-label="<%= t("final_ui.reference") %>">
      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-950"><%= t("final_ui.reference") %></h2>

        <details class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-4" open>
          <summary class="cursor-pointer font-semibold text-slate-900"><%= t("results_ui.source_document") %> · <%= experiment.document.title %></summary>
          <div class="mt-3 max-h-96 overflow-y-auto whitespace-pre-wrap break-words text-sm leading-6 text-slate-800"><%= experiment.document.source_text %></div>
        </details>

        <details class="mt-3 rounded-lg border border-slate-200 bg-slate-50 p-4" open>
          <summary class="cursor-pointer font-semibold text-slate-900"><%= t("results_ui.translation_instruction") %></summary>
          <div class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-slate-800"><%= experiment.instruction_prompt %></div>
        </details>

        <% if glossary %>
          <details class="mt-3 rounded-lg border border-slate-200 bg-slate-50 p-4" open>
            <summary class="cursor-pointer font-semibold text-slate-900"><%= t("final_ui.glossary_snapshot") %> · <%= glossary.name %> · <%= t("glossaries_ui.revision_inline", version: glossary.version) %></summary>
            <% if glossary.description.present? %><p class="mt-2 text-sm text-slate-600"><%= glossary.description %></p><% end %>
            <dl class="mt-3 divide-y divide-slate-200 text-sm">
              <% glossary.entries.each do |entry| %>
                <div class="py-2">
                  <dt class="font-medium text-slate-900"><%= entry.source_term %> → <%= entry.preferred_target_term %></dt>
                  <% if entry.note.present? %><dd class="mt-1 text-slate-600"><%= entry.note %></dd><% end %>
                </div>
              <% end %>
            </dl>
          </details>
        <% end %>

        <% if methodology %>
          <details class="mt-3 rounded-lg border border-slate-200 bg-slate-50 p-4" open>
            <summary class="cursor-pointer font-semibold text-slate-900"><%= t("pipelines_ui.methodology_snapshot") %> · <%= methodology.name %> · <%= t("glossaries_ui.revision_inline", version: methodology.version) %></summary>
            <% if methodology.description.present? %><p class="mt-2 text-sm text-slate-600"><%= methodology.description %></p><% end %>
            <div class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-slate-800"><%= methodology.guidance %></div>
          </details>
        <% end %>

        <details class="mt-3 rounded-lg border border-slate-200 bg-slate-50 p-4" <%= "open" if reference_snapshots.any? %>>
          <summary class="cursor-pointer font-semibold text-slate-900"><%= t("final_ui.reference_examples", count: reference_snapshots.size) %></summary>
          <p class="mt-2 text-sm text-slate-600"><%= t("projects_ui.guidance_preference") %> <%= localized_guidance_label(experiment.guidance_preference) %></p>
          <% if reference_snapshots.any? %>
            <div class="mt-3 space-y-3">
              <% reference_snapshots.each do |snapshot| %>
                <% reference_revision = snapshot.translation_reference_revision %>
                <details class="rounded-lg border border-slate-200 bg-white p-3">
                  <summary class="cursor-pointer text-sm font-semibold"><%= reference_revision.title %> · <%= t("glossaries_ui.revision_inline", version: reference_revision.version) %></summary>
                  <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("references_ui.source_example") %></p>
                  <div class="mt-1 whitespace-pre-wrap break-words text-sm leading-6 text-slate-800"><%= reference_revision.source_text %></div>
                  <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("references_ui.approved_translation") %></p>
                  <div class="mt-1 whitespace-pre-wrap break-words text-sm leading-6 text-slate-800"><%= reference_revision.approved_translation %></div>
                </details>
              <% end %>
            </div>
          <% else %>
            <p class="mt-2 text-sm text-slate-600"><%= t("final_ui.no_references") %></p>
          <% end %>
        </details>
      </section>

      <details class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <summary class="cursor-pointer text-lg font-semibold text-slate-950"><%= t("final_ui.evidence") %></summary>
        <p class="mt-2 text-sm text-slate-600"><%= t("final_ui.evidence_intro") %></p>
        <details class="mt-4 rounded-lg bg-emerald-50 p-4">
          <summary class="cursor-pointer text-sm font-semibold text-emerald-900"><%= t("final_ui.original_winner") %></summary>
          <div class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-slate-900"><%= winner.translated_text %></div>
        </details>
        <div class="mt-4 space-y-3">
          <% @winner_review_evaluations.each_with_index do |evaluation, index| %>
            <details class="rounded-lg border border-slate-200 p-4 text-sm">
              <summary class="cursor-pointer font-semibold text-slate-800"><%= t("final_ui.review_score", number: index + 1, score: evaluation.overall_score) %></summary>
              <p class="mt-3 whitespace-pre-wrap break-words"><span class="font-medium"><%= t("results_ui.strengths") %>:</span> <%= evaluation.strengths %></p>
              <p class="mt-2 whitespace-pre-wrap break-words"><span class="font-medium"><%= t("results_ui.issues") %>:</span> <%= evaluation.issues %></p>
              <p class="mt-2 whitespace-pre-wrap break-words"><span class="font-medium"><%= t("results_ui.corrections") %>:</span> <%= evaluation.recommended_corrections %></p>
              <% if evaluation.suggested_translation.present? %><p class="mt-2 whitespace-pre-wrap break-words"><span class="font-medium"><%= t("results_ui.suggested_translation") %>:</span> <%= evaluation.suggested_translation %></p><% end %>
            </details>
          <% end %>
          <% @winner_judge_evaluations.each_with_index do |evaluation, index| %>
            <details class="rounded-lg border border-slate-200 p-4 text-sm">
              <summary class="cursor-pointer font-semibold text-slate-800"><%= t("final_ui.judge_score", number: index + 1, rank: evaluation.rank, score: evaluation.overall_score) %></summary>
              <p class="mt-3 whitespace-pre-wrap break-words"><span class="font-medium"><%= t("results_ui.rationale") %>:</span> <%= evaluation.rationale %></p>
              <p class="mt-2 whitespace-pre-wrap break-words"><span class="font-medium"><%= t("results_ui.strengths") %>:</span> <%= evaluation.strengths %></p>
              <p class="mt-2 whitespace-pre-wrap break-words"><span class="font-medium"><%= t("results_ui.risks") %>:</span> <%= evaluation.risks %></p>
            </details>
          <% end %>
        </div>
      </details>
    </aside>

    <section class="rounded-xl border border-blue-200 bg-white p-5 shadow-sm sm:p-6" aria-label="<%= t("final_ui.editor") %>">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= @final_translation.finalized? ? t("final_ui.approved") : t("final_ui.current_draft") %></p>
          <h2 class="mt-1 text-2xl font-semibold text-slate-950"><%= t("final_ui.version", number: current.version_number) %></h2>
          <p class="mt-1 text-sm text-slate-600"><%= t("final_ui.origin_label", origin: t("final_ui.origins.#{current.origin}")) %></p>
        </div>
        <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold <%= @final_translation.finalized? ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>"><%= @final_translation.finalized? ? t("final_ui.finalized_read_only") : t("final_ui.draft_editable") %></span>
      </div>

      <% if @stale_save_conflict %>
        <section class="mt-5 rounded-lg border border-amber-300 bg-amber-50 p-4" aria-label="<%= t("final_ui.persisted_for_reconciliation") %>">
          <h3 class="font-semibold text-amber-950"><%= t("final_ui.newer_version", number: current.version_number) %></h3>
          <p class="mt-1 text-sm text-amber-900"><%= t("final_ui.conflict_intro") %></p>
          <details class="mt-3 rounded-lg border border-amber-200 bg-white p-3" open>
            <summary class="cursor-pointer text-sm font-semibold text-slate-900"><%= t("final_ui.persisted_version", number: current.version_number) %></summary>
            <div class="mt-3 max-h-72 overflow-y-auto whitespace-pre-wrap break-words text-sm leading-6 text-slate-900"><%= current.content %></div>
          </details>
        </section>
      <% end %>

      <% if @final_translation.draft? %>
        <%= form_with url: save_revision_final_translation_path(@final_translation), method: :patch, scope: :final_translation, class: "mt-5 space-y-4" do |form| %>
          <%= form.hidden_field :expected_version_number, value: current.version_number %>
          <div>
            <%= form.label :content, @stale_save_conflict ? t("final_ui.submitted_draft") : t("final_ui.draft_label"), class: "block text-sm font-semibold text-slate-800" %>
            <%= form.text_area :content, value: (@submitted_content.nil? ? current.content : @submitted_content), rows: 24, maxlength: FinalTranslationVersion::MAX_CONTENT_LENGTH, required: true, aria: { describedby: "draft-editing-help" }, class: "mt-2 block w-full rounded-lg border border-slate-300 px-4 py-3 font-serif text-base leading-7 text-slate-950 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
            <p id="draft-editing-help" class="mt-2 text-xs leading-5 text-slate-500"><%= t("final_ui.save_help") %></p>
          </div>
          <div>
            <%= form.label :change_note, t("final_ui.change_note_optional"), class: "block text-sm font-semibold text-slate-800" %>
            <%= form.text_field :change_note, value: @submitted_change_note, maxlength: FinalTranslationVersion::MAX_CHANGE_NOTE_LENGTH, placeholder: t("final_ui.change_note_placeholder"), class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <%= form.submit t("final_ui.save_revision"), class: "rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white shadow-sm hover:bg-blue-800", data: { turbo_submits_with: t("glossaries_ui.saving") } %>
            <p class="text-xs text-slate-500"><%= t("final_ui.save_immutable") %></p>
          </div>
        <% end %>
      <% else %>
        <div class="mt-5 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-5 font-serif text-base leading-7 text-slate-950"><%= current.content %></div>
      <% end %>

      <div class="mt-5 flex flex-wrap gap-3 border-t border-slate-200 pt-5">
        <%= link_to t("final_ui.download_txt"), download_final_translation_path(@final_translation, format: :txt), class: "inline-flex rounded-lg border border-blue-200 px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50" %>
        <%= link_to t("final_ui.download_docx"), download_final_translation_path(@final_translation, format: :docx), class: "inline-flex rounded-lg border border-blue-200 px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-50" %>
      </div>
    </section>
  </div>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-slate-950"><%= t("final_ui.proposals") %></h2>
    <p class="mt-2 text-sm text-slate-600"><%= t("final_ui.proposals_intro") %></p>
    <% execution_plan = experiment.document_execution_plan %>
    <% if execution_plan %><p class="mt-2 text-sm font-semibold text-amber-800"><%= t("final_ui.segment_cost", count: execution_plan.segment_count) %></p><% end %>
    <% if execution_plan && !current.segment_alignment_valid? %><p class="mt-3 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900"><%= t("final_ui.alignment_unavailable") %></p><% end %>

    <% if @final_translation.draft? %>
      <%= form_with url: refine_final_translation_path(@final_translation), method: :post, scope: :refinement, class: "mt-5 space-y-4" do |form| %>
        <% if @finalizer_models.any? %>
          <fieldset>
            <legend class="text-sm font-semibold text-slate-800"><%= t("final_ui.active_finalizers", maximum: Ai::UsageLimits::MAX_FINALIZERS) %></legend>
            <div class="mt-3 grid gap-3 md:grid-cols-2">
              <% @finalizer_models.each do |model| %>
                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/40">
                  <%= check_box_tag "refinement[finalizer_ids][]", model.id, false, id: "refinement_finalizer_ids_#{model.id}", class: "mt-1 size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
                  <span><span class="block font-medium text-slate-900"><%= model.display_name %></span><span class="mt-1 block text-xs text-slate-500"><%= model.provider %> · <%= model.model_identifier %></span></span>
                </label>
              <% end %>
            </div>
          </fieldset>
        <% else %>
          <p class="rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800"><%= t("final_ui.no_finalizers") %></p>
        <% end %>
        <%= form.submit t("final_ui.start_refinement"), disabled: @finalizer_models.empty? || running_refinement || (execution_plan && !current.segment_alignment_valid?), class: "rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white shadow-sm hover:bg-blue-800 disabled:cursor-not-allowed disabled:bg-slate-400", data: { turbo_confirm: t("final_ui.start_refinement_confirm"), turbo_submits_with: t("final_ui.starting_refinement") } %>
      <% end %>
    <% end %>

    <% if @finalization_rounds.empty? %>
      <p class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600"><%= t("final_ui.no_proposals") %></p>
    <% end %>

    <div class="mt-7 space-y-6">
      <% @finalization_rounds.each do |round| %>
        <article class="rounded-lg border border-slate-200 p-5">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <h3 class="font-semibold text-slate-950"><%= t("final_ui.round", version: round.base_version.version_number) %></h3>
            <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(round.status) %>"><%= localized_status(round.status) %></span>
          </div>
          <% failed_runs = round.finalization_runs.select(&:failed?) %>
          <% retry_valid = @final_translation.draft? && current.id == round.base_final_translation_version_id && failed_runs.all? { |run| run.finalizer_llm_model.active? && run.finalizer_llm_model.gateway == "openrouter" } %>
          <% if failed_runs.any? %>
            <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-slate-700">
              <p><%= t("final_ui.retry_intro", count: failed_runs.size, attempts: Ai::ProviderRetryPolicy::MAX_ATTEMPTS_PER_AUTHORIZATION) %></p>
              <% if retry_valid %>
                <%= button_to t("final_ui.retry"), retry_failed_final_translation_finalization_round_path(@final_translation, round), method: :post, data: { turbo_confirm: t("final_ui.retry_confirm", attempts: Ai::ProviderRetryPolicy::MAX_ATTEMPTS_PER_AUTHORIZATION), turbo_submits_with: t("results_ui.queueing_retries") }, class: "mt-3 rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white hover:bg-amber-800" %>
              <% elsif current.id != round.base_final_translation_version_id %>
                <p class="mt-2 font-semibold text-amber-900"><%= t("final_ui.retry_old_version") %></p>
              <% else %>
                <p class="mt-2 font-semibold text-amber-900"><%= t("final_ui.retry_unavailable") %></p>
              <% end %>
            </div>
          <% end %>
          <div class="mt-4 space-y-4">
            <% round.finalization_runs.sort_by { |run| [run.finalizer_llm_model.display_name, run.id] }.each do |run| %>
              <% applied_versions = @applied_versions_by_run.fetch(run.id, []) %>
              <% applied = applied_versions.any? %>
              <% stale = !applied && current.id != round.base_final_translation_version_id %>
              <% applicable = run.completed? && !applied && !stale && @final_translation.draft? %>
              <section class="rounded-lg border <%= applicable ? 'border-emerald-200 bg-emerald-50/50' : 'border-slate-200 bg-slate-50' %> p-4">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <h4 class="font-semibold text-slate-900"><%= run.finalizer_llm_model.display_name %></h4>
                    <p class="mt-1 break-all font-mono text-xs text-slate-500"><%= run.finalizer_llm_model.model_identifier %></p>
                    <p class="mt-1 text-xs text-slate-600"><%= t("final_ui.exact_base") %>: <strong><%= round.base_version.version_number %></strong></p>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(run.status) %>"><%= localized_status(run.status) %></span>
                    <% if applied %><span class="inline-flex rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-800"><%= t("final_ui.already_applied") %></span><% end %>
                    <% if stale %><span class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800"><%= t("final_ui.stale_proposal") %></span><% end %>
                    <% if applicable %><span class="inline-flex rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800"><%= t("final_ui.applicable_proposal") %></span><% end %>
                  </div>
                </div>
                <% if run.finalization_segment_runs.any? %>
                  <% segment_counts = run.finalization_segment_runs.group_by(&:status).transform_values(&:size) %>
                  <p class="mt-3 text-sm text-blue-900"><%= t("final_ui.segmented_progress") %>: <strong><%= segment_counts.fetch("completed", 0) %> / <%= run.finalization_segment_runs.size %></strong> <%= localized_status(:completed) %><% if segment_counts.fetch("running", 0).positive? %> · <%= segment_counts.fetch("running") %> <%= localized_status(:running) %><% end %><% if segment_counts.fetch("failed", 0).positive? %> · <%= segment_counts.fetch("failed") %> <%= localized_status(:failed) %><% end %>.</p>
                <% end %>
                <% if run.completed? %>
                  <h5 class="mt-4 text-sm font-semibold text-slate-800"><%= t("final_ui.proposed_translation") %></h5>
                  <div class="mt-2 whitespace-pre-wrap break-words rounded-lg bg-white p-4 text-sm leading-6 text-slate-900"><%= run.proposed_translation %></div>
                  <% { t("final_ui.change_summary") => run.change_summary, t("final_ui.terminology_notes") => run.terminology_notes, t("final_ui.warnings") => run.warnings }.each do |label, items| %>
                    <div class="mt-4">
                      <h5 class="text-sm font-semibold text-slate-800"><%= label %></h5>
                      <% if items.any? %><ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-700"><% items.each do |item| %><li class="whitespace-pre-wrap break-words"><%= item %></li><% end %></ul><% else %><p class="mt-1 text-sm text-slate-500"><%= t("final_ui.none_reported") %></p><% end %>
                    </div>
                  <% end %>
                  <% if applicable %>
                    <%= button_to t("final_ui.apply_proposal"), apply_proposal_final_translation_path(@final_translation), method: :post, params: { proposal: { finalization_run_id: run.id } }, data: { turbo_confirm: t("final_ui.apply_confirm"), turbo_submits_with: t("final_ui.applying") }, class: "mt-4 rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800" %>
                  <% elsif applied %>
                    <p class="mt-4 text-sm font-medium text-blue-800"><%= t("final_ui.applied_as", versions: applied_versions.map { |version| t("final_ui.version_inline", number: version.version_number) }.to_sentence) %></p>
                  <% elsif stale %>
                    <p class="mt-4 text-sm font-medium text-amber-800"><%= t("final_ui.stale_help") %></p>
                  <% else %>
                    <p class="mt-4 text-sm font-medium text-slate-600"><%= t("final_ui.reopen_before_apply") %></p>
                  <% end %>
                <% elsif run.failed? %>
                  <div class="mt-4 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800"><p class="font-semibold"><%= t("final_ui.refinement_failed") %><% if run.error_code.present? %> · <%= safe_provider_error_code(run.error_code) %><% end %></p><% if run.error_message.present? %><p class="mt-1 break-words"><%= safe_provider_error(run.error_message) %></p><% end %></div>
                <% else %>
                  <p class="mt-4 text-sm text-slate-600"><%= run.running? ? t("final_ui.proposal_running") : t("final_ui.proposal_queued") %></p>
                <% end %>
                <% telemetry = { t("results_ui.telemetry.prompt_tokens") => run.prompt_tokens, t("results_ui.telemetry.completion_tokens") => run.completion_tokens, t("results_ui.telemetry.total_tokens") => run.total_tokens, t("results_ui.telemetry.cost") => (number_to_currency(run.cost, unit: "$", precision: 10, strip_insignificant_zeros: true) unless run.cost.nil?) }.compact %>
                <% if telemetry.any? %><dl class="mt-4 grid gap-3 border-t border-slate-200 pt-3 text-xs sm:grid-cols-4"><% telemetry.each do |label, value| %><div><dt class="text-slate-500"><%= label %></dt><dd class="font-medium text-slate-900"><%= value %></dd></div><% end %></dl><% end %>
              </section>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
    <div class="mt-5"><%= render "shared/pagination", pagination: @finalization_pagination, label: t("final_ui.rounds"), page_param: :refinement_page %></div>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-slate-950"><%= t("references_ui.history") %></h2>
    <p class="mt-2 text-sm text-slate-600"><%= t("final_ui.history_intro") %></p>
    <div class="mt-5 space-y-3">
      <% @versions.each do |version| %>
        <article class="rounded-lg border <%= version.id == current.id ? 'border-blue-300 bg-blue-50/40' : 'border-slate-200' %> p-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-semibold text-slate-950"><%= t("final_ui.version_origin", number: version.version_number, origin: t("final_ui.origins.#{version.origin}")) %></h3>
                <% if version.id == current.id %><span class="rounded-full bg-blue-100 px-2 py-1 text-xs font-semibold text-blue-800"><%= t("final_ui.current_version") %></span><% end %>
              </div>
              <p class="mt-1 text-xs text-slate-500"><%= l version.created_at, format: :long %></p>
              <p class="mt-1 text-sm text-slate-700"><span class="font-medium"><%= t("final_ui.change_note") %>:</span> <%= version.change_note.presence || t("final_ui.none") %></p>
              <% if version.source_finalization_run %><p class="mt-1 text-xs text-slate-600"><%= t("final_ui.ai_source") %>: <%= version.source_finalization_run.finalizer_llm_model.display_name %> · <%= version.source_finalization_run.finalizer_llm_model.model_identifier %></p><% end %>
            </div>
            <% if @final_translation.draft? && version.id != current.id %>
              <%= button_to t("final_ui.restore"), restore_revision_final_translation_path(@final_translation), method: :post, params: { restore: { version_id: version.id, expected_version_number: current.version_number } }, data: { turbo_confirm: t("final_ui.restore_confirm", number: version.version_number), turbo_submits_with: t("final_ui.restoring") }, class: "rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
            <% end %>
          </div>
          <details class="mt-3 rounded-lg bg-slate-50 p-3">
            <summary class="cursor-pointer text-sm font-semibold text-slate-800"><%= t("final_ui.view_history") %></summary>
            <div class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-slate-900"><%= version.content %></div>
          </details>
        </article>
      <% end %>
    </div>
    <div class="mt-5"><%= render "shared/pagination", pagination: @versions_pagination, label: t("final_ui.versions"), page_param: :version_page %></div>
  </section>

  <section class="rounded-xl border <%= @final_translation.finalized? ? 'border-emerald-200 bg-emerald-50' : 'border-amber-200 bg-amber-50' %> p-6 shadow-sm">
    <% if @final_translation.draft? %>
      <h2 class="text-xl font-semibold text-slate-950"><%= t("final_ui.approve_heading") %></h2>
      <p class="mt-2 text-sm text-slate-700"><%= t("final_ui.approve_intro") %></p>
      <%= button_to t("final_ui.finalize"), finalize_final_translation_path(@final_translation), method: :patch, data: { turbo_confirm: t("final_ui.finalize_confirm", number: current.version_number), turbo_submits_with: t("final_ui.finalizing") }, class: "mt-4 rounded-lg bg-amber-700 px-5 py-3 font-semibold text-white hover:bg-amber-800" %>
    <% else %>
      <h2 class="text-xl font-semibold text-slate-950"><%= t("final_ui.finalized_heading") %></h2>
      <p class="mt-2 text-sm text-slate-700"><%= t("final_ui.finalized_intro", number: current.version_number) %></p>
      <div class="mt-4 flex flex-wrap gap-3">
        <%= link_to t("final_ui.download_txt"), download_final_translation_path(@final_translation, format: :txt), class: "rounded-lg border border-emerald-300 bg-white px-4 py-2 font-semibold text-emerald-800 hover:bg-emerald-100" %>
        <%= link_to t("final_ui.download_docx"), download_final_translation_path(@final_translation, format: :docx), class: "rounded-lg border border-emerald-300 bg-white px-4 py-2 font-semibold text-emerald-800 hover:bg-emerald-100" %>
        <%= button_to t("final_ui.reopen"), reopen_final_translation_path(@final_translation), method: :patch, data: { turbo_confirm: t("final_ui.reopen_confirm"), turbo_submits_with: t("final_ui.reopening") }, class: "rounded-lg bg-emerald-700 px-5 py-2 font-semibold text-white hover:bg-emerald-800" %>
      </div>
    <% end %>
  </section>
</div>
