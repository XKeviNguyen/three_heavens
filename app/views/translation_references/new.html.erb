<% content_for :title, t("references_ui.new_title") %>
<div class="mx-auto max-w-4xl space-y-6">
  <header>
    <p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("references_ui.library") %></p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= t("references_ui.create_heading") %></h1>
