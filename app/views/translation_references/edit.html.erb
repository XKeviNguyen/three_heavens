<% content_for :title, "Edit translation reference · Three Heavens" %>
<div class="mx-auto max-w-4xl space-y-6">
  <header>
    <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Translation Reference Library</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Create a new reference revision</h1>
    <p class="mt-2 text-slate-600">Saving creates a new immutable revision. Clear a pasted-text field before uploading a replacement file for that side.</p>
  </header>
  <%= render "form", form_url: translation_reference_path(@translation_reference), form_method: :patch, submit_label: "Save new revision" %>
</div>
