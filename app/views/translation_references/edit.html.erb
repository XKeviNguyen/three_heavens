<% content_for :title, t("references_ui.edit_title") %>
<div class="mx-auto max-w-4xl space-y-6">
  <header>
    <p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("references_ui.library") %></p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= t("references_ui.edit_heading") %></h1>
    <p class="mt-2 text-slate-600"><%= t("references_ui.edit_intro") %></p>
  </header>
  <%= render "form", form_url: translation_reference_path(@translation_reference), form_method: :patch, submit_label: t("references_ui.save_revision") %>
</div>
