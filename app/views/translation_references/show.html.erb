<% revision = @translation_reference.current_revision %>
<% content_for :title, t("references_ui.show_title", title: revision.title) %>
<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div><p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("references_ui.singular") %></p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= revision.title %></h1><p class="mt-2 text-slate-600"><%= revision.source_language %> → <%= revision.target_language %> · <%= t("glossaries_ui.revision", version: revision.version) %></p><span class="mt-3 inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(@translation_reference.active? ? :active : :archived) %>"><%= @translation_reference.active? ? t("glossaries_ui.active_workspace") : t("glossaries_ui.archived_history") %></span></div>
    <div class="flex flex-wrap gap-3"><%= link_to t("glossaries_ui.create_revision"), edit_translation_reference_path(@translation_reference), class: "rounded-lg border border-blue-200 px-4 py-2 font-semibold text-blue-700" %><% if @translation_reference.active? %><%= button_to t("glossaries_ui.archive"), deactivate_translation_reference_path(@translation_reference), method: :patch, data: { turbo_confirm: t("references_ui.archive_confirm") }, class: "rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white" %><% else %><%= button_to t("glossaries_ui.activate"), activate_translation_reference_path(@translation_reference), method: :patch, class: "rounded-lg bg-emerald-700 px-4 py-2 font-semibold text-white" %><% end %></div>
  </header>
  <aside class="rounded-xl border border-blue-200 bg-blue-50 p-5 text-sm text-blue-950"><span class="font-semibold"><%= t("references_ui.using") %></span> <%= t("references_ui.using_intro") %> <%= link_to t("glossaries_ui.translation_workspace"), new_translation_workspace_path, class: "font-semibold underline" %>. <%= t("references_ui.using_preserved") %></aside>
  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold"><%= t("references_ui.exact_source") %></h2><div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 text-sm leading-6"><%= revision.source_text %></div></section>
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold"><%= t("references_ui.exact_translation") %></h2><div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 text-sm leading-6"><%= revision.approved_translation %></div></section>
  </div>
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold"><%= t("references_ui.history") %></h2><details class="mt-2 text-xs text-slate-500"><summary class="cursor-pointer font-semibold"><%= t("glossaries_ui.technical_identity") %></summary><p class="mt-2 break-all font-mono"><%= t("references_ui.current_digest") %> <%= revision.configuration_digest %></p></details><div class="mt-4 space-y-3"><% @revisions.each do |item| %><article class="rounded-lg border border-slate-200 p-4"><div class="flex flex-wrap justify-between gap-3"><p class="font-semibold"><%= t("glossaries_ui.revision", version: item.version) %><%= " · #{t("glossaries_ui.current")}" if item.id == revision.id %></p><p class="text-xs text-slate-500"><%= l item.created_at, format: :long %></p></div><p class="mt-1 text-sm text-slate-600"><%= item.title %> · <%= item.source_language %> → <%= item.target_language %> · <%= t("references_ui.used_by", count: item.experiments.size) %></p></article><% end %></div></section>
  <%= render "shared/pagination", pagination: @pagination, label: t("glossaries_ui.revisions") %>
  <%= link_to t("references_ui.all"), translation_references_path, class: "inline-flex text-sm font-semibold text-blue-700" %>
</div>
