<% revision = @translation_reference.current_revision %>
<% content_for :title, "#{revision.title} · Translation references · Three Heavens" %>
<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div><p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Translation Reference</p><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= revision.title %></h1><p class="mt-2 text-slate-600"><%= revision.source_language %> → <%= revision.target_language %> · revision <%= revision.version %></p><span class="mt-3 inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(@translation_reference.active? ? :active : :archived) %>"><%= @translation_reference.active? ? "Active · available in workspace" : "Archived · history only" %></span></div>
    <div class="flex flex-wrap gap-3"><%= link_to "Create revision", edit_translation_reference_path(@translation_reference), class: "rounded-lg border border-blue-200 px-4 py-2 font-semibold text-blue-700" %><% if @translation_reference.active? %><%= button_to "Archive", deactivate_translation_reference_path(@translation_reference), method: :patch, data: { turbo_confirm: "Archive this reference? Existing experiments keep their exact snapshot." }, class: "rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white" %><% else %><%= button_to "Activate", activate_translation_reference_path(@translation_reference), method: :patch, class: "rounded-lg bg-emerald-700 px-4 py-2 font-semibold text-white" %><% end %></div>
  </header>
  <aside class="rounded-xl border border-blue-200 bg-blue-50 p-5 text-sm text-blue-950"><span class="font-semibold">Using references:</span> choose up to five matching references in the <%= link_to "translation workspace", new_translation_workspace_path, class: "font-semibold underline" %>. Experiments preserve the exact selected revisions.</aside>
  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold">Exact source text</h2><div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 text-sm leading-6"><%= revision.source_text %></div></section>
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold">Exact approved translation</h2><div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 text-sm leading-6"><%= revision.approved_translation %></div></section>
  </div>
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold">Revision history</h2><details class="mt-2 text-xs text-slate-500"><summary class="cursor-pointer font-semibold">Technical revision identity</summary><p class="mt-2 break-all font-mono">Current SHA-256: <%= revision.configuration_digest %></p></details><div class="mt-4 space-y-3"><% @revisions.each do |item| %><article class="rounded-lg border border-slate-200 p-4"><div class="flex flex-wrap justify-between gap-3"><p class="font-semibold">Revision <%= item.version %><%= " · Current" if item.id == revision.id %></p><p class="text-xs text-slate-500"><%= l item.created_at, format: :long %></p></div><p class="mt-1 text-sm text-slate-600"><%= item.title %> · <%= item.source_language %> → <%= item.target_language %> · used by <%= pluralize(item.experiments.size, "experiment") %></p></article><% end %></div></section>
  <%= render "shared/pagination", pagination: @pagination, label: "Revisions" %>
  <%= link_to "← All references", translation_references_path, class: "inline-flex text-sm font-semibold text-blue-700" %>
</div>
