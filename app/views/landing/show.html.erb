<% content_for :title, t("landing.title") %>
<div class="min-h-screen bg-white">
  <header class="mx-auto flex w-full min-w-0 max-w-6xl flex-col items-stretch gap-4 px-5 py-5 sm:px-8 lg:flex-row lg:items-center lg:justify-between">
    <%= link_to "Three Heavens", root_path, class: "text-lg font-semibold tracking-tight text-slate-950" %>
    <nav aria-label="<%= t("landing.navigation") %>" class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-3 text-sm font-medium lg:justify-center">
      <a href="#how-it-works" class="text-slate-600 hover:text-blue-700"><%= t("landing.how_it_works") %></a>
      <%= link_to t("authentication.sign_in"), login_path, class: "text-slate-700 hover:text-blue-700" unless authenticated? %>
      <%= link_to t("registration.create_account"), new_registration_path, class: "rounded-lg bg-blue-700 px-4 py-2.5 text-white hover:bg-blue-800" unless authenticated? %>
      <%= link_to t("landing.open_workspace"), new_translation_workspace_path, class: "rounded-lg bg-blue-700 px-4 py-2.5 text-white hover:bg-blue-800" if authenticated? %>
    </nav>
    <%= render "shared/locale_selector", context: :public %>
  </header>
  <main id="main-content">
    <section class="mx-auto w-full min-w-0 max-w-6xl px-5 pb-20 pt-12 sm:px-8 sm:pt-24">
      <p class="text-sm font-semibold uppercase tracking-widest text-blue-700">Three Heavens</p>
      <h1 class="mt-5 max-w-4xl text-3xl font-semibold leading-tight tracking-tight text-slate-950 sm:text-6xl">
        <span class="block"><%= t("landing.headline_first") %></span>
        <span class="block"><%= t("landing.headline_second_prefix") %><span class="whitespace-nowrap"><%= t("landing.headline_second_emphasis") %></span></span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600"><%= t("landing.introduction") %></p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <%= link_to t(authenticated? ? "landing.open_workspace" : "registration.create_account"), authenticated? ? new_translation_workspace_path : new_registration_path, class: "rounded-lg bg-blue-700 px-6 py-3 font-semibold text-white hover:bg-blue-800" %>
        <%= link_to t("authentication.sign_in"), login_path, class: "px-3 py-3 font-semibold text-slate-700 hover:text-blue-700" unless authenticated? %>
      </div>
      <p class="mt-5 max-w-xl text-sm text-slate-500"><%= t("landing.access_note") %></p>
    </section>
    <section id="how-it-works" class="border-t border-slate-200 bg-slate-50 px-5 py-20 sm:px-8">
      <div class="mx-auto max-w-6xl">
        <h2 class="text-3xl font-semibold tracking-tight"><%= t("landing.how_it_works") %></h2>
        <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <% %w[prepare compare review finalize].each_with_index do |step, index| %>
            <article>
              <p class="text-sm font-semibold text-blue-700"><%= format("%02d", index + 1) %></p>
              <h3 class="mt-3 text-xl font-semibold"><%= t("landing.steps.#{step}.title") %></h3>
              <p class="mt-2 leading-7 text-slate-600"><%= t("landing.steps.#{step}.description") %></p>
            </article>
          <% end %>
        </div>
      </div>
    </section>
    <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
      <h2 class="text-3xl font-semibold tracking-tight"><%= t("landing.your_work") %></h2>
      <p class="mt-5 max-w-2xl leading-8 text-slate-600"><%= t("landing.trust") %></p>
    </section>
  </main>
  <footer class="border-t border-slate-200 px-5 py-8 text-sm text-slate-500 sm:px-8">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4">
      <span>Three Heavens</span>
      <%= render "shared/locale_selector", context: :public %>
    </div>
  </footer>
</div>
