<header class="landing-header">
  <div class="landing-shell landing-header-inner">
    <%= link_to root_path, class: "landing-brand", aria: { label: "Three Heavens" } do %>
      <%= render "landing/brand" %>
    <% end %>

    <nav class="landing-primary-nav" aria-label="<%= t("landing.navigation") %>">
      <a href="#product"><%= t("landing.nav.product") %></a>
      <a href="#how-it-works"><%= t("landing.nav.how_it_works") %></a>
      <%= link_to t("landing.nav.benchmarks"), benchmarks_path %>
    </nav>

    <div class="landing-header-actions">
      <details class="landing-locale" data-controller="disclosure" data-action="click@document->disclosure#closeOutside keydown.esc@document->disclosure#closeOnEscape">
        <summary aria-label="<%= t("common.interface_language") %>: <%= interface_locale_names.fetch(I18n.locale.to_s) %>">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 17.5a7.5 7.5 0 1 0 0-15 7.5 7.5 0 0 0 0 15Zm-7.5-7.5h15M10 2.5c2 2 3 4.5 3 7.5s-1 5.5-3 7.5c-2-2-3-4.5-3-7.5s1-5.5 3-7.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
          <span><%= I18n.locale.to_s.upcase %></span>
        </summary>
        <%= render "landing/locale_options" %>
      </details>
      <%= render "shared/appearance_menu" %>
      <% if authenticated? %>
        <%= link_to t("landing.open_workspace"), new_translation_workspace_path, class: "landing-button landing-button-small landing-button-primary" %>
      <% else %>
        <%= link_to t("authentication.sign_in"), login_path, class: "landing-sign-in" %>
        <%= link_to t("registration.create_account"), new_registration_path, class: "landing-button landing-button-small landing-button-primary" %>
      <% end %>
    </div>

    <details class="landing-mobile-menu" data-controller="disclosure" data-action="click@document->disclosure#closeOutside keydown.esc@document->disclosure#closeOnEscape click->disclosure#closeAfterNavigation">
      <summary aria-label="<%= t("landing.nav.menu") %>"><span></span><span></span><span></span></summary>
      <div class="landing-mobile-panel">
        <nav aria-label="<%= t("landing.navigation") %>">
          <a href="#product"><%= t("landing.nav.product") %></a>
          <a href="#how-it-works"><%= t("landing.nav.how_it_works") %></a>
          <%= link_to t("landing.nav.benchmarks"), benchmarks_path %>
          <% if authenticated? %>
            <%= link_to t("landing.open_workspace"), new_translation_workspace_path, class: "landing-mobile-menu-cta" %>
          <% else %>
            <%= link_to t("authentication.sign_in"), login_path %>
            <%= link_to t("registration.create_account"), new_registration_path, class: "landing-mobile-menu-cta" %>
          <% end %>
        </nav>
        <%= render "landing/locale_options" %>
        <div data-controller="appearance" data-appearance-current-value="<%= current_appearance %>" data-appearance-revision-value="<%= current_appearance_revision %>" data-appearance-labels-value="<%= appearance_labels.to_json %>">
          <%= render "shared/appearance_options", class_name: "landing-appearance-options" %>
        </div>
      </div>
    </details>
  </div>
</header>
