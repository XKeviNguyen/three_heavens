<% content_for :title, "Page unavailable · Three Heavens" %>

<section class="mx-auto max-w-xl rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm" aria-labelledby="not-found-heading">
  <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Page unavailable</p>
  <h1 id="not-found-heading" class="mt-2 text-3xl font-bold tracking-tight text-slate-950">We couldn’t find that page</h1>
  <p class="mt-3 text-sm leading-6 text-slate-600">It may no longer exist, or it may belong to a different account. No private record details have been disclosed.</p>
  <div class="mt-6 flex flex-wrap justify-center gap-3">
    <%= link_to "Go to workspace", new_translation_workspace_path, class: "rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800" %>
    <%= link_to "View projects", projects_path, class: "rounded-lg border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50" %>
  </div>
</section>
