<% content_for :title, "Methodology Profiles · Three Heavens" %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Translation guidance</p>
      <h1 class="mt-2 text-3xl font-bold">Methodology Profiles</h1>
      <p class="mt-2 max-w-3xl text-sm text-slate-600">Owner-private, reusable guidance for how translations should be produced. Methodologies are separate from literal terminology glossaries and workflow/model profiles.</p>
    </div>
    <%= link_to "New methodology", new_methodology_profile_path, class: "w-fit rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %>
  </header>

  <% if @methodology_profiles.empty? %>
    <section class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
      <h2 class="font-semibold">No methodology profiles yet</h2>
      <p class="mt-2 text-sm text-slate-600">Create reusable style and translation guidance, then select it in the workspace.</p>
      <%= link_to "Create a methodology", new_methodology_profile_path, class: "mt-5 inline-flex rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %>
    </section>
  <% else %>
    <section class="space-y-4" aria-label="Methodology profiles">
      <% @methodology_profiles.each do |profile| %>
        <% revision = profile.current_revision %>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h2 class="text-xl font-semibold"><%= revision.name %></h2>
              <p class="mt-1 text-sm text-slate-600"><%= revision.source_language %> → <%= revision.target_language %> · revision <%= revision.version %></p>
            </div>
            <span class="w-fit rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(profile.active? ? :active : :archived) %>"><%= profile.active? ? "Active" : "Archived" %></span>
          </div>
          <p class="mt-3 text-sm text-slate-600"><%= revision.description.presence || "No description" %></p>
          <div class="mt-5 flex flex-wrap gap-4 border-t border-slate-100 pt-4 text-sm font-semibold">
            <%= link_to "View history", profile, class: "text-blue-700" %>
            <%= link_to "Create revision", edit_methodology_profile_path(profile), class: "text-blue-700" %>
            <% if profile.active? %>
              <%= button_to "Archive", deactivate_methodology_profile_path(profile), method: :patch, data: { turbo_confirm: "Archive this methodology? Existing experiments keep their exact revision." }, class: "text-amber-700" %>
            <% else %>
              <%= button_to "Activate", activate_methodology_profile_path(profile), method: :patch, class: "text-emerald-700" %>
            <% end %>
          </div>
        </article>
      <% end %>
    </section>
    <%= render "shared/pagination", pagination: @pagination, label: "Methodology profiles" %>
  <% end %>
</div>
