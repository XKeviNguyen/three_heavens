<% content_for :title, t("methodology_ui.title") %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("glossaries_ui.translation_guidance") %></p>
      <h1 class="mt-2 text-3xl font-bold"><%= t("methodology_ui.heading") %></h1>
      <p class="mt-2 max-w-3xl text-sm text-slate-600"><%= t("methodology_ui.index_intro") %></p>
    </div>
    <%= link_to t("methodology_ui.new"), new_methodology_profile_path, class: "w-fit rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %>
  </header>

  <% if @methodology_profiles.empty? %>
    <section class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
      <h2 class="font-semibold"><%= t("methodology_ui.empty") %></h2>
      <p class="mt-2 text-sm text-slate-600"><%= t("methodology_ui.empty_intro") %></p>
      <%= link_to t("methodology_ui.create"), new_methodology_profile_path, class: "mt-5 inline-flex rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %>
    </section>
  <% else %>
    <section class="space-y-4" aria-label="<%= t("methodology_ui.heading") %>">
      <% @methodology_profiles.each do |profile| %>
        <% revision = profile.current_revision %>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h2 class="text-xl font-semibold"><%= revision.name %></h2>
              <p class="mt-1 text-sm text-slate-600"><%= revision.source_language %> → <%= revision.target_language %> · <%= t("glossaries_ui.revision", version: revision.version) %></p>
            </div>
            <span class="w-fit rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(profile.active? ? :active : :archived) %>"><%= localized_status(profile.active? ? :active : :archived) %></span>
          </div>
          <p class="mt-3 text-sm text-slate-600"><%= revision.description.presence || t("glossaries_ui.no_description") %></p>
          <div class="mt-5 flex flex-wrap gap-4 border-t border-slate-100 pt-4 text-sm font-semibold">
            <%= link_to t("glossaries_ui.view_history"), profile, class: "text-blue-700" %>
            <%= link_to t("glossaries_ui.create_revision"), edit_methodology_profile_path(profile), class: "text-blue-700" %>
            <% if profile.active? %>
              <%= button_to t("glossaries_ui.archive"), deactivate_methodology_profile_path(profile), method: :patch, data: { turbo_confirm: t("methodology_ui.archive_confirm") }, class: "text-amber-700" %>
            <% else %>
              <%= button_to t("glossaries_ui.activate"), activate_methodology_profile_path(profile), method: :patch, class: "text-emerald-700" %>
            <% end %>
          </div>
        </article>
      <% end %>
    </section>
    <%= render "shared/pagination", pagination: @pagination, label: t("methodology_ui.heading") %>
  <% end %>
</div>
