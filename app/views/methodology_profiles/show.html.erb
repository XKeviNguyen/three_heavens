<% content_for :title, "#{@methodology_profile.name} · Methodology · Three Heavens" %>

<div class="space-y-8">
  <header class="flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Methodology profile</p>
      <h1 class="mt-2 text-3xl font-bold"><%= @methodology_profile.name %></h1>
      <p class="mt-2 text-sm text-slate-600">Historical revisions remain immutable and viewable after archive.</p>
    </div>
    <div class="flex gap-3">
      <%= link_to "Revise", edit_methodology_profile_path(@methodology_profile), class: "rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %>
      <%= link_to "All methodologies", methodology_profiles_path, class: "rounded-lg border border-slate-300 px-4 py-2 font-semibold" %>
    </div>
  </header>

  <p><span class="rounded-full px-3 py-1 text-xs font-semibold <%= @methodology_profile.active? ? "bg-emerald-100 text-emerald-800" : "bg-slate-200 text-slate-700" %>"><%= @methodology_profile.active? ? "Active" : "Archived" %></span></p>

  <% @methodology_profile.revisions.each do |revision| %>
    <section class="rounded-xl border <%= revision.id == @methodology_profile.current_revision_id ? "border-blue-300" : "border-slate-200" %> bg-white p-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl font-semibold">Revision <%= revision.version %><% if revision.id == @methodology_profile.current_revision_id %> · Current<% end %></h2>
        <span class="text-sm"><%= revision.source_language %> → <%= revision.target_language %></span>
      </div>
      <p class="mt-2 text-sm text-slate-600"><%= revision.name %> · <%= revision.description.presence || "No description" %></p>
      <p class="mt-3 break-all font-mono text-xs text-slate-500">SHA-256 <%= revision.configuration_digest %></p>
      <div class="mt-5 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-800"><%= revision.guidance %></div>
      <% if revision.experiments.any? %>
        <p class="mt-4 text-sm text-slate-600"><%= pluralize(revision.experiments.size, "experiment") %> preserve this exact revision.</p>
      <% end %>
    </section>
  <% end %>
</div>
