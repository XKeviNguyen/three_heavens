<% content_for :title, "#{@methodology_profile.name} · Methodology · Three Heavens" %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Methodology profile</p>
      <h1 class="mt-2 text-3xl font-bold"><%= @methodology_profile.name %></h1>
      <p class="mt-2 text-sm text-slate-600">Historical revisions remain immutable and viewable after archive.</p>
      <span class="mt-3 inline-flex rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(@methodology_profile.active? ? :active : :archived) %>"><%= @methodology_profile.active? ? "Active · available in workspace" : "Archived · history only" %></span>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Create revision", edit_methodology_profile_path(@methodology_profile), class: "rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white" %>
      <% if @methodology_profile.active? %>
        <%= button_to "Archive", deactivate_methodology_profile_path(@methodology_profile), method: :patch, data: { turbo_confirm: "Archive this methodology? Existing experiments keep their exact revision." }, class: "rounded-lg border border-amber-300 px-4 py-2 font-semibold text-amber-800" %>
      <% else %>
        <%= button_to "Activate", activate_methodology_profile_path(@methodology_profile), method: :patch, class: "rounded-lg border border-emerald-300 px-4 py-2 font-semibold text-emerald-800" %>
      <% end %>
      <%= link_to "All methodologies", methodology_profiles_path, class: "rounded-lg border border-slate-300 px-4 py-2 font-semibold" %>
    </div>
  </header>

  <aside class="rounded-xl border border-blue-200 bg-blue-50 p-5 text-sm text-blue-950"><span class="font-semibold">Using methodologies:</span> choose this profile for a matching language pair in the <%= link_to "translation workspace", new_translation_workspace_path, class: "font-semibold underline" %>.</aside>

  <% @revisions.each do |revision| %>
    <section class="rounded-xl border <%= revision.id == @methodology_profile.current_revision_id ? "border-blue-300" : "border-slate-200" %> bg-white p-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl font-semibold">Revision <%= revision.version %><% if revision.id == @methodology_profile.current_revision_id %> · Current<% end %></h2>
        <span class="text-sm"><%= revision.source_language %> → <%= revision.target_language %></span>
      </div>
      <p class="mt-2 text-sm text-slate-600"><%= revision.name %> · <%= revision.description.presence || "No description" %></p>
      <details class="mt-3 text-xs text-slate-500"><summary class="cursor-pointer font-semibold">Technical revision identity</summary><p class="mt-2 break-all font-mono">SHA-256 <%= revision.configuration_digest %></p></details>
      <div class="mt-5 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-800"><%= revision.guidance %></div>
      <% if revision.experiments.any? %>
        <p class="mt-4 text-sm text-slate-600"><%= pluralize(revision.experiments.size, "experiment") %> preserve this exact revision.</p>
      <% end %>
    </section>
  <% end %>
  <%= render "shared/pagination", pagination: @pagination, label: "Revisions" %>
</div>
