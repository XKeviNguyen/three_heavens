<% content_for :title, t("projects_ui.title") %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("projects_ui.workspaces") %></p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= t("projects_ui.heading") %></h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600"><%= t("projects_ui.intro") %></p>
    </div>
    <%= link_to t("projects_ui.start_new"), new_translation_workspace_path, class: "inline-flex w-fit rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800" %>
  </header>

  <% if @projects.empty? %>
    <section class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950"><%= t("projects_ui.empty") %></h2>
      <p class="mt-2 text-sm text-slate-600"><%= t("projects_ui.empty_intro") %></p>
      <%= link_to t("projects_ui.start_translation"), new_translation_workspace_path, class: "mt-5 inline-flex rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800" %>
    </section>
  <% else %>
    <section class="grid gap-5 lg:grid-cols-2" aria-label="<%= t("projects_ui.heading") %>">
      <% @projects.each do |project| %>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-xl font-semibold text-slate-950"><%= project.name %></h2>
          <p class="mt-1 text-sm text-slate-600"><%= project.source_language %> → <%= project.target_language %></p>
          <dl class="mt-5 grid grid-cols-2 gap-4 text-sm">
            <div><dt class="text-slate-500"><%= t("projects_ui.documents") %></dt><dd class="mt-1 font-semibold text-slate-950"><%= project.documents_count %></dd></div>
            <div><dt class="text-slate-500"><%= t("projects_ui.experiments") %></dt><dd class="mt-1 font-semibold text-slate-950"><%= project.experiments_count %></dd></div>
            <div class="col-span-2"><dt class="text-slate-500"><%= t("projects_ui.newest_activity") %></dt><dd class="mt-1 font-semibold text-slate-950"><%= l project.latest_activity_at, format: :long %></dd></div>
          </dl>
          <%= link_to t("projects_ui.open_project"), project_path(project), class: "mt-5 inline-flex text-sm font-semibold text-blue-700 hover:text-blue-900" %>
        </article>
      <% end %>
    </section>

    <%= render "shared/pagination", pagination: { current_page: @current_page, total_pages: @total_pages, total_count: @total_count }, label: t("projects_ui.heading") %>
  <% end %>
</div>
