<% content_for :title, "#{@project.name} · Projects · Three Heavens" %>

<div class="space-y-8">
  <header class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Project workspace</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= @project.name %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= @project.source_language %> → <%= @project.target_language %> · <%= pluralize(@total_count, "document") %></p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Paste text / start translation", new_translation_workspace_path(project_id: @project.id), class: "inline-flex rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800" %>
      <%= link_to "Upload source file", new_source_import_path(project_id: @project.id), class: "inline-flex rounded-lg border border-blue-200 px-4 py-2 font-semibold text-blue-700 hover:bg-blue-50" %>
    </div>
  </header>

  <% if @documents.empty? %>
    <section class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950">No source documents yet</h2>
      <p class="mt-2 text-sm text-slate-600">Paste text or upload one source file to start this Project's first translation experiment.</p>
      <%= link_to "Paste source text", new_translation_workspace_path(project_id: @project.id), class: "mt-5 inline-flex rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800" %>
    </section>
  <% else %>
    <section class="space-y-6" aria-label="Project documents">
      <% @documents.each do |document| %>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= l document.created_at, format: :long %></p>
            <h2 class="mt-2 text-xl font-semibold text-slate-950"><%= document.title %></h2>
            <p class="mt-1 text-sm text-slate-600"><%= document.uploaded_file? ? "Uploaded source" : "Pasted source" %> · <%= pluralize(document.experiments.size, "experiment") %></p>
          </div>

          <div class="mt-5 space-y-4">
            <% document.experiments.sort_by { |experiment| [experiment.created_at, experiment.id] }.reverse_each do |experiment| %>
              <% review_round = experiment.review_round %>
              <% judge_round = review_round&.judge_round %>
              <section class="rounded-lg border border-slate-200 bg-slate-50 p-5">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <h3 class="font-semibold text-slate-950"><%= experiment.name.presence || "Translation experiment" %></h3>
                    <p class="mt-1 text-sm text-slate-600"><%= experiment.pipeline_run ? "Automatic workflow" : "Manual workflow" %></p>
                  </div>
                  <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(experiment.status) %>"><%= experiment.status.humanize %></span>
                </div>

                <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-xs text-slate-600">
                  <% if experiment.glossary_revision %><span>Glossary: <strong><%= experiment.glossary_revision.name %> · revision <%= experiment.glossary_revision.version %></strong></span><% end %>
                  <% if experiment.methodology_profile_revision %><span>Methodology: <strong><%= experiment.methodology_profile_revision.name %> · revision <%= experiment.methodology_profile_revision.version %></strong></span><% end %>
                  <span>Blind review: <strong><%= review_round&.status&.humanize || "Not started" %></strong></span>
                  <span>Judge: <strong><%= judge_round&.status&.humanize || "Not started" %></strong></span>
                  <span>Final translation: <strong><%= experiment.final_translation&.status&.humanize || "Not created" %></strong></span>
                </div>

                <div class="mt-4 flex flex-wrap gap-4 border-t border-slate-200 pt-3 text-sm font-semibold">
                  <%= link_to "Experiment", experiment_path(experiment), class: "text-blue-700 hover:text-blue-900" %>
                  <% if experiment.pipeline_run %><%= link_to "Pipeline progress", pipeline_run_path(experiment.pipeline_run), class: "text-blue-700 hover:text-blue-900" %><% end %>
                  <% if review_round %><%= link_to "Blind review", review_round_path(review_round), class: "text-blue-700 hover:text-blue-900" %><% end %>
                  <% if judge_round %><%= link_to "Judge results", judge_round_path(judge_round), class: "text-blue-700 hover:text-blue-900" %><% end %>
                  <% if experiment.final_translation %><%= link_to "Final translation", final_translation_path(experiment.final_translation), class: "text-blue-700 hover:text-blue-900" %><% end %>
                </div>
              </section>
            <% end %>
          </div>
        </article>
      <% end %>
    </section>

    <% if @total_pages > 1 %>
      <nav class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-5 py-4 text-sm" aria-label="Document pagination">
        <div><% if @current_page > 1 %><%= link_to "← Newer", project_path(@project, page: @current_page - 1), rel: "prev", class: "font-semibold text-blue-700 hover:text-blue-900" %><% end %></div>
        <p class="text-slate-600">Page <%= @current_page %> of <%= @total_pages %> · <%= @total_count %> documents</p>
        <div><% if @current_page < @total_pages %><%= link_to "Older →", project_path(@project, page: @current_page + 1), rel: "next", class: "font-semibold text-blue-700 hover:text-blue-900" %><% end %></div>
      </nav>
    <% end %>
  <% end %>

  <%= link_to "← All Projects", projects_path, class: "inline-flex text-sm font-semibold text-blue-700 hover:text-blue-900" %>
</div>
