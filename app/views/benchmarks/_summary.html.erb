<dl class="grid gap-4 text-sm sm:grid-cols-2 lg:grid-cols-4">
  <div class="rounded-lg bg-slate-50 p-4">
    <dt class="text-slate-500"><%= t("benchmarks_ui.completed_translations") %></dt>
    <dd class="mt-1 text-xl font-bold text-slate-950"><%= stats.completed_translation_count %></dd>
    <p class="mt-1 text-xs text-slate-500"><%= t("benchmarks_ui.participation", count: stats.translation_participation_count, failed: stats.failed_translation_count, rate: analytics_percent(stats.translation_failure_rate)) %></p>
  </div>
  <div class="rounded-lg bg-slate-50 p-4">
    <dt class="text-slate-500"><%= t("benchmarks_ui.official_wins") %></dt>
    <dd class="mt-1 text-xl font-bold text-slate-950"><%= stats.official_wins %></dd>
    <p class="mt-1 text-xs text-slate-500"><%= t("benchmarks_ui.win_rate_detail", rate: analytics_percent(stats.official_win_rate), count: stats.completed_judged_experiment_count) %></p>
  </div>
  <div class="rounded-lg bg-slate-50 p-4">
    <dt class="text-slate-500"><%= t("benchmarks_ui.review_score") %></dt>
    <dd class="mt-1 text-xl font-bold text-slate-950"><%= analytics_number(stats.review_average_score) %><%= "/10" if stats.review_average_score %></dd>
    <p class="mt-1 text-xs text-slate-500"><%= t("benchmarks_ui.score_samples", count: stats.review_score_sample_count, candidates: stats.reviewed_candidate_count) %></p>
  </div>
  <div class="rounded-lg bg-slate-50 p-4">
    <dt class="text-slate-500"><%= t("benchmarks_ui.judge_score") %></dt>
    <dd class="mt-1 text-xl font-bold text-slate-950"><%= analytics_number(stats.judge_average_score) %><%= "/100" if stats.judge_average_score %></dd>
    <p class="mt-1 text-xs text-slate-500"><%= t("benchmarks_ui.score_samples", count: stats.judge_score_sample_count, candidates: stats.judged_candidate_count) %></p>
  </div>
  <div class="rounded-lg bg-slate-50 p-4">
    <dt class="text-slate-500"><%= t("benchmarks_ui.known_translation_cost") %></dt>
    <dd class="mt-1 text-lg font-bold text-slate-950"><%= t("benchmarks_ui.total", value: analytics_money(stats.total_translation_cost)) %></dd>
    <p class="mt-1 text-xs text-slate-500"><%= t("benchmarks_ui.average_samples", value: analytics_money(stats.average_translation_cost), count: stats.cost_sample_count) %></p>
  </div>
  <div class="rounded-lg bg-slate-50 p-4">
    <dt class="text-slate-500"><%= t("benchmarks_ui.average_latency") %></dt>
    <dd class="mt-1 text-lg font-bold text-slate-950"><%= analytics_duration(stats.average_latency_seconds) %></dd>
    <p class="mt-1 text-xs text-slate-500"><%= t("benchmarks_ui.completed_samples", count: stats.latency_sample_count) %></p>
  </div>
  <div class="rounded-lg bg-slate-50 p-4">
    <dt class="text-slate-500"><%= t("benchmarks_ui.average_total_tokens") %></dt>
    <dd class="mt-1 text-lg font-bold text-slate-950"><%= analytics_number(stats.average_total_tokens, precision: 1) %></dd>
    <p class="mt-1 text-xs text-slate-500"><%= t("benchmarks_ui.completed_samples", count: stats.token_sample_count) %></p>
  </div>
  <div class="rounded-lg bg-slate-50 p-4">
    <dt class="text-slate-500"><%= t("benchmarks_ui.cost_per_point") %></dt>
    <dd class="mt-1 text-lg font-bold text-slate-950"><%= analytics_money(stats.average_cost_per_judge_score_point) %></dd>
    <p class="mt-1 text-xs text-slate-500"><%= t("benchmarks_ui.cost_quality_samples", count: stats.cost_quality_sample_count) %></p>
  </div>
</dl>
