<% content_for :title, t("benchmarks_ui.title") %>

<div class="space-y-10">
  <header class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("history_ui.analytics") %></p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= t("benchmarks_ui.heading") %></h1>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
        <%= t("benchmarks_ui.intro") %>
      </p>
    </div>

    <%= form_with url: benchmarks_path, method: :get, class: "flex items-end gap-3" do |form| %>
      <div>
        <%= form.label :sort, t("benchmarks_ui.sort_by"), class: "block text-xs font-semibold uppercase tracking-wide text-slate-500" %>
        <%= form.select :sort,
                        options_for_select([
                          [ t("benchmarks_ui.sort.judge_samples"), "judged_samples" ],
                          [ t("benchmarks_ui.sort.wins"), "wins" ],
                          [ t("benchmarks_ui.sort.win_rate"), "win_rate" ],
                          [ t("benchmarks_ui.sort.review_score"), "review_score" ],
                          [ t("benchmarks_ui.sort.judge_score"), "judge_score" ],
                          [ t("benchmarks_ui.sort.translation_cost"), "translation_cost" ],
                          [ t("benchmarks_ui.sort.latency"), "latency" ]
                        ], @sort),
                        {},
                        class: "mt-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %>
      </div>
      <%= form.submit t("benchmarks_ui.sort_button"), class: "rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
    <% end %>
  </header>

  <% if @model_stats.empty? %>
    <section class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950"><%= t("benchmarks_ui.empty") %></h2>
      <p class="mt-2 text-sm text-slate-600"><%= t("benchmarks_ui.empty_intro") %></p>
    </section>
  <% else %>
    <section class="space-y-5" aria-label="<%= t("benchmarks_ui.heading") %>">
      <% @model_stats.each_with_index do |stats, index| %>
        <% model = stats.model %>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm" data-model-id="<%= model.id %>">
          <div class="mb-5 flex flex-col gap-4 border-b border-slate-100 pb-5 sm:flex-row sm:items-start sm:justify-between">
            <div class="flex gap-4">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-800"><%= index + 1 %></span>
              <div>
                <h2 class="text-xl font-semibold text-slate-950"><%= link_to model.display_name, benchmark_model_path(model), class: "hover:text-blue-700" %></h2>
                <p class="mt-1 text-sm text-slate-600"><%= model.gateway %> · <%= model.provider %></p>
                <p class="mt-1 break-all font-mono text-xs text-slate-500"><%= model.model_identifier %></p>
              </div>
            </div>
            <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold <%= model.active? ? "bg-emerald-100 text-emerald-800" : "bg-slate-200 text-slate-700" %>"><%= localized_status(model.active? ? :active : :inactive) %></span>
          </div>

          <%= render "summary", stats: stats %>
        </article>
      <% end %>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-slate-950"><%= t("benchmarks_ui.diagnostics") %></h2>
      <p class="mt-2 max-w-4xl text-sm leading-6 text-slate-600">
        <%= t("benchmarks_ui.diagnostics_intro") %>
      </p>

      <div class="mt-5 overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
          <thead class="text-xs uppercase tracking-wide text-slate-500">
            <tr><th scope="col" class="px-3 py-3"><%= t("benchmarks_ui.model_role") %></th><th scope="col" class="px-3 py-3"><%= t("benchmarks_ui.self_scores") %></th><th scope="col" class="px-3 py-3"><%= t("benchmarks_ui.other_scores") %></th><th scope="col" class="px-3 py-3"><%= t("benchmarks_ui.self_difference") %></th><th scope="col" class="px-3 py-3"><%= t("benchmarks_ui.agreement") %></th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @model_stats.each do |stats| %>
              <% reviewer = stats.reviewer_diagnostics %>
              <% judge = stats.judge_diagnostics %>
              <% next unless reviewer || judge %>
              <tr>
                <th scope="row" class="px-3 py-4 font-semibold text-slate-950"><%= link_to stats.model.display_name, benchmark_model_path(stats.model), class: "hover:text-blue-700" %></th>
                <td class="px-3 py-4 text-slate-700"><%= reviewer ? "#{analytics_number(reviewer.self_average_score)} (n=#{reviewer.self_sample_count})" : t("common.not_available") %></td>
                <td class="px-3 py-4 text-slate-700"><%= reviewer ? "#{analytics_number(reviewer.other_average_score)} (n=#{reviewer.other_sample_count})" : t("common.not_available") %></td>
                <td class="px-3 py-4 font-semibold text-slate-950"><%= analytics_number(reviewer&.self_score_difference) %></td>
                <td class="px-3 py-4 text-slate-700"><%= judge ? "#{analytics_percent(judge.agreement_rate)} (#{judge.agreement_count}/#{judge.eligible_run_count})" : t("common.not_available") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <aside class="rounded-xl border border-blue-200 bg-blue-50 p-5 text-sm leading-6 text-slate-700">
    <h2 class="font-semibold text-slate-950"><%= t("benchmarks_ui.metric_notes") %></h2>
    <p class="mt-2"><%= t("benchmarks_ui.metric_notes_intro") %></p>
    <p class="mt-2"><%= t("benchmarks_ui.cost_note") %></p>
  </aside>
</div>
