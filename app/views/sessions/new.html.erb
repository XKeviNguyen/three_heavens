<% content_for :title, "Sign in · Three Heavens" %>

<div class="mx-auto max-w-md">
  <div class="mb-8 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Three Heavens</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Sign in</h1>
    <p class="mt-3 text-sm text-slate-600">Use the account provided by your operator.</p>
  </div>

  <%= form_with url: session_path, scope: :session, class: "space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm" do |form| %>
    <div>
      <%= form.label :email, class: "block text-sm font-medium text-slate-700" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", value: @email, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
    </div>
    <div>
      <%= form.label :password, class: "block text-sm font-medium text-slate-700" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: User::MAXIMUM_PASSWORD_LENGTH, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
    </div>
    <%= form.submit "Sign in", class: "w-full rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white shadow-sm hover:bg-blue-800" %>
  <% end %>
</div>
