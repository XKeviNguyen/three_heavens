<% content_for :title, t("authentication.sign_in") %>
<section class="mx-auto max-w-md">
  <h1 class="text-3xl font-semibold tracking-tight"><%= t("authentication.sign_in") %></h1>
  <p class="mt-3 text-slate-600"><%= t("authentication.sign_in_benefit") %></p>
  <% if GoogleIdentity.enabled? %>
    <div class="mt-8">
      <%= render "shared/google_sign_in", intent: "sign_in", text: "continue_with" %>
      <p class="auth-divider mt-6"><span><%= t("google_identity.or") %></span></p>
    </div>
  <% end %>
  <%= form_with url: session_path, scope: :session, class: "#{GoogleIdentity.enabled? ? "mt-6" : "mt-8"} space-y-5" do |form| %>
    <div><%= form.label :email, t("registration.email"), class: "block text-sm font-medium" %><%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", value: @email, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-3" %></div>
    <div><%= form.label :password, t("registration.password"), class: "block text-sm font-medium" %><%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: User::MAXIMUM_PASSWORD_LENGTH, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-3" %></div>
    <%= form.submit t("authentication.sign_in"), class: "w-full rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white hover:bg-blue-800" %>
  <% end %>
  <p class="mt-6 text-sm text-slate-600"><%= t("authentication.no_account") %> <%= link_to t("registration.create_account"), new_registration_path, class: "font-semibold text-blue-700" %></p>
  <p class="mt-3 text-sm"><%= link_to t("email_confirmation.resend"), new_confirmation_resend_path, class: "font-semibold text-blue-700" %></p>
</section>
