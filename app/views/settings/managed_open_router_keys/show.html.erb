<% content_for :title, t("managed_key.title") %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<section class="max-w-2xl space-y-6">
  <header>
    <h1 class="text-3xl font-semibold"><%= t("managed_key.title") %></h1>
    <p class="mt-2 text-slate-600"><%= t("managed_key.description") %></p>
  </header>

  <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="managed-key-current-heading">
    <h2 id="managed-key-current-heading" class="text-lg font-semibold text-slate-950"><%= t("managed_key.current_heading") %></h2>
    <p class="mt-1 text-sm text-slate-700">
      <% if @source == "saved" %>
        <%= t("managed_key.source.saved", hint: @hint, date: l(@saved_key.created_at.to_date, format: :long)) %>
      <% elsif @source == "unreadable" %>
        <%= t("managed_key.source.unreadable", hint: @hint || t("managed_key.source.no_hint")) %>
      <% elsif @source == "environment" %>
        <%= t("managed_key.source.environment", hint: @hint) %>
      <% else %>
        <%= t("managed_key.source.missing") %>
      <% end %>
    </p>
    <%= render "settings/open_router_key_status", status: @status %>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="managed-key-form-heading">
    <h2 id="managed-key-form-heading" class="text-lg font-semibold text-slate-950"><%= t(@saved_key ? "managed_key.replace_heading" : "managed_key.save_heading") %></h2>
    <%= form_with url: settings_managed_open_router_key_path, method: :put, scope: :managed_open_router_key, class: "mt-3" do |form| %>
      <%# The key this page shows; a change from an outdated page is refused. %>
      <%= hidden_field_tag :expected_key_id, @saved_key&.id, id: nil %>
      <%= form.label :api_key, t("managed_key.key_label"), class: "block text-sm font-medium text-slate-800" %>
      <%# Hints to password managers that this is an API key, not a sign-in password. %>
      <%= form.password_field :api_key, required: true, autocomplete: "off", autocapitalize: "off", autocorrect: "off", spellcheck: false, data: { "1p-ignore": "", lpignore: "true", bwignore: "", form_type: "other" }, maxlength: OpenRouterCredential::MAXIMUM_KEY_LENGTH, aria: { describedby: "managed-key-hint" }, class: "mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      <p id="managed-key-hint" class="mt-1 text-xs text-slate-500"><%= t("managed_key.key_hint") %></p>
      <%= form.submit t(@saved_key ? "managed_key.replace" : "managed_key.save"), data: (@saved_key ? { turbo_confirm: t("managed_key.replace_confirm", hint: @hint) } : {}), class: "mt-3 min-h-11 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
    <% end %>
    <% if @saved_key %>
      <%= button_to t("managed_key.delete"), settings_managed_open_router_key_path, method: :delete, params: { expected_key_id: @saved_key.id }, form: { data: { turbo_confirm: t("managed_key.delete_confirm") } }, class: "mt-3 min-h-11 rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50" %>
    <% end %>
  </section>
</section>
