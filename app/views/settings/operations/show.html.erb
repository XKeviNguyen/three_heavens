<% content_for :title, t("operations_ui.title") %>

<div class="space-y-8">
  <header>
    <p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("operations_ui.admin_settings") %></p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= t("operations_ui.heading") %></h1>
    <p class="mt-2 max-w-3xl text-sm text-slate-600"><%= t("operations_ui.intro") %></p>
  </header>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-slate-950"><%= t("operations_ui.diagnostics") %></h2>
    <p class="mt-1 text-sm text-slate-600"><%= t("operations_ui.diagnostics_intro") %></p>
    <p class="mt-3 text-xs text-slate-500"><%= t("operations_ui.release") %> <span class="font-mono"><%= @release_sha %></span></p>
    <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2 lg:grid-cols-6">
      <% @system_health.checks.each do |check| %>
        <div>
          <dt class="text-slate-500"><%= t("operations_ui.checks.#{check.name}") %></dt>
          <dd class="mt-1 font-semibold <%= check.status == 'healthy' ? 'text-emerald-700' : check.status == 'degraded' ? 'text-amber-700' : 'text-red-700' %>"><%= t("operations_ui.health.#{check.status}") %></dd>
          <% if check.metrics.any? %>
            <p class="mt-1 text-xs text-slate-500"><%= check.metrics.map { |name, value| "#{t("operations_ui.metrics.#{name}")}: #{value}" }.join(" · ") %></p>
          <% end %>
        </div>
      <% end %>
    </dl>
  </section>

  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-6 py-5">
      <h2 class="text-xl font-semibold text-slate-950"><%= t("operations_ui.current_work") %></h2>
      <p class="mt-1 text-sm text-slate-600"><%= t("operations_ui.stale_help", minutes: @health.stale_threshold_minutes) %></p>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">
          <tr><th scope="col" class="px-6 py-3"><%= t("operations_ui.workflow") %></th><th scope="col" class="px-6 py-3"><%= localized_status(:pending) %></th><th scope="col" class="px-6 py-3"><%= localized_status(:running) %></th><th scope="col" class="px-6 py-3"><%= localized_status(:failed) %></th><th scope="col" class="px-6 py-3"><%= t("operations_ui.stale_pending") %></th><th scope="col" class="px-6 py-3"><%= t("operations_ui.stale_running") %></th><th scope="col" class="px-6 py-3"><%= t("operations_ui.oldest_active") %></th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @health.workflows.each do |workflow| %>
            <tr>
              <th scope="row" class="px-6 py-4 text-left font-semibold text-slate-900"><%= t("operations_ui.run_types.#{workflow.fetch(:label).parameterize(separator: "_")}") %></th>
              <% %w[pending running failed].each do |status| %><td class="px-6 py-4 text-slate-700"><%= workflow.dig(:counts, status) %></td><% end %>
              <td class="px-6 py-4 font-semibold <%= workflow.fetch(:stale_pending_count).positive? ? 'text-red-700' : 'text-slate-700' %>"><%= workflow.fetch(:stale_pending_count) %></td>
              <td class="px-6 py-4 font-semibold <%= workflow.fetch(:stale_running_count).positive? ? 'text-red-700' : 'text-slate-700' %>"><%= workflow.fetch(:stale_running_count) %></td>
              <td class="px-6 py-4 text-slate-700"><%= workflow.fetch(:oldest_active_at) ? t("operations_ui.ago", duration: time_ago_in_words(workflow.fetch(:oldest_active_at))) : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-slate-950"><%= t("operations_ui.pipeline_health") %></h2>
    <p class="mt-1 text-sm text-slate-600"><%= t("operations_ui.pipeline_intro") %></p>
    <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2 lg:grid-cols-5">
      <div><dt class="text-slate-500"><%= localized_status(:running) %></dt><dd class="mt-1 font-semibold"><%= @health.pipelines.fetch(:running_count) %></dd></div>
      <div><dt class="text-slate-500"><%= localized_status(:blocked) %></dt><dd class="mt-1 font-semibold"><%= @health.pipelines.fetch(:blocked_count) %></dd></div>
      <div><dt class="text-slate-500"><%= localized_status(:ready_for_editor) %></dt><dd class="mt-1 font-semibold"><%= @health.pipelines.fetch(:ready_for_editor_count) %></dd></div>
      <div><dt class="text-slate-500"><%= t("operations_ui.configuration_blocked") %></dt><dd class="mt-1 font-semibold"><%= @health.pipelines.fetch(:configuration_blocked_count) %></dd></div>
      <div><dt class="text-slate-500"><%= t("operations_ui.oldest_running") %></dt><dd class="mt-1 font-semibold"><%= @health.pipelines.fetch(:oldest_running_age_seconds)&.then { |seconds| distance_of_time_in_words(seconds) } || "—" %></dd></div>
    </dl>
    <% if @health.pipelines.fetch(:by_stage).any? %><p class="mt-4 text-sm text-slate-600"><%= t("operations_ui.active_by_stage") %> <%= @health.pipelines.fetch(:by_stage).map { |stage, count| "#{t("operations_ui.stages.#{stage}")} #{count}" }.join(" · ") %></p><% end %>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-slate-950"><%= t("operations_ui.reconciliation") %></h2>
    <p class="mt-2 text-sm text-slate-600"><%= t("operations_ui.reconciliation_intro") %></p>
    <%= button_to t("operations_ui.reconcile"), reconcile_stale_settings_operations_path, method: :post, data: { turbo_confirm: t("operations_ui.reconcile_confirm"), turbo_submits_with: t("operations_ui.reconciling") }, class: "mt-4 rounded-lg bg-red-700 px-4 py-2 font-semibold text-white hover:bg-red-800" %>
  </section>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-slate-950"><%= t("operations_ui.failure_codes") %></h2>
    <p class="mt-1 text-sm text-slate-600"><%= t("operations_ui.failure_intro") %></p>
    <% if @health.failure_codes.any? %>
      <ul class="mt-4 divide-y divide-slate-100">
        <% @health.failure_codes.each do |failure| %>
          <li class="flex flex-wrap justify-between gap-3 py-3 text-sm"><span class="text-slate-700"><%= t("operations_ui.run_types.#{failure.fetch(:workflow).parameterize(separator: "_")}") %> · <span class="font-mono"><%= failure.fetch(:code) %></span></span><span class="font-semibold text-slate-900"><%= failure.fetch(:count) %></span></li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-slate-600"><%= t("operations_ui.no_failures") %></p>
    <% end %>
  </section>
</div>
