<% content_for :title, "Automatic pipeline · Three Heavens" %>
<% if @pipeline_run.running? %><% content_for :head do %><meta http-equiv="refresh" content="5"><% end %><% end %>
<% revision = @pipeline_run.workflow_profile_revision %>
<% experiment = @pipeline_run.experiment %>
<% review_round = experiment.review_round %>
<% judge_round = review_round&.judge_round %>
<div class="space-y-8">
  <% if experiment.methodology_profile_revision %><p class="rounded-lg bg-slate-100 px-4 py-3 text-sm text-slate-700"><span class="font-semibold">Methodology snapshot:</span> <%= link_to "#{experiment.methodology_profile_revision.name} · revision #{experiment.methodology_profile_revision.version}", methodology_profile_path(experiment.methodology_profile_revision.methodology_profile), class: "text-blue-700" %></p><% end %>
  <p class="rounded-lg bg-slate-100 px-4 py-3 text-sm text-slate-700"><span class="font-semibold">Guidance preference:</span> <%= TranslationGuidance::Policy.label(experiment.guidance_preference) %><% if experiment.experiment_reference_revisions.any? %><span class="ml-2"><span class="font-semibold">References:</span> <%= experiment.experiment_reference_revisions.map { |snapshot| "#{snapshot.translation_reference_revision.title} · revision #{snapshot.translation_reference_revision.version}" }.to_sentence %></span><% end %></p>
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"><div><p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Automatic pipeline</p><h1 class="mt-2 text-3xl font-bold"><%= revision.name %></h1><p class="mt-2 text-sm text-slate-600">Revision <%= revision.version %> · <%= @pipeline_run.completion_mode.humanize %> · started <%= l @pipeline_run.started_at, format: :long %></p></div><span class="rounded-full px-3 py-1 text-sm font-semibold <%= status_badge_classes(@pipeline_run.status) %>"><%= @pipeline_run.status.humanize %></span></header>

  <%= render "shared/workflow_progress", experiment: experiment %>

  <%= link_to "← Back to Project", project_path(experiment.document.project), class: "inline-flex text-sm font-semibold text-blue-700 hover:text-blue-900" %>

  <% if @pipeline_run.blocked? %><section class="rounded-xl border border-amber-300 bg-amber-50 p-6"><h2 class="text-xl font-semibold">Pipeline blocked at <%= @pipeline_run.blocked_stage.humanize %></h2><p class="mt-2 text-sm"><%= @pipeline_run.blocked_message %></p><p class="mt-2 text-sm font-semibold">Use the linked stage page for the existing explicit retry or manual continuation controls.</p></section><% end %>
  <% if @pipeline_run.ready_for_editor? %><section class="rounded-xl border border-emerald-300 bg-emerald-50 p-6"><h2 class="text-xl font-semibold">Ready for human editor</h2><p class="mt-2 text-sm">Automation has stopped. No proposal was applied, the draft content was not automatically changed, and the translation was not finalized.</p></section><% end %>
  <% if @pipeline_run.stopped? %><section class="rounded-xl border border-slate-300 bg-slate-100 p-6"><h2 class="text-xl font-semibold">Future automation stopped</h2><p class="mt-2 text-sm">Completed history is preserved. Provider work already queued or running was not cancelled, and you may continue manually.</p></section><% end %>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-xl font-semibold">Progress</h2><p class="mt-2 text-sm text-slate-600">Current stage: <span class="font-semibold text-slate-900"><%= @pipeline_run.current_stage.humanize %></span></p><ol class="mt-5 space-y-4 border-l-2 border-slate-200 pl-5"><% @pipeline_run.events.each do |event| %><li><p class="font-semibold"><%= event.event_type.humanize %></p><p class="text-xs text-slate-500"><%= l event.created_at, format: :long %><% if event.from_stage || event.to_stage %> · <%= [event.from_stage, event.to_stage].compact.join(" → ").humanize %><% end %></p></li><% end %></ol></section>

  <% work_plan = @pipeline_run.provider_work_plan %><% if work_plan.present? %><% attempts_per_slot = work_plan.dig("built_in_retry_policy", "maximum_attempts_per_slot") || Ai::ProviderRetryPolicy::MAX_ATTEMPTS_PER_AUTHORIZATION %><% maximum_requests = work_plan["maximum_automatic_provider_requests"] || work_plan.fetch("authorized_initial_provider_request_slots") * attempts_per_slot %><section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-xl font-semibold">Authorized provider-work plan</h2><p class="mt-2 text-sm text-slate-600"><%= work_plan.fetch("segment_count") %> source segment(s) · <strong><%= work_plan.fetch("authorized_initial_provider_request_slots") %></strong> initial provider request slots · at most <strong><%= maximum_requests %></strong> provider requests including the built-in <%= attempts_per_slot %>-attempt ceiling. Any later manual retry requires another explicit action.</p><dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><% work_plan.fetch("roles").each do |role, details| %><div><dt class="text-sm text-slate-500"><%= role.humanize.pluralize %></dt><dd class="font-semibold"><%= details.fetch("logical_run_count") %> logical × <%= work_plan.fetch("segment_count") %> segment(s) = <%= details.fetch("provider_request_slots") %> initial requests</dd></div><% end %></dl></section><% end %>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold">Execution status</h2>
    <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div><dt class="text-sm text-slate-500">Logical runs</dt><dd class="mt-1 font-semibold"><%= @execution_summary.logical_status_counts.fetch("completed", 0) %> completed / <%= @execution_summary.logical_total %> total</dd></div>
      <div><dt class="text-sm text-slate-500">Physical work slots</dt><dd class="mt-1 font-semibold"><%= @execution_summary.physical_status_counts.fetch("completed", 0) %> completed / <%= @execution_summary.physical_total %> created</dd></div>
      <div><dt class="text-sm text-slate-500">Provider attempts started</dt><dd class="mt-1 font-semibold"><%= @execution_summary.attempt_total %></dd></div>
      <div><dt class="text-sm text-slate-500">Pending · running · failed</dt><dd class="mt-1 font-semibold"><%= @execution_summary.physical_status_counts.fetch("pending", 0) %> · <%= @execution_summary.physical_status_counts.fetch("running", 0) %> · <%= @execution_summary.physical_status_counts.fetch("failed", 0) %></dd></div>
      <div><dt class="text-sm text-slate-500">Known tokens</dt><dd class="mt-1 font-semibold"><%= @execution_summary.known_total_tokens ? number_with_delimiter(@execution_summary.known_total_tokens) : "N/A" %></dd><% if @execution_summary.token_telemetry_incomplete? %><p class="mt-1 text-xs font-medium text-amber-700">Known subtotal; <%= @execution_summary.token_sample_count %>/<%= @execution_summary.attempt_total %> attempts reported tokens.</p><% end %></div>
      <div><dt class="text-sm text-slate-500">Known attempt cost</dt><dd class="mt-1 font-semibold"><%= analytics_money(@execution_summary.known_cost) %></dd><% if @execution_summary.cost_telemetry_incomplete? %><p class="mt-1 text-xs font-medium text-amber-700">Known subtotal; unknown costs are not zero.</p><% end %></div>
      <div><dt class="text-sm text-slate-500">Mean completed-attempt latency</dt><dd class="mt-1 font-semibold"><%= @execution_summary.average_latency_seconds ? "#{analytics_number(@execution_summary.average_latency_seconds)} s" : "N/A" %></dd><p class="mt-1 text-xs text-slate-500">n=<%= @execution_summary.latency_sample_count %></p></div>
    </dl>
  </section>

  <% if @execution_summary.recent_failures.any? %>
    <section class="rounded-xl border border-amber-200 bg-amber-50 p-6 shadow-sm">
      <h2 class="text-xl font-semibold">Recent provider-attempt failures</h2>
      <p class="mt-2 text-sm text-slate-700">Only sanitized codes and immutable request lineage are shown. Provider bodies, prompts, source text, and raw remote errors are never included.</p>
      <ul class="mt-4 space-y-3 text-sm">
        <% @execution_summary.recent_failures.each do |attempt| %>
          <li class="rounded-lg border border-amber-200 bg-white p-4"><span class="font-semibold"><%= attempt.stage.humanize %> · <%= attempt.display_name_snapshot %> · attempt <%= attempt.attempt_number %></span><span class="mt-1 block font-mono text-xs text-slate-600"><%= attempt.error_code %> · <%= l attempt.completed_at, format: :long %></span></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-xl font-semibold">Authorized model snapshots</h2><div class="mt-5 grid gap-5 lg:grid-cols-4"><% WorkflowProfileModelSelection::ROLES.each do |role| %><div><h3 class="font-semibold"><%= role.humanize.pluralize %> (<%= revision.role_count(role) %>)</h3><ol class="mt-2 space-y-2 text-sm"><% revision.selections_for(role).each do |selection| %><li><%= selection.display_name_snapshot %><span class="block break-all text-xs text-slate-500"><%= selection.provider_snapshot %> · <%= selection.model_identifier_snapshot %></span></li><% end %></ol></div><% end %></div></section>

  <% if @execution_summary.attempt_coverage_incomplete? %><section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-xl font-semibold">Logical-run cost coverage</h2><dl class="mt-4 grid gap-4 sm:grid-cols-3"><div><dt class="text-sm text-slate-500">Known logical total</dt><dd class="mt-1 font-semibold"><%= analytics_money(@cost_summary.known_cost) %></dd></div><div><dt class="text-sm text-slate-500">Logical records</dt><dd class="mt-1 font-semibold"><%= @cost_summary.record_count %></dd></div><div><dt class="text-sm text-slate-500">With known cost</dt><dd class="mt-1 font-semibold"><%= @cost_summary.known_count %></dd></div></dl><p class="mt-3 text-sm font-semibold text-amber-700">Per-attempt history covers <%= @execution_summary.tracked_physical_run_count %>/<%= @execution_summary.physical_total %> physical work items. This separate logical-run total keeps earlier known spend visible; it is not added to the attempt subtotal because their coverage may overlap. Unknown costs are not treated as zero.</p></section><% end %>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-xl font-semibold">Workflow links</h2><div class="mt-4 flex flex-wrap gap-4 text-sm font-semibold"><%= link_to "Experiment", experiment_path(experiment), class: "text-blue-700" %><% if review_round %><%= link_to "Blind review", review_round_path(review_round), class: "text-blue-700" %><% end %><% if judge_round %><%= link_to "Judge results", judge_round_path(judge_round), class: "text-blue-700" %><% end %><% if experiment.final_translation %><%= link_to "Final translation", final_translation_path(experiment.final_translation), class: "text-blue-700" %><% end %></div></section>

  <% if @pipeline_run.running? || @pipeline_run.blocked? %><section class="rounded-xl border border-red-200 bg-red-50 p-6"><h2 class="text-xl font-semibold">Stop future automation</h2><p class="mt-2 text-sm">This prevents future automatic stages. It cannot cancel provider work already queued or running, deletes no history, and does not prevent manual continuation.</p><%= button_to "Stop automation", stop_pipeline_run_path(@pipeline_run), method: :patch, data: { turbo_confirm: "Stop all future automatic stages? Already queued or running provider work cannot be cancelled." }, class: "mt-4 rounded-lg bg-red-700 px-4 py-2 font-semibold text-white" %></section><% end %>
</div>
