<% content_for :title, t("pipelines_ui.title") %>
<% if @pipeline_run.running? %><% content_for :head do %><meta http-equiv="refresh" content="5"><% end %><% end %>
<% revision = @pipeline_run.workflow_profile_revision %>
<% experiment = @pipeline_run.experiment %>
<% review_round = experiment.review_round %>
<% judge_round = review_round&.judge_round %>
<div class="space-y-8">
  <% if experiment.methodology_profile_revision %><p class="rounded-lg bg-slate-100 px-4 py-3 text-sm text-slate-700"><span class="font-semibold"><%= t("pipelines_ui.methodology_snapshot") %>:</span> <%= link_to "#{experiment.methodology_profile_revision.name} · #{t("projects_ui.revision", version: experiment.methodology_profile_revision.version)}", methodology_profile_path(experiment.methodology_profile_revision.methodology_profile), class: "text-blue-700" %></p><% end %>
  <p class="rounded-lg bg-slate-100 px-4 py-3 text-sm text-slate-700"><span class="font-semibold"><%= t("projects_ui.guidance_preference") %>:</span> <%= localized_guidance_label(experiment.guidance_preference) %><% if experiment.experiment_reference_revisions.any? %><span class="ml-2"><span class="font-semibold"><%= t("projects_ui.references") %></span> <%= experiment.experiment_reference_revisions.map { |snapshot| "#{snapshot.translation_reference_revision.title} · #{t("projects_ui.revision", version: snapshot.translation_reference_revision.version)}" }.to_sentence %></span><% end %></p>
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"><div><p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("history_ui.automatic_pipeline") %></p><h1 class="mt-2 text-3xl font-bold"><%= revision.name %></h1><p class="mt-2 text-sm text-slate-600"><%= t("pipelines_ui.started", revision: t("glossaries_ui.revision", version: revision.version), mode: t("workflow_modes.#{@pipeline_run.completion_mode}"), at: l(@pipeline_run.started_at, format: :long)) %></p></div><span class="rounded-full px-3 py-1 text-sm font-semibold <%= status_badge_classes(@pipeline_run.status) %>"><%= localized_status(@pipeline_run.status) %></span></header>

  <%= render "shared/workflow_progress", experiment: experiment %>

  <%= link_to t("results_ui.back_project_arrow"), project_path(experiment.document.project), class: "inline-flex text-sm font-semibold text-blue-700 hover:text-blue-900" %>

  <% if @pipeline_run.blocked? %><section class="rounded-xl border border-amber-300 bg-amber-50 p-6"><h2 class="text-xl font-semibold"><%= t("pipelines_ui.blocked_at", stage: t("operations_ui.stages.#{@pipeline_run.blocked_stage}")) %></h2><p class="mt-2 text-sm"><%= t("pipelines_ui.blocked_reasons.#{@pipeline_run.blocked_reason_code}", default: t("pipelines_ui.blocked_generic")) %></p><p class="mt-2 text-sm font-semibold"><%= t("pipelines_ui.blocked_help") %></p></section><% end %>
  <% if @pipeline_run.ready_for_editor? %><section class="rounded-xl border border-emerald-300 bg-emerald-50 p-6"><h2 class="text-xl font-semibold"><%= t("pipelines_ui.ready_editor") %></h2><p class="mt-2 text-sm"><%= t("pipelines_ui.ready_help") %></p></section><% end %>
  <% if @pipeline_run.stopped? %><section class="rounded-xl border border-slate-300 bg-slate-100 p-6"><h2 class="text-xl font-semibold"><%= t("pipelines_ui.stopped") %></h2><p class="mt-2 text-sm"><%= t("pipelines_ui.stopped_help") %></p></section><% end %>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-xl font-semibold"><%= t("pipelines_ui.progress") %></h2><p class="mt-2 text-sm text-slate-600"><%= t("pipelines_ui.current_stage") %> <span class="font-semibold text-slate-900"><%= t("operations_ui.stages.#{@pipeline_run.current_stage}") %></span></p><ol class="mt-5 space-y-4 border-l-2 border-slate-200 pl-5"><% @pipeline_run.events.each do |event| %><li><p class="font-semibold"><%= t("pipelines_ui.events.#{event.event_type}", default: event.event_type.humanize) %></p><p class="text-xs text-slate-500"><%= l event.created_at, format: :long %><% if event.from_stage || event.to_stage %> · <%= [event.from_stage, event.to_stage].compact.map { |stage| t("operations_ui.stages.#{stage}") }.join(" → ") %><% end %></p></li><% end %></ol></section>

  <% work_plan = @pipeline_run.provider_work_plan %><% if work_plan.present? %><% attempts_per_slot = work_plan.dig("built_in_retry_policy", "maximum_attempts_per_slot") || Ai::ProviderRetryPolicy::MAX_ATTEMPTS_PER_AUTHORIZATION %><% maximum_requests = work_plan["maximum_automatic_provider_requests"] || work_plan.fetch("authorized_initial_provider_request_slots") * attempts_per_slot %><section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-xl font-semibold"><%= t("pipelines_ui.plan") %></h2><p class="mt-2 text-sm text-slate-600"><%= t("pipelines_ui.plan_intro", segments: work_plan.fetch("segment_count"), slots: work_plan.fetch("authorized_initial_provider_request_slots"), maximum: maximum_requests, attempts: attempts_per_slot) %></p><dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><% work_plan.fetch("roles").each do |role, details| %><div><dt class="text-sm text-slate-500"><%= t("workflows_ui.roles.#{role}") %></dt><dd class="font-semibold"><%= t("pipelines_ui.plan_role", logical: details.fetch("logical_run_count"), segments: work_plan.fetch("segment_count"), requests: details.fetch("provider_request_slots")) %></dd></div><% end %></dl></section><% end %>

  <% if @execution_summary.recent_failures.any? %>
    <section class="rounded-xl border border-amber-200 bg-amber-50 p-6 shadow-sm">
      <h2 class="text-xl font-semibold"><%= t("pipelines_ui.recent_failures") %></h2>
      <p class="mt-2 text-sm text-slate-700"><%= t("pipelines_ui.failure_intro") %></p>
      <ul class="mt-4 space-y-3 text-sm">
        <% @execution_summary.recent_failures.each do |attempt| %>
          <li class="rounded-lg border border-amber-200 bg-white p-4"><span class="font-semibold"><%= t("operations_ui.stages.#{attempt.stage}") %> · <%= attempt.display_name_snapshot %> · <%= t("pipelines_ui.attempt_number", number: attempt.attempt_number) %></span><span class="mt-1 block font-mono text-xs text-slate-600"><%= attempt.error_code %> · <%= l attempt.completed_at, format: :long %></span></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <details class="rounded-xl border border-slate-200 bg-slate-50 p-6">
    <summary class="cursor-pointer text-xl font-semibold"><%= t("shared_ui.technical_details") %></summary>
    <div class="mt-5 space-y-6">
      <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold"><%= t("pipelines_ui.execution_status") %></h2>
        <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div><dt class="text-sm text-slate-500"><%= t("pipelines_ui.logical_runs") %></dt><dd class="mt-1 font-semibold"><%= t("pipelines_ui.logical_progress", completed: @execution_summary.logical_status_counts.fetch("completed", 0), total: @execution_summary.logical_total) %></dd></div>
          <div><dt class="text-sm text-slate-500"><%= t("pipelines_ui.physical_slots") %></dt><dd class="mt-1 font-semibold"><%= t("pipelines_ui.physical_progress", completed: @execution_summary.physical_status_counts.fetch("completed", 0), total: @execution_summary.physical_total) %></dd></div>
          <div><dt class="text-sm text-slate-500"><%= t("pipelines_ui.attempts_started") %></dt><dd class="mt-1 font-semibold"><%= @execution_summary.attempt_total %></dd></div>
          <div><dt class="text-sm text-slate-500"><%= t("pipelines_ui.pending_running_failed") %></dt><dd class="mt-1 font-semibold"><%= @execution_summary.physical_status_counts.fetch("pending", 0) %> · <%= @execution_summary.physical_status_counts.fetch("running", 0) %> · <%= @execution_summary.physical_status_counts.fetch("failed", 0) %></dd></div>
          <div><dt class="text-sm text-slate-500"><%= t("pipelines_ui.known_tokens") %></dt><dd class="mt-1 font-semibold"><%= @execution_summary.known_total_tokens ? number_with_delimiter(@execution_summary.known_total_tokens) : t("common.not_available") %></dd><% if @execution_summary.token_telemetry_incomplete? %><p class="mt-1 text-xs font-medium text-amber-700"><%= t("pipelines_ui.token_coverage", known: @execution_summary.token_sample_count, total: @execution_summary.attempt_total) %></p><% end %></div>
          <div><dt class="text-sm text-slate-500"><%= t("pipelines_ui.known_attempt_cost") %></dt><dd class="mt-1 font-semibold"><%= analytics_money(@execution_summary.known_cost) %></dd><% if @execution_summary.cost_telemetry_incomplete? %><p class="mt-1 text-xs font-medium text-amber-700"><%= t("pipelines_ui.cost_coverage") %></p><% end %></div>
          <div><dt class="text-sm text-slate-500"><%= t("pipelines_ui.average_latency") %></dt><dd class="mt-1 font-semibold"><%= @execution_summary.average_latency_seconds ? "#{analytics_number(@execution_summary.average_latency_seconds)} s" : t("common.not_available") %></dd><p class="mt-1 text-xs text-slate-500">n=<%= @execution_summary.latency_sample_count %></p></div>
        </dl>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-xl font-semibold"><%= t("pipelines_ui.snapshots") %></h2><div class="mt-5 grid gap-5 lg:grid-cols-4"><% WorkflowProfileModelSelection::ROLES.each do |role| %><div><h3 class="font-semibold"><%= t("workflows_ui.roles.#{role}") %> (<%= revision.role_count(role) %>)</h3><ol class="mt-2 space-y-2 text-sm"><% revision.selections_for(role).each do |selection| %><li><%= selection.display_name_snapshot %><span class="block break-all text-xs text-slate-500"><%= selection.provider_snapshot %> · <%= selection.model_identifier_snapshot %></span></li><% end %></ol></div><% end %></div></section>

      <% if @execution_summary.attempt_coverage_incomplete? %><section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-xl font-semibold"><%= t("pipelines_ui.logical_coverage") %></h2><dl class="mt-4 grid gap-4 sm:grid-cols-3"><div><dt class="text-sm text-slate-500"><%= t("pipelines_ui.known_logical_total") %></dt><dd class="mt-1 font-semibold"><%= analytics_money(@cost_summary.known_cost) %></dd></div><div><dt class="text-sm text-slate-500"><%= t("pipelines_ui.logical_records") %></dt><dd class="mt-1 font-semibold"><%= @cost_summary.record_count %></dd></div><div><dt class="text-sm text-slate-500"><%= t("pipelines_ui.with_known_cost") %></dt><dd class="mt-1 font-semibold"><%= @cost_summary.known_count %></dd></div></dl><p class="mt-3 text-sm font-semibold text-amber-700"><%= t("pipelines_ui.coverage_help", tracked: @execution_summary.tracked_physical_run_count, total: @execution_summary.physical_total) %></p></section><% end %>
    </div>
  </details>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-xl font-semibold"><%= t("pipelines_ui.links") %></h2><div class="mt-4 flex flex-wrap gap-4 text-sm font-semibold"><%= link_to t("projects_ui.experiment"), experiment_path(experiment), class: "text-blue-700" %><% if review_round %><%= link_to t("projects_ui.blind_review"), review_round_path(review_round), class: "text-blue-700" %><% end %><% if judge_round %><%= link_to t("projects_ui.judge_results"), judge_round_path(judge_round), class: "text-blue-700" %><% end %><% if experiment.final_translation %><%= link_to t("pipelines_ui.final_translation"), final_translation_path(experiment.final_translation), class: "text-blue-700" %><% end %></div></section>

  <% if @pipeline_run.running? || @pipeline_run.blocked? %><section class="rounded-xl border border-red-200 bg-red-50 p-6"><h2 class="text-xl font-semibold"><%= t("pipelines_ui.stop_heading") %></h2><p class="mt-2 text-sm"><%= t("pipelines_ui.stop_help") %></p><%= button_to t("pipelines_ui.stop"), stop_pipeline_run_path(@pipeline_run), method: :patch, data: { turbo_confirm: t("pipelines_ui.stop_confirm") }, class: "mt-4 rounded-lg bg-red-700 px-4 py-2 font-semibold text-white" %></section><% end %>
</div>
