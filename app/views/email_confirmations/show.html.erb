<% content_for :title, t("email_confirmation.title") %>
<section class="mx-auto max-w-md">
  <h1 class="text-3xl font-semibold"><%= t("email_confirmation.title") %></h1>
  <% if @user && !@user.email_verified? %>
    <p class="mt-4 leading-7 text-slate-600"><%= t("email_confirmation.ready") %></p>
    <%= form_with url: email_confirmation_path, method: :post, class: "mt-7 space-y-5" do |form| %>
      <%= form.hidden_field :token, value: @token %>
      <div><%= form.label :password, t("registration.password"), class: "block text-sm font-medium" %><%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: User::MAXIMUM_PASSWORD_LENGTH, class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-3" %></div>
      <%= form.submit t("email_confirmation.confirm"), class: "w-full rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white" %>
    <% end %>
  <% else %>
    <p class="mt-4 text-slate-600"><%= t("email_confirmation.invalid") %></p>
    <%= link_to t("email_confirmation.resend"), new_confirmation_resend_path, class: "mt-5 inline-block font-semibold text-blue-700" %>
  <% end %>
</section>
