<% content_for :title, t("results_ui.review.title") %>
<% unless @review_round.terminal? %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="5">
  <% end %>
<% end %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("results_ui.review.heading") %></p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= @review_round.experiment.name.presence || @review_round.experiment.document.title %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= @review_round.experiment.document.project.name %> · <%= @review_round.experiment.document.project.source_language %> → <%= @review_round.experiment.document.project.target_language %></p>
    </div>
    <span class="inline-flex w-fit rounded-full px-3 py-1 text-sm font-semibold <%= status_badge_classes(@review_round.status) %>"><%= localized_status(@review_round.status) %></span>
  </header>

  <%= render "shared/workflow_progress", experiment: @review_round.experiment %>

  <% unless @review_round.terminal? %>
    <div class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800" role="status">
      <%= t("results_ui.review.running") %>
    </div>
  <% end %>

  <% failed_runs = @review_round.review_runs.select(&:failed?) %>
  <% if failed_runs.any? %>
    <section class="rounded-xl border border-amber-300 bg-amber-50 p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-slate-950"><%= t("results_ui.review.recover") %></h2>
      <p class="mt-2 text-sm text-slate-700"><%= t("results_ui.review.retry_intro", count: failed_runs.size, attempts: Ai::ProviderRetryPolicy::MAX_ATTEMPTS_PER_AUTHORIZATION) %></p>
      <% if failed_runs.all? { |run| run.reviewer_llm_model.active? && run.reviewer_llm_model.gateway == "openrouter" } %>
        <%= button_to t("results_ui.review.retry"), retry_failed_review_round_path(@review_round), method: :post, data: { turbo_confirm: t("results_ui.review.retry_confirm", attempts: Ai::ProviderRetryPolicy::MAX_ATTEMPTS_PER_AUTHORIZATION), turbo_submits_with: t("results_ui.queueing_retries") }, class: "mt-4 rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white hover:bg-amber-800" %>
      <% else %>
        <p class="mt-3 text-sm font-semibold text-amber-900"><%= t("results_ui.review.retry_unavailable") %></p>
      <% end %>
    </section>
  <% end %>

  <div class="flex">
    <%= link_to t("results_ui.back_project"), project_path(@review_round.experiment.document.project), class: "text-sm font-semibold text-blue-700 hover:text-blue-900" %>
    <%= link_to t("results_ui.back_translation"), @review_round.experiment, class: "ml-5 text-sm font-semibold text-blue-700 hover:text-blue-900" %>
  </div>

  <section class="space-y-6">
    <h2 class="text-xl font-semibold text-slate-950"><%= t("results_ui.review.runs") %></h2>

    <% @review_round.review_runs.sort_by { |run| [run.reviewer_llm_model.display_name, run.id] }.each do |review_run| %>
      <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= t("results_ui.review.reviewer") %></p>
            <h3 class="mt-1 text-lg font-semibold text-slate-950"><%= review_run.reviewer_llm_model.display_name %></h3>
            <p class="mt-1 break-all font-mono text-xs text-slate-600"><%= review_run.reviewer_llm_model.model_identifier %></p>
          </div>
          <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(review_run.status) %>"><%= localized_status(review_run.status) %></span>
        </div>

        <% if review_run.review_segment_runs.any? %><p class="mt-4 rounded-lg bg-blue-50 px-4 py-3 text-sm text-blue-900"><%= t("results_ui.segmented") %>: <strong><%= review_run.review_segment_runs.count(&:completed?) %> / <%= review_run.review_segment_runs.size %></strong> <%= t("results_ui.provider_requests_complete") %></p><% end %>

        <% if review_run.failed? %>
          <div class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
            <p class="font-semibold"><%= t("results_ui.review.failed") %></p>
            <% if review_run.error_code.present? %>
              <p class="mt-1"><%= t("results_ui.error_code") %>: <span class="font-mono"><%= safe_provider_error_code(review_run.error_code) %></span></p>
            <% end %>
            <% if review_run.error_message.present? %>
              <p class="mt-1 break-words"><%= safe_provider_error(review_run.error_message) %></p>
            <% end %>
          </div>
        <% elsif !review_run.completed? %>
          <p class="mt-5 rounded-lg bg-slate-50 p-4 text-sm text-slate-600">
            <%= review_run.running? ? t("results_ui.review.run_running") : t("results_ui.review.run_pending") %>
          </p>
        <% end %>

        <% if review_run.completed? %>
          <div class="mt-6 space-y-5">
            <% review_run.review_evaluations.sort_by(&:anonymous_label).each do |evaluation| %>
              <section class="rounded-lg border border-slate-200 p-5">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <h4 class="font-semibold text-slate-950"><%= evaluation.anonymous_label %></h4>
                    <p class="mt-1 text-sm text-slate-600">
                      <%= t("results_ui.human_mapping") %>: <span class="font-semibold text-slate-800"><%= evaluation.translation_run.llm_model.display_name %></span>
                      · <span class="font-mono text-xs"><%= evaluation.translation_run.llm_model.model_identifier %></span>
                    </p>
                  </div>
                  <span class="text-lg font-bold text-blue-800"><%= evaluation.overall_score %>/10 <%= t("results_ui.overall") %></span>
                </div>

                <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
                  <% {
                       t("results_ui.review.faithfulness") => evaluation.faithfulness_score,
                       t("results_ui.review.naturalness") => evaluation.naturalness_score,
                       t("results_ui.review.terminology") => evaluation.terminology_score,
                       t("results_ui.review.instruction_adherence") => evaluation.instruction_adherence_score
                     }.each do |label, score| %>
                    <div class="rounded-md bg-slate-50 px-3 py-2">
                      <dt class="text-slate-500"><%= label %></dt>
                      <dd class="font-semibold text-slate-900"><%= score %>/10</dd>
                    </div>
                  <% end %>
                </dl>

                <div class="mt-5 grid gap-4 lg:grid-cols-3">
                  <div>
                    <h5 class="text-sm font-semibold text-emerald-800"><%= t("results_ui.strengths") %></h5>
                    <p class="mt-1 whitespace-pre-wrap break-words text-sm leading-6 text-slate-800"><%= evaluation.strengths %></p>
                  </div>
                  <div>
                    <h5 class="text-sm font-semibold text-red-800"><%= t("results_ui.issues") %></h5>
                    <p class="mt-1 whitespace-pre-wrap break-words text-sm leading-6 text-slate-800"><%= evaluation.issues %></p>
                  </div>
                  <div>
                    <h5 class="text-sm font-semibold text-blue-800"><%= t("results_ui.corrections") %></h5>
                    <p class="mt-1 whitespace-pre-wrap break-words text-sm leading-6 text-slate-800"><%= evaluation.recommended_corrections %></p>
                  </div>
                </div>

                <details class="mt-5 rounded-lg bg-slate-50 p-4">
                  <summary class="cursor-pointer text-sm font-semibold text-slate-800"><%= t("results_ui.candidate_translation") %></summary>
                  <div class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-slate-900"><%= evaluation.translation_run.translated_text %></div>
                </details>

                <% if evaluation.suggested_translation.present? %>
                  <details class="mt-3 rounded-lg bg-blue-50 p-4">
                    <summary class="cursor-pointer text-sm font-semibold text-blue-900"><%= t("results_ui.suggested_translation") %></summary>
                    <div class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-slate-900"><%= evaluation.suggested_translation %></div>
                  </details>
                <% end %>
              </section>
            <% end %>
          </div>
        <% end %>

        <%= render "shared/ai_usage", run: review_run %>
      </article>
    <% end %>
  </section>

  <% if @review_round.judge_round %>
    <section class="rounded-xl border border-blue-200 bg-blue-50 p-6 shadow-sm">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-xl font-semibold text-slate-950"><%= t("results_ui.judge.heading") %></h2>
          <p class="mt-2 text-sm text-slate-700"><%= t("results_ui.review.judge_exists") %></p>
        </div>
        <%= link_to t("results_ui.review.view_judge"), @review_round.judge_round, class: "inline-flex w-fit rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800" %>
      </div>
    </section>
  <% elsif @review_round.completed? %>
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-slate-950"><%= t("results_ui.review.start_judge") %></h2>
      <p class="mt-2 max-w-3xl text-sm text-slate-600">
        <%= t("results_ui.review.judge_intro", maximum: Ai::UsageLimits::MAX_JUDGES) %>
      </p>
      <% if @review_round.experiment.document_execution_plan %><p class="mt-2 text-sm font-semibold text-amber-800"><%= t("results_ui.review.segment_cost", count: @review_round.experiment.document_execution_plan.segment_count) %></p><% end %>

      <%= form_with url: review_round_judge_rounds_path(@review_round), scope: :judge_round, class: "mt-5 space-y-5" do |form| %>
        <% if @judge_models.any? %>
          <fieldset>
            <legend class="text-sm font-semibold text-slate-800"><%= t("results_ui.review.active_judges") %></legend>
            <div class="mt-3 grid gap-3 md:grid-cols-2">
              <% @judge_models.each do |judge| %>
                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/40">
                  <%= check_box_tag "judge_round[judge_ids][]", judge.id, false, id: "judge_round_judge_ids_#{judge.id}", class: "mt-1 size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
                  <span>
                    <span class="block font-medium text-slate-900"><%= judge.display_name %></span>
                    <span class="mt-1 block text-xs text-slate-500"><%= judge.provider %> · <%= judge.model_identifier %></span>
                  </span>
                </label>
              <% end %>
            </div>
          </fieldset>
        <% else %>
          <p class="rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800"><%= t("results_ui.review.no_judges") %></p>
        <% end %>

        <%= form.submit t("results_ui.review.start_judge_button"), disabled: @judge_models.empty?, class: "rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white shadow-sm hover:bg-blue-800 disabled:cursor-not-allowed disabled:bg-slate-400", data: { turbo_confirm: t("results_ui.review.start_judge_confirm"), turbo_submits_with: t("results_ui.review.starting_judge") } %>
      <% end %>
    </section>
  <% end %>
</div>
