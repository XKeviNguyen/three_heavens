<% content_for :title, "Judge selection · Three Heavens" %>
<% unless @judge_round.terminal? %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="5">
  <% end %>
<% end %>

<% experiment = @judge_round.experiment %>
<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Judge selection</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= experiment.name.presence || experiment.document.title %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= experiment.document.project.name %> · <%= experiment.document.project.source_language %> → <%= experiment.document.project.target_language %></p>
    </div>
    <span class="inline-flex w-fit rounded-full px-3 py-1 text-sm font-semibold <%= status_badge_classes(@judge_round.status) %>"><%= @judge_round.status.humanize %></span>
  </header>

  <% unless @judge_round.terminal? %>
    <div class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800" role="status">
      Judges are evaluating the translations. This page refreshes automatically every 5 seconds.
    </div>
  <% end %>

  <div class="flex">
    <%= link_to "Back to blind review", @judge_round.review_round, class: "text-sm font-semibold text-blue-700 hover:text-blue-900" %>
  </div>

  <% if @judge_round.completed? %>
    <% winner = @judge_round.winner_translation_run %>
    <section class="rounded-xl border border-emerald-200 bg-emerald-50 p-6 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-emerald-800">Official aggregate winner</p>
      <h2 class="mt-2 text-2xl font-bold text-slate-950"><%= winner.llm_model.display_name %></h2>
      <p class="mt-1 break-all font-mono text-xs text-slate-600"><%= winner.llm_model.model_identifier %></p>
      <div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-white/70 p-4 text-sm leading-6 text-slate-900"><%= winner.translated_text %></div>
      <p class="mt-4 text-sm text-slate-700"><%= @judge_round.aggregation_explanation %></p>

      <ol class="mt-5 space-y-3">
        <% @judge_round.aggregate_rankings.sort_by { |ranking| ranking.fetch("aggregate_rank") }.each do |ranking| %>
          <% translation = experiment.translation_runs.find { |run| run.id == ranking.fetch("translation_run_id") } %>
          <li class="rounded-lg border border-emerald-100 bg-white p-4 text-sm">
            <span class="font-semibold text-slate-950">#<%= ranking.fetch("aggregate_rank") %> · <%= translation.llm_model.display_name %></span>
            <span class="mt-1 block text-slate-600"><%= ranking.fetch("borda_points") %> Borda points · <%= ranking.fetch("mean_overall_score") %>/100 mean score · <%= ranking.fetch("judge_count") %> judge(s)</span>
          </li>
        <% end %>
      </ol>
    </section>
  <% elsif @judge_round.failed? %>
    <section class="rounded-xl border border-red-200 bg-red-50 p-6 text-sm text-red-800">
      <h2 class="font-semibold">No official aggregate winner</h2>
      <p class="mt-2">At least one judge failed. Successful sibling judgments are preserved below, but the round does not declare an official winner.</p>
    </section>
  <% end %>

  <section class="space-y-6">
    <h2 class="text-xl font-semibold text-slate-950">Judge runs</h2>

    <% @judge_round.judge_runs.sort_by { |run| [run.judge_llm_model.display_name, run.id] }.each do |judge_run| %>
      <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Judge</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-950"><%= judge_run.judge_llm_model.display_name %></h3>
            <p class="mt-1 break-all font-mono text-xs text-slate-600"><%= judge_run.judge_llm_model.model_identifier %></p>
          </div>
          <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(judge_run.status) %>"><%= judge_run.status.humanize %></span>
        </div>

        <% if judge_run.failed? %>
          <div class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
            <p class="font-semibold">Judge failed</p>
            <% if judge_run.error_code.present? %>
              <p class="mt-1">Error code: <span class="font-mono"><%= judge_run.error_code %></span></p>
            <% end %>
            <% if judge_run.error_message.present? %>
              <p class="mt-1 break-words"><%= safe_provider_error(judge_run.error_message) %></p>
            <% end %>
          </div>
        <% elsif !judge_run.completed? %>
          <p class="mt-5 rounded-lg bg-slate-50 p-4 text-sm text-slate-600">
            <%= judge_run.running? ? "This judge is ranking the anonymous candidates now." : "This judgment is queued and waiting to start." %>
          </p>
        <% end %>

        <% if judge_run.completed? %>
          <div class="mt-5 rounded-lg border border-blue-100 bg-blue-50 p-4 text-sm text-slate-800">
            <p><span class="font-semibold">Judge winner:</span> <%= judge_run.winner_translation_run.llm_model.display_name %></p>
            <p class="mt-2 whitespace-pre-wrap break-words"><%= judge_run.winner_rationale %></p>
            <p class="mt-2 text-slate-600">Confidence: <%= judge_run.confidence_score %>/100</p>
          </div>

          <div class="mt-5 space-y-4">
            <% judge_run.judge_evaluations.sort_by(&:rank).each do |evaluation| %>
              <section class="rounded-lg border border-slate-200 p-5">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <h4 class="font-semibold text-slate-950">#<%= evaluation.rank %> · <%= evaluation.anonymous_label %></h4>
                    <p class="mt-1 text-sm text-slate-600">Human-only mapping: <span class="font-semibold text-slate-800"><%= evaluation.translation_run.llm_model.display_name %></span> · <span class="font-mono text-xs"><%= evaluation.translation_run.llm_model.model_identifier %></span></p>
                  </div>
                  <span class="text-lg font-bold text-blue-800"><%= evaluation.overall_score %>/100</span>
                </div>
                <div class="mt-4 grid gap-4 lg:grid-cols-3">
                  <div><h5 class="text-sm font-semibold text-slate-800">Rationale</h5><p class="mt-1 whitespace-pre-wrap break-words text-sm leading-6 text-slate-700"><%= evaluation.rationale %></p></div>
                  <div><h5 class="text-sm font-semibold text-emerald-800">Strengths</h5><p class="mt-1 whitespace-pre-wrap break-words text-sm leading-6 text-slate-700"><%= evaluation.strengths %></p></div>
                  <div><h5 class="text-sm font-semibold text-red-800">Risks</h5><p class="mt-1 whitespace-pre-wrap break-words text-sm leading-6 text-slate-700"><%= evaluation.risks %></p></div>
                </div>
                <details class="mt-4 rounded-lg bg-slate-50 p-4">
                  <summary class="cursor-pointer text-sm font-semibold text-slate-800">Candidate translation</summary>
                  <div class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-slate-900"><%= evaluation.translation_run.translated_text %></div>
                </details>
              </section>
            <% end %>
          </div>
        <% end %>

        <% telemetry = {
             "Prompt tokens" => judge_run.prompt_tokens,
             "Completion tokens" => judge_run.completion_tokens,
             "Total tokens" => judge_run.total_tokens,
             "Cost" => (number_to_currency(judge_run.cost, unit: "$", precision: 10, strip_insignificant_zeros: true) unless judge_run.cost.nil?)
           }.compact %>
        <% if telemetry.any? %>
          <dl class="mt-5 grid gap-3 border-t border-slate-100 pt-4 text-sm sm:grid-cols-4">
            <% telemetry.each do |label, value| %>
              <div><dt class="text-slate-500"><%= label %></dt><dd class="font-medium text-slate-900"><%= value %></dd></div>
            <% end %>
          </dl>
        <% end %>
      </article>
    <% end %>
  </section>
</div>
