<% content_for :title, "Upload source file · Three Heavens" %>

<%= turbo_frame_tag "source-import-upload" do %>
  <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
    <p class="text-sm font-semibold text-slate-900">Upload a source file</p>
    <% if @project %><p class="mt-1 text-xs text-slate-500">Project: <%= @project.name %> · <%= @project.source_language %> → <%= @project.target_language %></p><% end %>
    <p class="mt-2 text-xs text-slate-500">TXT, Markdown, or DOCX up to <%= SourceImports::Limits::MAX_UPLOAD_BYTES / 1.megabyte %> MiB. Uploading and previewing never contacts an AI provider.</p>

    <%= form_with model: @source_import || SourceImport.new, url: source_imports_path, method: :post, class: "mt-4 space-y-4", data: { turbo_frame: "_top" } do |form| %>
      <% if @project %><%= hidden_field_tag "source_import[project_id]", @project.id %><% end %>
      <div>
        <%= form.label :source_file, "Source file (.txt, .md, or .docx)", class: "block text-xs font-semibold text-slate-700" %>
        <%= form.file_field :source_file, required: true, accept: ".txt,.md,.docx,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document", class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm" %>
      </div>
      <%= form.submit "Upload and review", class: "rounded-xl bg-blue-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-800 disabled:cursor-wait disabled:bg-blue-400", data: { turbo_submits_with: "Extracting source…" } %>
    <% end %>
    <p class="mt-3 text-xs text-slate-400">Legacy DOC, DOCM/macros, PDF, ODT, RTF, HTML, images/OCR, embedded Office objects, and arbitrary ZIP files are intentionally unsupported.</p>
  </div>
<% end %>
