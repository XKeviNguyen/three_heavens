<% content_for :title, "Upload source file · Three Heavens" %>

<div class="mx-auto max-w-2xl">
  <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Source import</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Upload a source file</h1>
  <p class="mt-3 text-slate-600">Upload a UTF-8 TXT or Markdown file, or a DOCX file up to <%= SourceImports::Limits::MAX_UPLOAD_BYTES / 1.megabyte %> MiB. Uploading and previewing never contacts an AI provider.</p>

  <%= form_with model: @source_import || SourceImport.new, url: source_imports_path, method: :post, class: "mt-8 space-y-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm" do |form| %>
    <div>
      <%= form.label :source_file, "Source file (.txt, .md, or .docx)", class: "block text-sm font-semibold text-slate-800" %>
      <%= form.file_field :source_file, required: true, accept: ".txt,.md,.docx,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document", class: "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= form.submit "Upload and preview", class: "rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white shadow-sm hover:bg-blue-800" %>
      <%= link_to "Back to pasted text", root_path, class: "rounded-lg border border-slate-300 px-5 py-3 font-semibold text-slate-700 hover:bg-slate-50" %>
    </div>
  <% end %>

  <p class="mt-6 text-sm text-slate-500">Legacy DOC, DOCM, RTF, HTML, ODT, PDF, images, and archives are not supported. Markdown is handled only as source text and is never rendered as trusted HTML.</p>
</div>
