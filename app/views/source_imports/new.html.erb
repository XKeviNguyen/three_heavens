<% content_for :title, t("shared_ui.upload.title") %>

<%= turbo_frame_tag "source-import-upload" do %>
  <div data-controller="file-drop"
       class="rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 p-6 text-center"
       data-file-drop-target="dropzone"
       data-action="dragover->file-drop#dragover dragleave->file-drop#dragleave drop->file-drop#drop">
    <% if @project %><p class="mb-3 text-xs font-medium text-slate-500"><%= @project.name %> · <%= @project.source_language %> → <%= @project.target_language %></p><% end %>

    <span class="mx-auto flex size-11 items-center justify-center rounded-2xl bg-white text-slate-500 shadow-sm ring-1 ring-slate-200" aria-hidden="true">
      <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10 13V3.5"/><path stroke-linecap="round" stroke-linejoin="round" d="m6.5 7 3.5-3.5L13.5 7"/><path stroke-linecap="round" d="M4 13.5v1.5A1.5 1.5 0 0 0 5.5 16.5h9A1.5 1.5 0 0 0 16 15v-1.5"/></svg>
    </span>

    <%= form_with model: @source_import || SourceImport.new, url: source_imports_path, method: :post, class: "contents", data: { file_drop_target: "form", turbo_frame: "_top" } do |form| %>
      <% if @project %><%= hidden_field_tag "source_import[project_id]", @project.id %><% end %>
      <%= hidden_field_tag "source_import[request_key]", SecureRandom.hex(16), id: nil %>
      <%= form.label :source_file, t("workspace_ui.source_file"), class: "sr-only" %>
      <%= form.file_field :source_file,
            class: "sr-only",
            accept: ".txt,.md,.docx,.pdf,application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            data: { file_drop_target: "input", action: "change->file-drop#changed" } %>
      <%= form.submit t("workspace_ui.upload_review"), class: "mt-3 inline-flex rounded-xl bg-blue-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-800 disabled:cursor-wait disabled:bg-blue-400", data: { turbo_submits_with: t("shared_ui.upload.extracting") } %>
    <% end %>

    <p class="mt-3 text-sm font-semibold text-slate-900"><%= t("shared_ui.upload.drop") %></p>
    <p class="mt-0.5 text-xs text-slate-500"><%= t("shared_ui.upload.or") %></p>
    <button type="button" data-action="file-drop#browse" class="mt-1.5 inline-flex rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"><%= t("shared_ui.upload.choose") %></button>
    <p class="mt-3 text-xs text-slate-500"><%= t("shared_ui.upload.formats") %></p>
    <p class="mt-0.5 text-xs text-slate-500"><%= t("shared_ui.upload.limit", maximum: SourceImports::Limits::MAX_UPLOAD_BYTES / 1.megabyte) %></p>
    <p data-file-drop-target="filename" class="mt-2 text-xs font-medium text-emerald-700" role="status" aria-live="polite"></p>

  </div>
<% end %>
