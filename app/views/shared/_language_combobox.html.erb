<%# locals: form:, method:, label:, value:, hint:, required: true %>
<% required = local_assigns.fetch(:required, true) %>
<% field_id = "#{form.object_name}_#{method}" %>
<div>
  <div class="flex items-center gap-1.5">
    <%= form.label method, label, class: "block text-sm font-medium text-slate-700" %>
    <%= render "shared/hint", text: hint, label: label %>
  </div>
  <div class="relative mt-1.5 min-w-0" data-controller="combobox">
    <%= form.text_field method,
          value: value,
          required: required,
          maxlength: 100,
          autocomplete: "off",
          role: "combobox",
          aria: { expanded: "false", autocomplete: "list", controls: "#{field_id}-list" },
          data: {
            combobox_target: "input",
            action: "input->combobox#filter focus->combobox#filter keydown->combobox#keydown"
          },
          class: "block w-full min-w-0 rounded-xl border border-slate-300 bg-white py-2.5 pl-3 pr-10 text-sm text-slate-900 shadow-sm transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
    <button type="button"
            tabindex="-1"
            data-action="mousedown->combobox#toggle"
            aria-label="Show <%= label %> suggestions"
            class="absolute inset-y-0 right-0 flex w-9 items-center justify-center rounded-r-xl text-slate-400 hover:text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">
      <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 8 4 4 4-4"/></svg>
    </button>
    <ul id="<%= field_id %>-list"
        data-combobox-target="list"
        role="listbox"
        aria-label="<%= label %> suggestions"
        class="absolute z-30 mt-1 hidden max-h-72 w-full overflow-auto rounded-xl border border-slate-200 bg-white py-1 shadow-lg">
      <% TranslationLanguage::COMMON.each_with_index do |language, index| %>
        <li id="<%= field_id %>-option-<%= index %>"
            role="option"
            data-combobox-target="option"
            data-value="<%= language[:name] %>"
            data-action="mousedown->combobox#choose"
            class="flex cursor-pointer items-center justify-between gap-3 px-3 py-2 text-sm text-slate-700 hover:bg-blue-50">
          <span><%= language[:name] %></span>
          <span class="text-xs text-slate-400"><%= language[:native] %></span>
        </li>
      <% end %>
    </ul>
  </div>
</div>
