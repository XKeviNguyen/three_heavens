<% selector_context = local_assigns.fetch(:context, :default) %>
<%= form_with url: locale_path, method: :patch, class: [ "locale-selector", ("public-locale-selector" if selector_context == :public), "grid w-full min-w-0 grid-cols-1 items-center gap-1 text-sm", ].compact.join(" "), data: { controller: "locale-select" } do |form| %>
  <%= form.label :locale_code, t("common.interface_language"), class: "min-w-0 font-medium leading-5 text-slate-600" %>
  <%= form.select :locale_code, [["English", "en"], ["Tiếng Việt", "vi"], ["日本語", "ja"]], { selected: I18n.locale.to_s }, class: "min-w-0 w-full rounded-lg border border-slate-300 bg-white px-2 py-2 text-slate-800", data: { locale_select_target: "select", action: "change->locale-select#switch" } %>
<% end %>
