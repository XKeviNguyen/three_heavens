<% content_for :title, t("results_ui.translation.title") %>
<% unless @experiment.completed? || @experiment.failed? %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="5">
  <% end %>
<% end %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700"><%= t("results_ui.translation.heading") %></p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= @experiment.name.presence || @experiment.document.title %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= @experiment.document.project.name %> · <%= @experiment.document.project.source_language %> → <%= @experiment.document.project.target_language %></p>
      <% if @experiment.glossary_revision %><p class="mt-1 text-sm text-slate-600"><%= t("results_ui.glossary") %> <%= link_to "#{@experiment.glossary_revision.name} · #{t("projects_ui.revision", version: @experiment.glossary_revision.version)}", glossary_path(@experiment.glossary_revision.glossary), class: "text-blue-700" %></p><% end %>
      <% if @experiment.methodology_profile_revision %><p class="mt-1 text-sm text-slate-600"><%= t("projects_ui.methodology") %> <%= link_to "#{@experiment.methodology_profile_revision.name} · #{t("projects_ui.revision", version: @experiment.methodology_profile_revision.version)}", methodology_profile_path(@experiment.methodology_profile_revision.methodology_profile), class: "text-blue-700" %></p><% end %>
      <p class="mt-1 text-sm text-slate-600"><%= t("projects_ui.guidance_preference") %>: <%= localized_guidance_label(@experiment.guidance_preference) %></p>
      <% if @experiment.experiment_reference_revisions.any? %>
        <p class="mt-1 text-sm text-slate-600"><%= t("projects_ui.references") %> <%= @experiment.experiment_reference_revisions.map { |snapshot| "#{snapshot.translation_reference_revision.title} · #{t("projects_ui.revision", version: snapshot.translation_reference_revision.version)}" }.to_sentence %></p>
      <% end %>
    </div>
    <span class="inline-flex w-fit rounded-full px-3 py-1 text-sm font-semibold <%= status_badge_classes(@experiment.status) %>"><%= localized_status(@experiment.status) %></span>
  </header>

  <%= render "shared/workflow_progress", experiment: @experiment %>

  <%= link_to t("results_ui.back_project_arrow"), project_path(@experiment.document.project), class: "inline-flex text-sm font-semibold text-blue-700 hover:text-blue-900" %>
  <%= link_to t("history_ui.repeat_configuration"), repeat_experiment_path(@experiment), class: "ml-4 inline-flex text-sm font-semibold text-blue-700 hover:text-blue-900" %>

  <% if @experiment.pipeline_run %>
    <div class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-900"><span class="font-semibold"><%= t("history_ui.automatic_pipeline") %>:</span> <%= @experiment.pipeline_run.workflow_profile_revision.name %> · <%= t("projects_ui.revision", version: @experiment.pipeline_run.workflow_profile_revision.version) %> · <%= link_to t("results_ui.view_pipeline"), pipeline_run_path(@experiment.pipeline_run), class: "font-semibold underline" %></div>
  <% end %>

  <% unless @experiment.completed? || @experiment.failed? %>
    <div class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800" role="status">
      <%= t("results_ui.translation.running") %>
    </div>
  <% end %>

  <% failed_runs = @experiment.translation_runs.select(&:failed?) %>
  <% if failed_runs.any? %>
    <section class="rounded-xl border border-amber-300 bg-amber-50 p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-slate-950"><%= t("results_ui.translation.recover") %></h2>
      <p class="mt-2 text-sm text-slate-700"><%= t("results_ui.translation.retry_intro", count: failed_runs.size, attempts: Ai::ProviderRetryPolicy::MAX_ATTEMPTS_PER_AUTHORIZATION) %></p>
      <% if failed_runs.all? { |run| run.llm_model.active? && run.llm_model.gateway == "openrouter" } %>
        <%= button_to t("results_ui.translation.retry"), retry_failed_experiment_path(@experiment), method: :post, data: { turbo_confirm: t("results_ui.translation.retry_confirm", attempts: Ai::ProviderRetryPolicy::MAX_ATTEMPTS_PER_AUTHORIZATION), turbo_submits_with: t("results_ui.queueing_retries") }, class: "mt-4 rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white hover:bg-amber-800" %>
      <% else %>
        <p class="mt-3 text-sm font-semibold text-amber-900"><%= t("results_ui.translation.retry_unavailable") %></p>
      <% end %>
    </section>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950"><%= t("results_ui.source_document") %></h2>
      <p class="mt-1 text-sm font-medium text-slate-600"><%= @experiment.document.title %></p>
      <% if @experiment.document.uploaded_file? %>
        <p class="mt-1 text-sm text-slate-600"><%= t("results_ui.uploaded_file") %> · <%= @experiment.document.original_filename %> · <%= @experiment.document.source_format.upcase %> · <%= number_to_human_size(@experiment.document.original_byte_size) %></p>
        <%= link_to t("results_ui.original_file"), download_original_document_path(@experiment.document), class: "mt-3 inline-flex text-sm font-semibold text-blue-700 hover:text-blue-900" %>
      <% else %>
        <p class="mt-1 text-sm text-slate-600"><%= t("results_ui.pasted_source") %></p>
      <% end %>
      <div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-800"><%= @experiment.document.source_text %></div>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950"><%= t("results_ui.translation_instruction") %></h2>
      <div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-800"><%= @experiment.instruction_prompt %></div>
    </section>
  </div>

  <section>
    <h2 class="text-xl font-semibold text-slate-950"><%= t("results_ui.translation.model_runs") %></h2>
    <div class="mt-4 space-y-5">
      <% @experiment.translation_runs.sort_by { |run| [run.llm_model.display_name, run.id] }.each do |run| %>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="font-semibold text-slate-950"><%= run.llm_model.display_name %></h3>
              <dl class="mt-2 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
                <div>
                  <dt class="text-slate-500"><%= t("results_ui.requested_model") %></dt>
                  <dd class="break-all font-mono text-xs text-slate-800"><%= run.llm_model.model_identifier %></dd>
                </div>
                <% if run.resolved_model_identifier.present? %>
                  <div>
                    <dt class="text-slate-500"><%= t("results_ui.resolved_model") %></dt>
                    <dd class="break-all font-mono text-xs text-slate-800"><%= run.resolved_model_identifier %></dd>
                  </div>
                <% end %>
              </dl>
            </div>
            <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(run.status) %>"><%= localized_status(run.status) %></span>
          </div>

          <% if run.translation_segment_runs.any? %>
            <% completed_segments = run.translation_segment_runs.count(&:completed?) %>
            <p class="mt-4 rounded-lg bg-blue-50 px-4 py-3 text-sm text-blue-900"><%= t("results_ui.segmented") %>: <strong><%= completed_segments %> / <%= run.translation_segment_runs.size %></strong> <%= t("results_ui.provider_requests_complete") %></p>
          <% end %>

          <% if run.completed? %>
            <div class="mt-5 whitespace-pre-wrap break-words rounded-lg border border-emerald-100 bg-emerald-50/50 p-4 text-sm leading-6 text-slate-900"><%= run.translated_text %></div>
          <% elsif run.failed? %>
            <div class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
              <p class="font-semibold"><%= t("results_ui.translation.failed") %></p>
              <% if run.error_code.present? %>
                <p class="mt-1"><%= t("results_ui.error_code") %>: <span class="font-mono"><%= safe_provider_error_code(run.error_code) %></span></p>
              <% end %>
              <% if run.error_message.present? %>
                <p class="mt-1 break-words"><%= safe_provider_error(run.error_message) %></p>
              <% end %>
            </div>
          <% else %>
            <p class="mt-5 rounded-lg bg-slate-50 p-4 text-sm text-slate-600">
              <%= run.running? ? t("results_ui.translation.run_running") : t("results_ui.translation.run_pending") %>
            </p>
          <% end %>

          <%= render "shared/ai_usage", run: run %>
        </article>
      <% end %>
    </div>
  </section>

  <% completed_candidates = @experiment.translation_runs.select { |run| run.completed? && run.translated_text.present? } %>
  <% if @experiment.review_round %>
    <section class="rounded-xl border border-blue-200 bg-blue-50 p-6 shadow-sm">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-xl font-semibold text-slate-950"><%= t("results_ui.review.heading") %></h2>
          <p class="mt-2 text-sm text-slate-700"><%= t("results_ui.translation.review_exists") %></p>
        </div>
        <%= link_to t("results_ui.translation.view_review"), @experiment.review_round, class: "inline-flex w-fit rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800" %>
      </div>
    </section>
  <% elsif @experiment.completed? && completed_candidates.size >= 2 %>
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-slate-950"><%= t("results_ui.translation.start_review") %></h2>
      <p class="mt-2 max-w-3xl text-sm text-slate-600">
        <%= t("results_ui.translation.review_intro", maximum: Ai::UsageLimits::MAX_REVIEWERS) %>
      </p>
      <% if @experiment.document_execution_plan %><p class="mt-2 text-sm font-semibold text-amber-800"><%= t("results_ui.translation.segment_cost", count: @experiment.document_execution_plan.segment_count) %></p><% end %>

      <%= form_with url: experiment_review_rounds_path(@experiment), scope: :review_round, class: "mt-5 space-y-5" do |form| %>
        <% if @reviewer_models.any? %>
          <fieldset>
            <legend class="text-sm font-semibold text-slate-800"><%= t("results_ui.translation.active_reviewers") %></legend>
            <div class="mt-3 grid gap-3 md:grid-cols-2">
              <% @reviewer_models.each do |reviewer| %>
                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/40">
                  <%= check_box_tag "review_round[reviewer_ids][]", reviewer.id, false, id: "review_round_reviewer_ids_#{reviewer.id}", class: "mt-1 size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
                  <span>
                    <span class="block font-medium text-slate-900"><%= reviewer.display_name %></span>
                    <span class="mt-1 block text-xs text-slate-500"><%= reviewer.provider %> · <%= reviewer.model_identifier %></span>
                  </span>
                </label>
              <% end %>
            </div>
          </fieldset>
        <% else %>
          <p class="rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800"><%= t("results_ui.translation.no_reviewers") %></p>
        <% end %>

        <%= form.submit t("results_ui.translation.start_review_button"), disabled: @reviewer_models.empty?, class: "rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white shadow-sm hover:bg-blue-800 disabled:cursor-not-allowed disabled:bg-slate-400", data: { turbo_confirm: t("results_ui.translation.start_review_confirm"), turbo_submits_with: t("results_ui.translation.starting_review") } %>
      <% end %>
    </section>
  <% end %>
</div>
