<% content_for :title, "Translation experiment · Three Heavens" %>
<% unless @experiment.completed? || @experiment.failed? %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="5">
  <% end %>
<% end %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">Translation experiment</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950"><%= @experiment.name.presence || @experiment.document.title %></h1>
      <p class="mt-2 text-sm text-slate-600"><%= @experiment.document.project.name %> · <%= @experiment.document.project.source_language %> → <%= @experiment.document.project.target_language %></p>
    </div>
    <span class="inline-flex w-fit rounded-full px-3 py-1 text-sm font-semibold <%= status_badge_classes(@experiment.status) %>"><%= @experiment.status.humanize %></span>
  </header>

  <% unless @experiment.completed? || @experiment.failed? %>
    <div class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800" role="status">
      Translation runs are still in progress. This page refreshes automatically every 5 seconds.
    </div>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950">Source document</h2>
      <p class="mt-1 text-sm font-medium text-slate-600"><%= @experiment.document.title %></p>
      <div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-800"><%= @experiment.document.source_text %></div>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-slate-950">Translation instruction</h2>
      <div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-800"><%= @experiment.instruction_prompt %></div>
    </section>
  </div>

  <section>
    <h2 class="text-xl font-semibold text-slate-950">Model runs</h2>
    <div class="mt-4 space-y-5">
      <% @experiment.translation_runs.sort_by { |run| [run.llm_model.display_name, run.id] }.each do |run| %>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="font-semibold text-slate-950"><%= run.llm_model.display_name %></h3>
              <dl class="mt-2 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2">
                <div>
                  <dt class="text-slate-500">Requested model</dt>
                  <dd class="break-all font-mono text-xs text-slate-800"><%= run.llm_model.model_identifier %></dd>
                </div>
                <% if run.resolved_model_identifier.present? %>
                  <div>
                    <dt class="text-slate-500">Resolved model</dt>
                    <dd class="break-all font-mono text-xs text-slate-800"><%= run.resolved_model_identifier %></dd>
                  </div>
                <% end %>
              </dl>
            </div>
            <span class="inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold <%= status_badge_classes(run.status) %>"><%= run.status.humanize %></span>
          </div>

          <% if run.completed? %>
            <div class="mt-5 whitespace-pre-wrap break-words rounded-lg border border-emerald-100 bg-emerald-50/50 p-4 text-sm leading-6 text-slate-900"><%= run.translated_text %></div>
          <% elsif run.failed? %>
            <div class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
              <p class="font-semibold">Translation failed</p>
              <% if run.error_code.present? %>
                <p class="mt-1">Error code: <span class="font-mono"><%= run.error_code %></span></p>
              <% end %>
              <% if run.error_message.present? %>
                <p class="mt-1 break-words"><%= safe_provider_error(run.error_message) %></p>
              <% end %>
            </div>
          <% else %>
            <p class="mt-5 rounded-lg bg-slate-50 p-4 text-sm text-slate-600">
              <%= run.running? ? "The model is translating this document now." : "This run is queued and waiting to start." %>
            </p>
          <% end %>

          <% telemetry = {
               "Prompt tokens" => run.prompt_tokens,
               "Completion tokens" => run.completion_tokens,
               "Total tokens" => run.total_tokens,
               "Cost" => (number_to_currency(run.cost, unit: "$", precision: 10, strip_insignificant_zeros: true) unless run.cost.nil?)
             }.compact %>
          <% if telemetry.any? %>
            <dl class="mt-5 grid gap-3 border-t border-slate-100 pt-4 text-sm sm:grid-cols-4">
              <% telemetry.each do |label, value| %>
                <div>
                  <dt class="text-slate-500"><%= label %></dt>
                  <dd class="font-medium text-slate-900"><%= value %></dd>
                </div>
              <% end %>
            </dl>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>

  <% completed_candidates = @experiment.translation_runs.select { |run| run.completed? && run.translated_text.present? } %>
  <% if @experiment.review_round %>
    <section class="rounded-xl border border-blue-200 bg-blue-50 p-6 shadow-sm">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-xl font-semibold text-slate-950">Blind cross-review</h2>
          <p class="mt-2 text-sm text-slate-700">A blind review round already exists for this experiment.</p>
        </div>
        <%= link_to "View blind review", @experiment.review_round, class: "inline-flex w-fit rounded-lg bg-blue-700 px-4 py-2 font-semibold text-white hover:bg-blue-800" %>
      </div>
    </section>
  <% elsif @experiment.completed? && completed_candidates.size >= 2 %>
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-slate-950">Start blind cross-review</h2>
      <p class="mt-2 max-w-3xl text-sm text-slate-600">
        Select one or more reviewer models. Each reviewer receives the source, instruction, rubric, and anonymously labeled translations. Candidate model identities remain private from the reviewer.
      </p>

      <%= form_with url: experiment_review_rounds_path(@experiment), scope: :review_round, class: "mt-5 space-y-5" do |form| %>
        <% if @reviewer_models.any? %>
          <fieldset>
            <legend class="text-sm font-semibold text-slate-800">Active OpenRouter reviewers</legend>
            <div class="mt-3 grid gap-3 md:grid-cols-2">
              <% @reviewer_models.each do |reviewer| %>
                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-4 hover:border-blue-300 hover:bg-blue-50/40">
                  <%= check_box_tag "review_round[reviewer_ids][]", reviewer.id, false, id: "review_round_reviewer_ids_#{reviewer.id}", class: "mt-1 size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
                  <span>
                    <span class="block font-medium text-slate-900"><%= reviewer.display_name %></span>
                    <span class="mt-1 block text-xs text-slate-500"><%= reviewer.provider %> · <%= reviewer.model_identifier %></span>
                  </span>
                </label>
              <% end %>
            </div>
          </fieldset>
        <% else %>
          <p class="rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800">No active OpenRouter reviewer models are available.</p>
        <% end %>

        <%= form.submit "Start blind review", disabled: @reviewer_models.empty?, class: "rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white shadow-sm hover:bg-blue-800 disabled:cursor-not-allowed disabled:bg-slate-400" %>
      <% end %>
    </section>
  <% end %>
</div>
