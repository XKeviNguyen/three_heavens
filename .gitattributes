# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Mark the database schema as having been generated. Rails ends the generated
# structure.sql with a blank line, so whitespace checks do not apply to it.
db/schema.rb linguist-generated
db/structure.sql linguist-generated -whitespace

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
config/credentials/*.yml.enc diff=rails_credentials
config/credentials.yml.enc diff=rails_credentials

# PDF test fixtures contain binary cross-reference records.
test/fixtures/files/*.pdf binary
